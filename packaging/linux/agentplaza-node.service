[Unit]
Description=AgentPlaza node
After=network-online.target

[Service]
EnvironmentFile=-/etc/default/agentplaza-node
EnvironmentFile=-%h/.config/agentplaza/node.env
# The node's API takes the internal token the hub on this machine writes (apid's default state directory).
ExecStart=/usr/bin/noded --internal-token-file %S/agentplaza/internal.token $APZ_NODE_ARGS
Restart=on-failure
NoNewPrivileges=yes
LockPersonality=yes

[Install]
WantedBy=default.target
