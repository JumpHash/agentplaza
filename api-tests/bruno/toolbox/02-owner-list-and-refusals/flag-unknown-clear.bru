meta {
  name: Answer 404 when clearing the flag of an unknown discovery
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/toolbox/d999999/flag
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": null
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
