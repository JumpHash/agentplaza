meta {
  name: Refuse a flag whose body is not JSON, even for an unknown discovery
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/toolbox/d999999/flag
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  not json
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
