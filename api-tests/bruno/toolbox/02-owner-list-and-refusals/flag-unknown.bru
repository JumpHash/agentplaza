meta {
  name: Answer 404 when flagging a discovery that does not exist
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/toolbox/d999999/flag
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": "Do not use."
  }
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt 1000
}
