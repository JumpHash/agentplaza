meta {
  name: Record that the test agent's session ended
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/internal/v1/agents/9001/gone
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "reason": "Bruno cleanup"
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}
