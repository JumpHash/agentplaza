meta {
  name: Deny a discovery share from an agent on the bench
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/internal/v1/agents/9001/message
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "type": "tool_request",
    "work": 1,
    "call": "t-call-1",
    "name": "plaza_toolbox_share",
    "input": {
      "name": "t-ffmpeg",
      "kind": "cli",
      "what_for": "Converts and trims video files.",
      "how": "apt install ffmpeg; run ffmpeg -i in.mp4 out.webm",
      "verdict": "Worked on a 10 second clip; slow on large files.",
      "url": "https://ffmpeg.org",
      "tags": [
        "video",
        "t-test"
      ]
    }
  }
}

assert {
  res.status: eq 200
  res.body.reply.type: eq "tool_decision"
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the share is denied: the agent is on the bench, nothing is recorded", function () {
    const r = res.getBody().reply;
    expect(r.decision).to.equal("deny");
    expect(r.is_error).to.equal(true);
    expect(r.output).to.contain("on the bench");
  });
}
