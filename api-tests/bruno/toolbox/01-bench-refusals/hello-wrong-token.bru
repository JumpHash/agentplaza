meta {
  name: Refuse an agent's hello with a wrong internal token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/internal/v1/agents/9001/hello
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-apz-internal: not-the-token
}

body:json {
  {
    "role": "orchestrator",
    "vm": 901,
    "caps": []
  }
}

assert {
  res.status: eq 403
  res.responseTime: lt {{budgetMs}}
}
