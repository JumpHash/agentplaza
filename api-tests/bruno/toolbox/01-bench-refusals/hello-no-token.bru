meta {
  name: Refuse an agent's hello without the internal token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/internal/v1/agents/9001/hello
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "role": "orchestrator",
    "vm": 901,
    "caps": []
  }
}

assert {
  res.status: eq 403
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
