meta {
  name: Register a session for an agent the owner never spawned
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/internal/v1/agents/9001/hello
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "role": "orchestrator",
    "vm": 901,
    "caps": []
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}
