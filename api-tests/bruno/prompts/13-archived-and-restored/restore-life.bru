meta {
  name: Restore the first prompt once the role is free
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/prompts/{{lifePromptId}}/restore
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("archived_ms is cleared", function () {
    expect(res.getBody().prompt.archived_ms).to.equal(null);
  });
}
