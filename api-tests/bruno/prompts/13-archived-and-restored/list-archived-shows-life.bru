meta {
  name: The archived list shows the archived prompt
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/prompts?archived=true
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("it is listed as archived", function () {
    const p = res.getBody().prompts.find((x) => x.id === "t-prompt-life");
    expect(p).to.be.an("object");
    expect(p.archived_ms).to.be.a("number");
  });
}
