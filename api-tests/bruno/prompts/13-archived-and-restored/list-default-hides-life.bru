meta {
  name: The default list leaves an archived prompt out
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/prompts
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the archived prompt is not listed", function () {
    expect(res.getBody().prompts.map((p) => p.id)).to.not.include("t-prompt-life");
  });
}
