meta {
  name: The history records the archive and the restore
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v1/prompts/{{lifePromptId}}/history
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("archive and restore events are recorded", function () {
    const actions = res.getBody().events.map((e) => e.action);
    expect(actions).to.include("archive");
    expect(actions).to.include("restore");
  });
}
