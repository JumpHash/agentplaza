meta {
  name: Reject a create body without a title
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/prompts
  body: json
  auth: none
}

body:json {
  {
    "kind": "system",
    "body": "# Planner\n"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}
