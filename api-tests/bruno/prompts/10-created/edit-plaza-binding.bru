meta {
  name: Refuse a system prompt rebound to plaza
  type: http
  seq: 19
}

put {
  url: {{baseUrl}}/v1/prompts/{{lifePromptId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Tester",
    "binding": "plaza"
  }
}

assert {
  res.status: eq 422
  res.responseTime: lt {{budgetMs}}
}
