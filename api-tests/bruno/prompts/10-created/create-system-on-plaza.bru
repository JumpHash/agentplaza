meta {
  name: Refuse a system prompt bound to plaza (plaza is for AGENTS.md)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/prompts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "t-prompt-plaza",
    "kind": "system",
    "title": "Tester ✓ (Prüfer)",
    "description": "A test role prompt for the Bruno run.",
    "tags": [
      "t-test"
    ],
    "binding": "plaza",
    "body": "# Tester\n\nYou are the test role. Check each request against the plan.\n",
    "note": "first draft"
  }
}

assert {
  res.status: eq 422
  res.responseTime: lt 1000
}
