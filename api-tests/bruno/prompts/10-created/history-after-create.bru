meta {
  name: The history starts with the create
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/v1/prompts/{{lifePromptId}}/history
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.events: isArray
  res.responseTime: lt 1000
}

tests {
  test("create and version events are recorded", function () {
    const actions = res.getBody().events.map((e) => e.action);
    expect(actions).to.include("create");
    expect(actions).to.include("version");
  });
}
