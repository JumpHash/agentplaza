meta {
  name: Read version 1 with its findings and stats
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v1/prompts/{{lifePromptId}}/versions/1
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.version: eq 1
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the body is kept and the version is current", function () {
    const v = res.getBody();
    expect(v.body).to.contain("Tester");
    expect(v.stats.words).to.be.a("number");
    expect(v.stale).to.equal(false);
    expect(v.recheck).to.equal(null);
  });
}
