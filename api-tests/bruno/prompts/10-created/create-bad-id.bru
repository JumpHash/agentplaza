meta {
  name: Refuse a prompt id with a space
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/prompts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "Bad Id",
    "kind": "system",
    "title": "Tester ✓ (Prüfer)",
    "description": "A test role prompt for the Bruno run.",
    "tags": [
      "t-test"
    ],
    "binding": "role:t-tester",
    "body": "# Tester\n\nYou are the test role. Check each request against the plan.\n",
    "note": "first draft"
  }
}

assert {
  res.status: eq 422
  res.responseTime: lt {{budgetMs}}
}
