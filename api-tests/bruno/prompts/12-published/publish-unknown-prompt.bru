meta {
  name: Answer 404 when publishing an unknown prompt
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/prompts/no-such-prompt/publish
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "version": 1
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
