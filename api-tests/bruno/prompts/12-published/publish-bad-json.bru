meta {
  name: Refuse a publish whose body is not JSON
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/prompts/{{lifePromptId}}/publish
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  not json
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
