meta {
  name: Publish the older version 1 again (a rollback)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/prompts/{{lifePromptId}}/publish
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "version": 1
  }
}

assert {
  res.status: eq 200
  res.body.prompt.active_version: eq 1
  res.responseTime: lt 1000
}
