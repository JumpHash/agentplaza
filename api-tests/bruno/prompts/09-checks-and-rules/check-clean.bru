meta {
  name: Check a clean system draft: no error
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/prompts/check
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "kind": "system",
    "body": "# Planner check\n\nYou are a planner.\n"
  }
}

assert {
  res.status: eq 200
  res.body.errors: eq 0
  res.responseTime: lt 1000
}

tests {
  test("the report has a score and stats", function () {
    expect(res.getBody().score).to.be.a("number");
    expect(res.getBody().stats.words).to.be.a("number");
  });
}
