meta {
  name: Start the sign-in on the app whose exchange will fail
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/platforms/authorize
  body: json
  auth: none
}

body:json {
  {"registration": "{{exchange_app}}"}
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("exchange_state", res.getBody().state);
}
