meta {
  name: Refuse an OAuth app with no client secret
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/platforms/registrations
  body: json
  auth: none
}

body:json {
  {"kind": "gitlab", "host": "http://127.0.0.1:1", "client_id": "t-platforms-client"}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: eq "client_secret is required"
}
