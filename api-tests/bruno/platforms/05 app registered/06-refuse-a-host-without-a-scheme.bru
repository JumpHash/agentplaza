meta {
  name: Refuse a platform host that is not an http(s) URL
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/platforms/registrations
  body: json
  auth: none
}

body:json {
  {"kind": "gitlab", "host": "gitlab.example.test", "client_id": "t-platforms-client", "client_secret": "x"}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the host must be an http(s) URL", function () {
    expect(res.getBody().error).to.include("http(s) URL");
  });
}
