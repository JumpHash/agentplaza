meta {
  name: Refuse a token with a level the plaza does not know
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/platforms/tokens
  body: json
  auth: none
}

body:json {
  {"kind": "github", "token": "t-platforms-token-0456", "level": "enterprise"}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: eq "level enterprise is user, org or repo"
}
