meta {
  name: Answer 404 when editing a removed engine instance
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/engines/t-eng-local
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "label": "gone"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
}
