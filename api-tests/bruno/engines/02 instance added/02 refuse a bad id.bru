meta {
  name: Refuse an engine id with capitals and a space
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/engines
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "Bad ID",
    "engine": "acp-local",
    "command": "scratch-agent"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
