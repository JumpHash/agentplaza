meta {
  name: Refuse an instance whose id exists (409)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/engines
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "t-eng-local",
    "engine": "acp-local",
    "command": "scratch-agent"
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
}
