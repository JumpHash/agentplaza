meta {
  name: Refuse an engine without its engine kind
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/engines
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "t-eng-bad"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: eq "engine is required"
}
