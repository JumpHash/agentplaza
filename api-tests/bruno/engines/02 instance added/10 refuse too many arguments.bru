meta {
  name: Refuse more arguments than an engine may take
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/engines
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "t-eng-bad",
    "engine": "acp-local",
    "command": "scratch-agent"
  }
}

script:pre-request {
  req.setBody({"id": "t-eng-bad", "engine": "acp-local", "command": "scratch-agent", "args": ["a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7", "a8", "a9", "a10", "a11", "a12", "a13", "a14", "a15", "a16", "a17", "a18", "a19", "a20", "a21", "a22", "a23", "a24", "a25", "a26", "a27", "a28", "a29", "a30", "a31", "a32"]});
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
