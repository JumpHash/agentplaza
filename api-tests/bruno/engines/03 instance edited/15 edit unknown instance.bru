meta {
  name: Answer 404 when editing an unknown instance
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/v1/engines/no-such-engine
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "enabled": false
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
