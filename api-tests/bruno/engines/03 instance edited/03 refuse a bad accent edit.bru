meta {
  name: Refuse a bad accent edit (400, nothing changes)
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/v1/engines/t-eng-local
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "accent": "#GG0000"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
