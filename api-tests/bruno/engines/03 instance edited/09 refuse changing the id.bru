meta {
  name: Refuse changing the id (400, nothing changes)
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/v1/engines/t-eng-local
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "t-eng-other"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
