meta {
  name: Turn a local engine back on
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/v1/engines/t-eng-local
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "enabled": true
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.enabled: eq true
}
