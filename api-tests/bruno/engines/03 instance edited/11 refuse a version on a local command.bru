meta {
  name: Refuse a version on a local command (400, nothing changes)
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/v1/engines/t-eng-local
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "version": "1.0.0"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
