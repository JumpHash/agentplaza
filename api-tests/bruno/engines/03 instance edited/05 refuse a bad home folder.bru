meta {
  name: Refuse a bad home folder (400, nothing changes)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/v1/engines/t-eng-local
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "home": "Bad Home"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
