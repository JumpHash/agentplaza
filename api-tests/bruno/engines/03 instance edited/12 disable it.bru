meta {
  name: Turn a local engine off: it shows off
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/v1/engines/t-eng-local
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "enabled": false
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.enabled: eq false
  res.body.health.status: eq "off"
}
