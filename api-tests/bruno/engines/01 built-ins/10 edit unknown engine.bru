meta {
  name: Answer 404 when editing an unknown engine
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/v1/engines/no-such-engine
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "label": "Nothing"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
