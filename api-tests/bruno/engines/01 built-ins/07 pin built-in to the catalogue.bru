meta {
  name: Pin a built-in engine back to the catalogue's version (no network)
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/v1/engines/claude
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "version": "pinned"
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.version: eq "0.84.0"
  res.body.source: eq "npm"
}
