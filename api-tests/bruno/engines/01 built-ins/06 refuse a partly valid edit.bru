meta {
  name: A refused edit that also turns the engine off changes nothing
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/v1/engines/claude
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "enabled": false,
    "accent": "blue"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
