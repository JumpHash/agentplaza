meta {
  name: Refuse a version with characters an npm version never has
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/v1/engines/claude
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "version": "1.0 bad"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
