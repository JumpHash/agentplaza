meta {
  name: Refuse an engine variable the plaza sets for its gateway
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/v1/engines/claude
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "env": {
      "HOME": "/tmp/scratch"
    }
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
