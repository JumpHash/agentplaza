meta {
  name: Refuse to publish a version with an error finding
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/skills/{{lifeSkillId}}/publish
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "version": 3
  }
}

assert {
  res.status: eq 422
  res.body.error: isString
  res.responseTime: lt 1000
}
