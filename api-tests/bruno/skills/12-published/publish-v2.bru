meta {
  name: Publish version 2 as the live one
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/skills/{{lifeSkillId}}/publish
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "version": 2
  }
}

assert {
  res.status: eq 200
  res.body.skill.active_version: eq 2
  res.responseTime: lt 1000
}
