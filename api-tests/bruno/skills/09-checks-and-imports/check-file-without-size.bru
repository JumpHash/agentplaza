meta {
  name: Refuse a check whose file has no size
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/skills/check
  body: json
  auth: none
}

body:json {
  {
    "skill_md": "---\nname: t-skill-life\ndescription: Test skill for the Bruno run. Use when a test needs a skill with a reference file.\n---\n# Test skill\n\nRead [the reference](reference.md) first.\n",
    "files": [
      {
        "path": "reference.md",
        "executable": false,
        "text": "x"
      }
    ]
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
