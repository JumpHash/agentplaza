meta {
  name: Refuse an import commit with a body that is not JSON
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/skills/import/commit
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  not json
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
