meta {
  name: Refuse a GitHub preview for a URL that is not GitHub
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/skills/github/preview
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "url": "https://example.com/skills"
  }
}

assert {
  res.status: eq 422
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
