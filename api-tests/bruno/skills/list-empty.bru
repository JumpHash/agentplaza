meta {
  name: List skills on a fresh hub (only the built-in ones)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/skills
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.skills: isArray
}

tests {
  test("only the skills the hub ships with", function () {
    // The hub ships show-your-work (artifacts); the owner has added nothing yet.
    const skills = res.getBody().skills;
    expect(skills.map((s) => s.id)).to.deep.equal(["show-your-work"]);
    expect(skills[0].tags).to.include("builtin");
  });
}
