meta {
  name: Answer 404 when renaming an unknown skill
  type: http
  seq: 25
}

put {
  url: {{baseUrl}}/v1/skills/no-such-skill
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "X",
    "tags": []
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
}
