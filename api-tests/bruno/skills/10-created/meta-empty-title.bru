meta {
  name: Refuse a rename to an empty title
  type: http
  seq: 24
}

put {
  url: {{baseUrl}}/v1/skills/{{lifeSkillId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "",
    "tags": []
  }
}

assert {
  res.status: eq 422
  res.responseTime: lt {{budgetMs}}
}
