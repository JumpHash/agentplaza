meta {
  name: The history starts with the create
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/v1/skills/{{lifeSkillId}}/history
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.events: isArray
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("a create event is recorded", function () {
    const actions = res.getBody().events.map((e) => e.action);
    expect(actions).to.include("create");
  });
}
