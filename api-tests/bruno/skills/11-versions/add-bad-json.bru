meta {
  name: Refuse a version whose body is not JSON
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/skills/{{lifeSkillId}}/versions
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  not json
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
