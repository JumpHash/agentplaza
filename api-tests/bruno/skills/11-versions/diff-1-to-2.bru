meta {
  name: Compare version 1 with version 2
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/v1/skills/{{lifeSkillId}}/diff?from=1&to=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.skill_md: isArray
  res.responseTime: lt 1000
}

tests {
  test("the two versions are named and no file changed", function () {
    const d = res.getBody();
    expect(d.from.version).to.equal(1);
    expect(d.to.version).to.equal(2);
    expect(d.files).to.deep.equal({ added: [], removed: [], changed: [] });
  });
}
