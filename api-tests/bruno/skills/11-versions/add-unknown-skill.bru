meta {
  name: Answer 404 when adding a version to an unknown skill
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/skills/no-such-skill/versions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "skill_md": "---\nname: t-skill-life\ndescription: Test skill for the Bruno run. Use when a test needs a skill with a reference file.\n---\n# Test skill\n\nRead [the reference](reference.md) first.\n\nAlso keep the answer short.\n",
    "files": [],
    "note": "more",
    "base_version": 1
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
