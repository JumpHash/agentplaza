meta {
  name: List the live sessions of the project
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/sessions?project={{we_pid}}&live=true
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("every session listed is the project's", function () {
    const sessions = res.getBody();
    expect(sessions).to.be.an("array");
    sessions.forEach((s) => expect(s.project).to.equal(bru.getVar("we_pid")));
  });
}
