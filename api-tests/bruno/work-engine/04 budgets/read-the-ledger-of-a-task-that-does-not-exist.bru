meta {
  name: Read the ledger of a task that does not exist: none
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/v1/tasks/t999999/budget/ledger
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("no entry is written for it", function () {
    expect(res.getBody()).to.deep.equal([]);
  });
}
