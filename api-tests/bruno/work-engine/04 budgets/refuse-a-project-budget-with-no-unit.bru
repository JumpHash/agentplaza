meta {
  name: Refuse a project budget with no unit
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/v1/projects/{{we_pid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"cap": 5000000}
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
