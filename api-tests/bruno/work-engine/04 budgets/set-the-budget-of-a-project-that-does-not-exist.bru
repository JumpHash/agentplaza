meta {
  name: Answer 404 to a budget set on a project that does not exist
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/v1/projects/pr999999/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"unit": "usd"}
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
