meta {
  name: Answer 404 to a budget set on a task that does not exist
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/v1/tasks/t999999/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"unit": "usd", "cap": 1000000}
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
