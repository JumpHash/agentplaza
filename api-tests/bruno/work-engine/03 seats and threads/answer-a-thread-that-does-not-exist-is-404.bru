meta {
  name: Answer a thread that does not exist: 404
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/threads/th999999/answer
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"text": "Dollars."}
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
