meta {
  name: Answer 404 to a message in a chat that does not exist
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/chats/ch999999/messages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"text": "hello"}
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
