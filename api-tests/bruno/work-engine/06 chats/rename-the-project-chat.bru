meta {
  name: Rename the project chat
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/v1/chats/{{we_chat}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"title": "renamed"}
}

assert {
  res.status: eq 200
  res.body.title: eq "renamed"
  res.responseTime: lt {{budgetMs}}
}
