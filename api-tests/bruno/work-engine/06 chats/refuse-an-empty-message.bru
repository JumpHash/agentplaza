meta {
  name: Refuse a message of spaces only
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/chats/{{we_chat}}/messages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"text": "   "}
}

assert {
  res.status: eq 400
  res.body.error: eq "say something"
  res.responseTime: lt {{budgetMs}}
}
