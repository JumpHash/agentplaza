meta {
  name: Refuse a chat field the hub does not know
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/chats
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"project": "{{we_pid}}", "colour": "red"}
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
