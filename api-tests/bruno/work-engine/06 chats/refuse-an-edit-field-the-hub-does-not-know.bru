meta {
  name: Refuse a chat edit field the hub does not know
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/v1/chats/{{we_chat}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"colour": "red"}
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
