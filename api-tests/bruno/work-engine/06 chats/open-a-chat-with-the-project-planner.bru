meta {
  name: Open a chat with the project's planner
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/chats
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"project": "{{we_pid}}", "title": "work engine talk"}
}

assert {
  res.status: eq 201
  res.body.kind: eq "project"
  res.body.title: eq "work engine talk"
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the chat gets an id of its own, in its project", function () {
    const chat = res.getBody();
    expect(chat.id).to.match(/^ch\d+$/);
    expect(chat.project).to.equal(bru.getVar("we_pid"));
  });
}

script:post-response {
  bru.setVar("we_chat", res.getBody().id);
}
