meta {
  name: Restore the project chat
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/v1/chats/{{we_chat}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"archived": false}
}

assert {
  res.status: eq 200
  res.body.archived: eq false
  res.responseTime: lt {{budgetMs}}
}
