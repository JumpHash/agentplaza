meta {
  name: Answer 404 to a chat for a project that does not exist
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/chats
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"project": "pr999999"}
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
