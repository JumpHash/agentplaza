meta {
  name: Refuse an answer that names no choice
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/cards/c999999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"amount": 5}
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
