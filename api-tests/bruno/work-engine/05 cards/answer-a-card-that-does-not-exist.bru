meta {
  name: Answer 404 to answering a card that does not exist
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/cards/c999999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"choice": "approve"}
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
