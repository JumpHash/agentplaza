meta {
  name: Open a project for the work engine's requests
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"title": "we work engine", "goal": "The work engine's routes, end to end"}
}

assert {
  res.status: eq 201
  res.body.title: eq "we work engine"
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the project gets an id of its own", function () {
    expect(res.getBody().id).to.match(/^pr\d+$/);
  });
}

script:post-response {
  bru.setVar("we_pid", res.getBody().id);
}
