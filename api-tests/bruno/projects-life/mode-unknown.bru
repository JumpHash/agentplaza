meta {
  name: Answer 400 for a mode that does not exist
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/projects/{{projectId}}/mode
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"mode": "weekly"}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}
