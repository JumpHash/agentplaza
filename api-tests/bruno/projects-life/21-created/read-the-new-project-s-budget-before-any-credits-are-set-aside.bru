meta {
  name: Read the new project's budget before any credits are set aside
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.own: eq false
  res.body.balance: eq 0
  res.body.plaza: isNumber
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("life_plaza_start", res.getBody().plaza);
}
