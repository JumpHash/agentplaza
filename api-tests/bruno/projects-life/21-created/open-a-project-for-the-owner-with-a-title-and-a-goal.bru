meta {
  name: Open a project for the owner with a title and a goal
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"title": "t-life walk", "goal": "Walk one project through its whole life"}
}

assert {
  res.status: eq 201
  res.body.stage: eq "implementation"
  res.body.mode: eq "build"
  res.body.paused: eq false
  res.body.archived: eq false
  res.body.approved_by: eq "owner"
  res.responseTime: lt 1000
}

tests {
  test("the project opens with its plan approved and no tasks", function () {
    const b = res.getBody();
    expect(b.id).to.match(/^pr\d+$/);
    expect(b.tasks).to.deep.equal([]);
    expect(b.title).to.equal("t-life walk");
  });
}

script:post-response {
  bru.setVar("life_pid", res.getBody().id);
}
