meta {
  name: Refuse a veto to a stage the project has not reached yet
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/veto
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"stage": "review", "reason": "t-life too early"}
}

assert {
  res.status: eq 409
  res.body.error: contains "earlier stage"
  res.responseTime: lt 1000
}
