meta {
  name: Answer 404 when setting credits aside for a project that does not exist
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/projects/pr999999/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"credits": 1}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
