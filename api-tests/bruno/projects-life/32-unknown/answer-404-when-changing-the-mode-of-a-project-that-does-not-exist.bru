meta {
  name: Answer 404 when changing the mode of a project that does not exist
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/projects/pr999999/mode
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"mode": "build"}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
