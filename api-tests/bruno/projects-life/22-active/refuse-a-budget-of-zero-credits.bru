meta {
  name: Refuse a budget of zero credits
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"credits": 0}
}

assert {
  res.status: eq 400
  res.body.error: contains "not 0"
  res.responseTime: lt {{budgetMs}}
}
