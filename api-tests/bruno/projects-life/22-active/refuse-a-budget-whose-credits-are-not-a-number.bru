meta {
  name: Refuse a budget whose credits are not a number
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"credits": "lots"}
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}
