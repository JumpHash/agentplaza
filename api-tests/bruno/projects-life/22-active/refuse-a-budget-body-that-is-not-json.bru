meta {
  name: Refuse a budget body that is not JSON
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  nope
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
