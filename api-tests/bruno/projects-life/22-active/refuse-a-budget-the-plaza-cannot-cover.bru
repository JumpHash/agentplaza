meta {
  name: Refuse a budget the plaza cannot cover
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"credits": 1000000000000}
}

assert {
  res.status: eq 409
  res.body.error: contains "did not move"
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("nothing moved on the refusal", function () {
    const b = bru.getVar("life_plaza_start");
    expect(b).to.be.a("number");
  });
}
