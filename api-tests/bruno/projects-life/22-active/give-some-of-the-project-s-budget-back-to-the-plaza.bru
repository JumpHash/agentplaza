meta {
  name: Give some of the project's budget back to the plaza
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"credits": -100}
}

assert {
  res.status: eq 200
  res.body.balance: eq 650
  res.responseTime: lt 1000
}

tests {
  test("the plaza gets the credits back", function () {
    expect(res.getBody().plaza).to.equal(Number(bru.getVar("life_plaza_start")) - 650);
  });
}
