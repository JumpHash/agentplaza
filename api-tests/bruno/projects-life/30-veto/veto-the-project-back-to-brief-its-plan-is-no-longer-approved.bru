meta {
  name: Veto the project back to brief: its plan is no longer approved
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/projects/{{life_vpid}}/veto
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"stage": "brief", "reason": "t-life the plan needs work"}
}

assert {
  res.status: eq 200
  res.body.stage: eq "brief"
  res.body.approved_by: isNull
  res.responseTime: lt 1000
}

tests {
  test("the history records the veto and its reason", function () {
    const e = res.getBody().history.filter((h) => h.what === "vetoed");
    expect(e.length).to.be.above(0);
    expect(e[e.length - 1].note).to.contain("the plan needs work");
  });
}
