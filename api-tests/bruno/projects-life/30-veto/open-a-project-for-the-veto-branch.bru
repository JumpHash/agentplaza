meta {
  name: Open a project for the veto branch
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"title": "t-life veto", "goal": "A plan the owner sends back"}
}

assert {
  res.status: eq 201
  res.body.stage: eq "implementation"
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("life_vpid", res.getBody().id);
}
