meta {
  name: Refuse a task while the plan is at brief
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"goal": "t-life task at brief", "budget": 200, "project": "{{life_vpid}}"}
}

assert {
  res.status: eq 409
  res.body.error: contains "once its plan is approved"
  res.responseTime: lt {{budgetMs}}
}
