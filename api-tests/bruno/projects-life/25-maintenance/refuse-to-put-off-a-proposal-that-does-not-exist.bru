meta {
  name: Refuse to put off a proposal that does not exist
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/maintenance/proposals/p999999/later
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.error: contains "no such proposal"
  res.responseTime: lt 1000
}
