meta {
  name: Put a development environment on the project
  type: http
  seq: 19
}

put {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/environments/probe-env
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"kind": "development"}
}

assert {
  res.status: eq 200
  res.body.name: eq "probe-env"
  res.body.protected: eq false
  res.responseTime: lt 1000
}
