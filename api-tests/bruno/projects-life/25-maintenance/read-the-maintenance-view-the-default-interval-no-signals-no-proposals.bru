meta {
  name: Read the maintenance view: the default interval, no signals, no proposals
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/maintenance
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.config.every_hours: eq 24
  res.body.signals: isArray
  res.body.proposals: isArray
  res.responseTime: lt 1000
}
