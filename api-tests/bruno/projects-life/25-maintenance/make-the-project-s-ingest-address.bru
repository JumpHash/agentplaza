meta {
  name: Make the project's ingest address
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/maintenance/ingest
  body: none
  auth: none
}

assert {
  res.status: eq 201
  res.body.token: contains "apzi_"
  res.body.path: contains "/v1/ingest/"
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("life_ingest_token", res.getBody().token);
}
