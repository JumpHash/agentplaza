meta {
  name: Set a secret for the development environment
  type: http
  seq: 23
}

put {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/environments/probe-env/secrets/PROBE_TOKEN
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"value": "bru-test-value-0123456789"}
}

assert {
  res.status: eq 200
  res.body.name: eq "PROBE_TOKEN"
  res.body.binding: isString
  res.responseTime: lt 1000
}

tests {
  test("the secret's value never comes back", function () {
    expect(JSON.stringify(res.getBody())).to.not.include("bru-test-value-0123456789");
  });
}
