meta {
  name: The old ingest address no longer takes signals
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/ingest/{{life_ingest_token}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"text": "t-life old address"}
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
}
