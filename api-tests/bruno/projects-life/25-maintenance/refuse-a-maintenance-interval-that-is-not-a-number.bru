meta {
  name: Refuse a maintenance interval that is not a number
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/maintenance
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"every_hours": "soon"}
}

assert {
  res.status: eq 400
  res.body.error: contains "every_hours must be"
  res.responseTime: lt {{budgetMs}}
}
