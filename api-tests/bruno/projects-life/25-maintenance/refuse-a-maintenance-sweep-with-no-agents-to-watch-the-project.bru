meta {
  name: Refuse a maintenance sweep with no agents to watch the project
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/maintenance/sweep
  body: none
  auth: none
}

assert {
  res.status: eq 409
  res.body.error: contains "no agents to watch"
  res.responseTime: lt {{budgetMs}}
}
