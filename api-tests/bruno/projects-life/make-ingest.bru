meta {
  name: Make the project's ingest address
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/projects/{{projectId}}/maintenance/ingest
  body: json
  auth: none
}

body:json {
  {}
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
  res.body.token: isString
  res.body.path: isString
}

tests {
  test("the token is shown once, and the path carries it", function () {
    const b = res.getBody();
    expect(b.token).to.match(/^apzi_/);
    expect(b.path).to.eql("/v1/ingest/" + b.token);
  });
}

script:post-response {
  bru.setVar("ingestToken", res.getBody().token);
}
