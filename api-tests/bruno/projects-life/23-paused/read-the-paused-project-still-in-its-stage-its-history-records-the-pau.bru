meta {
  name: Read the paused project: still in its stage, its history records the pause
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/projects/{{life_pid}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.paused: eq true
  res.body.stage: eq "implementation"
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the history names the pause", function () {
    expect(res.getBody().history.map((e) => e.what)).to.include("paused");
  });
}
