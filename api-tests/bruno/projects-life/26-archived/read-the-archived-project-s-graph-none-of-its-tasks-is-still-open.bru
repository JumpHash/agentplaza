meta {
  name: Read the archived project's graph: none of its tasks is still open
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/graph
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("no task is open or claimed", function () {
    const states = res.getBody().tasks.map((t) => t.state);
    expect(states.length).to.be.above(0);
    states.forEach((s) => expect(["withdrawn", "done", "failed"]).to.include(s));
  });
}
