meta {
  name: Refuse to set credits aside for an archived project
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"credits": 100}
}

assert {
  res.status: eq 409
  res.body.error: contains "over"
  res.responseTime: lt {{budgetMs}}
}
