meta {
  name: Money adds up: the project's budget is empty and the plaza has what it started with
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.balance: eq 0
  res.responseTime: lt 1000
}

tests {
  test("the plaza's balance is back where it was before the project's budget", function () {
    expect(res.getBody().plaza).to.equal(Number(bru.getVar("life_plaza_start")));
  });
}
