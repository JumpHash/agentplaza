meta {
  name: Deploy a named version to staging
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/v1/projects/{{projectId}}/environments/staging/deploy
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"version": "0.9.0"}
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.version: eq "0.9.0"
  res.body.status: eq "recorded"
  res.body.by: eq "owner"
}
