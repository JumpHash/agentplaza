meta {
  name: List the project modes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/project-modes
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the two modes, build and maintenance", function () {
    const b = res.getBody();
    expect(b.map((m) => m.id)).to.eql(["build", "maintenance"]);
    expect(b.map((m) => m.label)).to.eql(["Build", "Maintenance"]);
  });
}
