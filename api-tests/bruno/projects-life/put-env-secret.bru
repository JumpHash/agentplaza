meta {
  name: Put a secret for the staging environment
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/v1/projects/{{projectId}}/environments/staging/secrets/STAGING_DEPLOY_TOKEN
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"value": "bru-test-value-0123456789"}
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.name: eq "STAGING_DEPLOY_TOKEN"
  res.body.binding: isString
}

tests {
  test("the secret's answer carries its name and binding, never its value", function () {
    const b = res.getBody();
    expect(b.binding).to.match(/^project:pr\d+\.staging$/);
    expect(JSON.stringify(b)).to.not.include("bru-test-value-0123456789");
    expect(b).to.not.have.property("value");
  });
}
