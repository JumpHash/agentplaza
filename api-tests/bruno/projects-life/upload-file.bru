meta {
  name: Upload a file's bytes into the project
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/v1/projects/{{projectId}}/uploads
  body: text
  auth: none
}

headers {
  Content-Type: application/octet-stream
}

body:text {
  Hello from the Bruno test.
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
  res.body.hash: isString
  res.body.size: isNumber
}

script:post-response {
  bru.setVar("fileHash", res.getBody().hash);
}
