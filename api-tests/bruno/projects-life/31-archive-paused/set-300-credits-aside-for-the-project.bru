meta {
  name: Set 300 credits aside for the project
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/projects/{{life_xpid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"credits": 300}
}

assert {
  res.status: eq 200
  res.body.balance: eq 300
  res.responseTime: lt {{budgetMs}}
}
