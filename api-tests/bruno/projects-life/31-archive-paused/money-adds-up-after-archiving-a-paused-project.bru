meta {
  name: Money adds up after archiving a paused project
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/projects/{{life_xpid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.balance: eq 0
  res.responseTime: lt 1000
}

tests {
  test("the plaza is back where it started", function () {
    expect(res.getBody().plaza).to.equal(Number(bru.getVar("life_xplaza_start")));
  });
}
