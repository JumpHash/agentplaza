meta {
  name: Create a task with a budget of 200
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"goal": "t-life paused archive task", "project": "{{life_xpid}}"}
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("life_xtask", res.getBody().id);
}
