meta {
  name: A topology import from a source it does not read
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/v1/projects/{{projectId}}/topologies/import
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"source": "helm", "path": "chart.yaml", "dry_run": true}
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
