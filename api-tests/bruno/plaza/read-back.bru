meta {
  name: Read the task back
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/tasks/{{taskId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.goal: eq "Write the release notes"
  res.body.state: eq "open"
}

tests {
  test("returns the task that was created", function () {
    expect(res.getBody().id).to.equal(bru.getVar("taskId"));
  });
}
