meta {
  name: Create a task others will run after
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

body:json {
  {
    "goal": "Draft the plan",
    "project": "{{projectId}}"
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
  res.body.after: isArray
  res.body.ready: eq true
}

script:post-response {
  bru.setVar("firstTaskId", res.getBody().id);
}
