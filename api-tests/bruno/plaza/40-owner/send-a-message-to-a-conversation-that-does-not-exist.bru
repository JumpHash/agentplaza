meta {
  name: Send a message to a conversation that does not exist
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/owner/conversations/c999999/messages
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"text": "t-owner hello"}
}

assert {
  res.status: eq 404
  res.body.error: contains "no conversation"
  res.responseTime: lt 1000
}
