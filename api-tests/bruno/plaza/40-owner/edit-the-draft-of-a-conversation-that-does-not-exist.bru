meta {
  name: Edit the draft of a conversation that does not exist
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/v1/owner/conversations/c999999/draft
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"title": "t-owner draft"}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
