meta {
  name: Refuse a conversation while no orchestrator is connected
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/owner/conversations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"text": "t-owner: plan the scheduler work"}
}

assert {
  res.status: eq 409
  res.body.error: contains "orchestrator"
  res.responseTime: lt {{budgetMs}}
}
