meta {
  name: Refuse links that would close a cycle
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/v1/tasks/{{firstTaskId}}
  body: json
  auth: none
}

body:json {
  {
    "after": ["{{secondTaskId}}"]
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the cycle", function () {
    expect(res.getBody().error).to.contain("cycle");
    expect(res.getBody().error).to.contain(bru.getVar("secondTaskId"));
  });
}
