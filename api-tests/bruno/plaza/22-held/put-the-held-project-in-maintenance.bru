meta {
  name: Put the held project in maintenance
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/projects/{{plz_held_pid}}/mode
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"mode": "maintenance"}
}

assert {
  res.status: eq 200
  res.body.mode: eq "maintenance"
  res.responseTime: lt 1000
}
