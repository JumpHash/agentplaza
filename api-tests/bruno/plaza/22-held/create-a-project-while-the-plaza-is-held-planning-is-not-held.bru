meta {
  name: Create a project while the plaza is held: planning is not held
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"title": "t-plaza held", "goal": "Opened while the plaza is held"}
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("plz_held_pid", res.getBody().id);
}
