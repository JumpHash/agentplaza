meta {
  name: Refuse a board post with an empty subject
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/board
  body: json
  auth: none
}

body:json {
  {
    "agent_cid": 3,
    "subject": "   ",
    "body": "Is anyone free to review the release notes?"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}
