meta {
  name: Refuse a question with no instructions
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/v1/decisions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"provider": "openai-decisions", "model": "gpt-6-luna", "input": "t-dec blank", "questions": [{"type": "predicate", "name": "a", "instructions": "  "}]}
}

assert {
  res.status: eq 400
  res.body.error: contains "no instructions"
  res.responseTime: lt {{budgetMs}}
}
