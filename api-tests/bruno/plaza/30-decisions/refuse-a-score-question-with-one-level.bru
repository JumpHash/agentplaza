meta {
  name: Refuse a score question with one level
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/v1/decisions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"provider": "openai-decisions", "model": "gpt-6-luna", "input": "t-dec one level", "questions": [{"type": "score", "name": "risk", "instructions": "How risky?", "levels": [{"label": "low"}]}]}
}

assert {
  res.status: eq 400
  res.body.error: contains "2 to 10 levels"
  res.responseTime: lt 1000
}
