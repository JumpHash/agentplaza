meta {
  name: Refuse a decision call with no questions
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/decisions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"provider": "openai-decisions", "model": "gpt-6-luna", "input": "t-dec none", "questions": []}
}

assert {
  res.status: eq 400
  res.body.error: contains "needs 1 to 128 questions"
  res.responseTime: lt {{budgetMs}}
}
