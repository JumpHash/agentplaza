meta {
  name: Refuse a body with no input
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/v1/decisions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"provider": "openai-decisions", "model": "gpt-6-luna",  "questions": [{"type": "predicate", "name": "flaky", "instructions": "Is the test flaky?"}]}
}

assert {
  res.status: eq 400
  res.body.error: contains "input"
  res.responseTime: lt 1000
}
