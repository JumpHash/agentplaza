meta {
  name: Refuse a task for an unknown project
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

body:json {
  {
    "goal": "A task for nothing",
    "budget": 200,
    "project": "no-such-project"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}
