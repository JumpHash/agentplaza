meta {
  name: Resolving an incident the project does not have
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/projects/{{projectId}}/incidents/no-such-incident/resolve
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
