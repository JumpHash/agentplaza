meta {
  name: Saving an import of an unknown project is not found
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/projects/no-such-project/workflows/import
  body: json
  auth: none
}

body:json {
  {
    "file": ".github/workflows/ci.yml",
    "save": true
  }
}

assert {
  res.status: eq 404
}
