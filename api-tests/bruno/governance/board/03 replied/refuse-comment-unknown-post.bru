meta {
  name: Answer 404 for a comment on an unknown post
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/board/p-none/comments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "text": "Hello?"
  }
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt 1000
}
