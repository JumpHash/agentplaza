meta {
  name: Refuse an empty comment
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/board/{{boardAgentPost}}/comments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "text": ""
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}
