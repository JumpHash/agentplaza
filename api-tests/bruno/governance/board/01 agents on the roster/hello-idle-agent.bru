meta {
  name: Register a second test agent, which stays off any project
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/internal/v1/agents/8602/hello
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
  Content-Type: application/json
}

body:json {
  {
    "role": "",
    "vm": 87,
    "caps": []
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}
