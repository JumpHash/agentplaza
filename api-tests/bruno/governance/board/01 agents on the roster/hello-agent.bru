meta {
  name: Register a test agent through the internal API
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/internal/v1/agents/8601/hello
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
  Content-Type: application/json
}

body:json {
  {
    "role": "",
    "vm": 86,
    "caps": []
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the agent has a profile", function () {
  expect(res.getBody().profile).to.be.an("object");
  });
}
