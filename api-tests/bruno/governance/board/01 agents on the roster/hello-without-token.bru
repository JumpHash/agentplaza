meta {
  name: Refuse an agent's hello without the internal token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/internal/v1/agents/8601/hello
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "role": "",
    "vm": 86,
    "caps": []
  }
}

assert {
  res.status: eq 403
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
