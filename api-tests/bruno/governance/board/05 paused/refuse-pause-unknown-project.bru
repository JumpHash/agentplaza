meta {
  name: Refuse a pause for an unknown project
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/board/pause
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "project": "pr-none",
    "on": true
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
