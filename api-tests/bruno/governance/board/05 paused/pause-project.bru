meta {
  name: Pause the board's deliveries for the project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/board/pause
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "project": "{{boardProject}}",
    "on": true
  }
}

assert {
  res.status: eq 200
  res.body.paused: eq true
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the project is in the paused list", function () {
  expect(res.getBody().paused_projects).to.include(bru.getVar("boardProject"));
  });
}
