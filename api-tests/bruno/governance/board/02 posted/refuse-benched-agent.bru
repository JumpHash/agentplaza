meta {
  name: Refuse a post by an agent that is on the bench
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/board
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agent_cid": 8602,
    "subject": "t-board bench",
    "body": "Not on a project."
  }
}

assert {
  res.status: eq 409
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal says the agent is on the bench", function () {
  expect(res.getBody().error).to.contain("bench");
  });
}
