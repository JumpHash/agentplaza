meta {
  name: Refuse an owner post with an empty body
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/board/posts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "subject": "t-board empty",
    "body": ""
  }
}

assert {
  res.status: eq 400
  res.body.error: eq "body must not be empty"
  res.responseTime: lt 1000
}
