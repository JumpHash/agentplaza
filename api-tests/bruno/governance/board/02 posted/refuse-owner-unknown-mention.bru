meta {
  name: Refuse an owner post that mentions no agent
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/board/posts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "body": "Hello?",
    "mentions": [
      "t-board-nobody"
    ]
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
