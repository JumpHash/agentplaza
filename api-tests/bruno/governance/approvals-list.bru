meta {
  name: List the approvals on an empty hub
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/approvals
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body: isArray
}

tests {
  test("no approvals before any agent asks", function () {
    expect(res.getBody()).to.have.lengthOf(0);
  });
}
