meta {
  name: Answer 404 when deciding an unknown motion
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/v1/motions/m-none/decide
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "approve": true
  }
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
