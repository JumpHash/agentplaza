meta {
  name: Refuse a vote that is not yes, no or abstain
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/v1/motions/m-none/vote
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agent_cid": 8603,
    "vote": "maybe",
    "reason": "t-motion"
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
