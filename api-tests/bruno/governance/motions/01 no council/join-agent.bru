meta {
  name: Put the test agent on the motion project
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/projects/{{motionProject}}/members
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cid": 8603
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}
