meta {
  name: Answer 404 for a vote by an unknown agent
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/motions/m-none/vote
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agent_cid": 8699,
    "vote": "yes",
    "reason": "t-motion"
  }
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
