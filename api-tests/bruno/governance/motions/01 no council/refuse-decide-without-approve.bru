meta {
  name: Refuse a decision that does not say approve or not
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/v1/motions/m-none/decide
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "note": "t-motion"
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}
