meta {
  name: Owner declines the share request
  type: http
  seq: 55
}

post {
  url: {{baseUrl}}/v1/approvals/{{int_share}}
  body: json
  auth: none
}

body:json {
  {
    "approve": false,
    "reason": "t-internal declined"
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 200
  res.body.state: eq "denied"
}
