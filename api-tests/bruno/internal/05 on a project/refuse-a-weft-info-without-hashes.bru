meta {
  name: Refuse a Weft info without hashes
  type: http
  seq: 58
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/weft/wire/info
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {}
}

assert {
  res.responseTime: lt 1000
  res.status: eq 400
  res.body.error: eq "info needs hashes"
}
