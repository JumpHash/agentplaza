meta {
  name: Answer 404 for a version the artifact does not have
  type: http
  seq: 51
}

get {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/artifacts/{{int_art}}?v=9
  body: none
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 404
  res.body.error: eq "no such artifact"
}
