meta {
  name: Record a compaction of the agent's conversation
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/message
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "type": "compressed",
    "work": 1,
    "before": 4000,
    "after": 800,
    "folded": 6,
    "reason": "auto"
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 200
}

tests {
  test("the guest gets no reply", function () {
    expect(res.getBody().reply).to.be.null;
  });
}
