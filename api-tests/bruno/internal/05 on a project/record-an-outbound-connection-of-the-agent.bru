meta {
  name: Record an outbound connection of the agent
  type: http
  seq: 65
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/egress
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "host": "example.com",
    "port": 443,
    "allowed": true,
    "bytes_up": 10,
    "bytes_down": 20,
    "ms": 5
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
}

tests {
  test("the reply is empty", function () {
    expect(res.getBody()).to.deep.equal({});
  });
}
