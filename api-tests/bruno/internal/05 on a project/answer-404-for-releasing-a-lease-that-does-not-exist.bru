meta {
  name: Answer 404 for releasing a lease that does not exist
  type: http
  seq: 79
}

delete {
  url: {{baseUrl}}/internal/v1/agents/61003/stations/s-t-internal-none/leases/l-t-internal-none
  body: none
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

assert {
  res.responseTime: lt 1000
  res.status: eq 404
  res.body.error: eq "no such lease"
}
