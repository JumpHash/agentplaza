meta {
  name: Refuse a Weft statement the agent does not say
  type: http
  seq: 60
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/weft/records/unsigned
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "kind": "revision.bogus",
    "body": {}
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 403
  res.body.error: eq "an agent does not say revision.bogus"
}
