meta {
  name: Refuse an artifact without a spec
  type: http
  seq: 46
}

put {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/artifacts
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {}
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 400
}

tests {
  test("the error names the missing spec", function () {
    expect(res.getBody().error).to.include("spec");
  });
}
