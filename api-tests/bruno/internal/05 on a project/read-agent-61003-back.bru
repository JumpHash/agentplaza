meta {
  name: Read agent 61003 back
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/agents/61003
  body: none
  auth: none
}

assert {
  res.responseTime: lt 1000
  res.status: eq 200
}

tests {
  test("the agent reads back as idle", function () {
    expect(res.getBody().status).to.equal("idle");
  });
  test("the agent is on its project", function () {
    expect(res.getBody().project).to.equal(bru.getVar("int_proj_main"));
  });
}
