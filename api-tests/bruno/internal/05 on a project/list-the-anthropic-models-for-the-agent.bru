meta {
  name: List the Anthropic models for the agent
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/anthropic/v1/models
  body: none
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

assert {
  res.responseTime: lt 1000
  res.status: eq 200
}

tests {
  test("the list is an array of models", function () {
    expect(res.getBody().data).to.be.an("array");
  });
}
