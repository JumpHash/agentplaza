meta {
  name: Refuse a Weft want for a revision that does not exist
  type: http
  seq: 59
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/weft/wire/want
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "revision": "t-internal-none"
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 404
  res.body.error: eq "no revision t-internal-none"
}
