meta {
  name: Refuse an egress check whose CID is text
  type: http
  seq: 69
}

post {
  url: {{baseUrl}}/internal/egress/check
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "cid": "x",
    "host": "example.com"
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 400
}

tests {
  test("the error names the type", function () {
    expect(res.getBody().error).to.include("expected u64");
  });
}
