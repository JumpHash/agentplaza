meta {
  name: Refuse a Responses call to OpenAI while the wallet is empty
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/openai/v1/responses
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "model": "gpt-6-luna",
    "input": "hi"
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: gte 400
  res.status: lt 600
  res.body.error: isString
}

tests {
  test("the refusal is a wallet, key or provider refusal", function () {
    expect([402, 502, 503]).to.include(res.status);
  });
}
