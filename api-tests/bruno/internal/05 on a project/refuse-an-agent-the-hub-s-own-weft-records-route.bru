meta {
  name: Refuse an agent the hub's own Weft records route
  type: http
  seq: 62
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/weft/records
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {}
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 403
  res.body.error: eq "that is the hub's to do"
}
