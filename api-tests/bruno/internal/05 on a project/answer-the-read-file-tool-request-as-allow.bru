meta {
  name: Answer the read_file tool request as allow
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/message
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "type": "tool_request",
    "work": 1,
    "call": "p1",
    "name": "read_file",
    "input": {
      "path": "/workspace/a.txt"
    }
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
  res.body.reply.type: eq "tool_decision"
  res.body.reply.is_error: eq false
}

tests {
  test("the decision is allow", function () {
    expect(res.getBody().reply.decision).to.equal("allow");
  });
}
