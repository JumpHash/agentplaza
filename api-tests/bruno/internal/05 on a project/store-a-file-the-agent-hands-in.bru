meta {
  name: Store a file the agent hands in
  type: http
  seq: 39
}

put {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/files?name=t-internal-note.txt&title=t-internal%20note
  body: text
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
  Content-Type: text/plain
}

body:text {
  hello from the internal tests
}

script:post-response {
  bru.setVar("int_file", res.getBody().id);
}

assert {
  res.responseTime: lt 1000
  res.status: eq 201
  res.body.size: eq 29
  res.body.url: isString
}

tests {
  test("the file is a deliverable of the agent", function () {
    expect(res.getBody().kind).to.equal("deliverable");
  });
}
