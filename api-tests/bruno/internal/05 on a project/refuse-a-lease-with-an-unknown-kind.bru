meta {
  name: Refuse a lease with an unknown kind
  type: http
  seq: 77
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/stations/s-t-internal-none/leases
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "kind": "other"
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 400
  res.body.error: isString
}
