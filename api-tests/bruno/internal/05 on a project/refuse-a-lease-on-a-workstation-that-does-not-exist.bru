meta {
  name: Refuse a lease on a workstation that does not exist
  type: http
  seq: 76
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/stations/s-t-internal-none/leases
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "kind": "shared"
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 404
  res.body.error: eq "no such workstation"
}
