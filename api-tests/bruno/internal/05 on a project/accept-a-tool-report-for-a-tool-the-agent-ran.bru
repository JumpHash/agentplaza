meta {
  name: Accept a tool report for a tool the agent ran
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/message
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "type": "tool_report",
    "work": 1,
    "call": "p1",
    "ok": true,
    "output": "ok"
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 200
}

tests {
  test("the guest gets no reply", function () {
    expect(res.getBody().reply).to.be.null;
  });
}
