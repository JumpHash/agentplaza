meta {
  name: Refuse a Gemini model call while the wallet is empty
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/gemini/v1beta/models/gemini-x:generateContent
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "contents": []
  }
}

assert {
  res.responseTime: lt 1000
  res.status: gte 400
  res.status: lt 600
  res.body.error: isString
}

tests {
  test("the refusal is a wallet, key or provider refusal", function () {
    expect([402, 502, 503]).to.include(res.status);
  });
}
