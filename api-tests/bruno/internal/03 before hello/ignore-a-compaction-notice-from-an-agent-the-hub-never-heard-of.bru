meta {
  name: Ignore a compaction notice from an agent the hub never heard of
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/internal/v1/agents/61001/message
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "type": "compressed",
    "work": 1,
    "before": 100,
    "after": 50,
    "folded": 2,
    "reason": "auto"
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 200
}

tests {
  test("the guest gets no reply", function () {
    expect(res.getBody().reply).to.be.null;
  });
}
