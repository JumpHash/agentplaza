meta {
  name: Refuse a Messages call for an agent the hub never heard of
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/internal/v1/agents/61001/gateway/anthropic/v1/messages
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "model": "claude-haiku-5-5",
    "max_tokens": 16,
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ]
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 404
  res.body.error: eq "unknown agent"
}
