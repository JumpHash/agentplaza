meta {
  name: Refuse an egress certificate for a host that is not intercepted
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/internal/egress/cert
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "cid": 61001,
    "host": "example.com"
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 403
  res.body.error: eq "that host is not intercepted for this agent"
}
