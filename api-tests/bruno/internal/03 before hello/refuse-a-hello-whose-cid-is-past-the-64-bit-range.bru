meta {
  name: Refuse a hello whose CID is past the 64-bit range
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/internal/v1/agents/99999999999999999999999/hello
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "role": "orchestrator",
    "vm": 1,
    "caps": []
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 400
  res.body.error: eq "the CID must be a number"
}
