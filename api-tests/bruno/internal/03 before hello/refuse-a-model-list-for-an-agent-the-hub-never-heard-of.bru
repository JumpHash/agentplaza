meta {
  name: Refuse a model list for an agent the hub never heard of
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/internal/v1/agents/61001/gateway/openai/v1/models
  body: none
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 404
  res.body.error: eq "unknown agent"
}
