meta {
  name: Ignore a bye from an agent the hub never heard of
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/internal/v1/agents/61001/message
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "type": "bye",
    "calls": 0
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 200
}

tests {
  test("the guest gets no reply", function () {
    expect(res.getBody().reply).to.be.null;
  });
}
