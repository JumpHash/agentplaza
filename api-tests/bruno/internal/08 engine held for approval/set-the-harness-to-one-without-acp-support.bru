meta {
  name: Set the harness to one without ACP support
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/internal/v1/agents/61007/hello
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "role": "orchestrator",
    "vm": 1,
    "caps": []
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
}
