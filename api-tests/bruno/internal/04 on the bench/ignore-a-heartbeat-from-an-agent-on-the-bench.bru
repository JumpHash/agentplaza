meta {
  name: Ignore a heartbeat from an agent on the bench
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/internal/v1/agents/61002/message
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "type": "heartbeat",
    "seq": 1
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
}

tests {
  test("the guest gets no reply", function () {
    expect(res.getBody().reply).to.be.null;
  });
}
