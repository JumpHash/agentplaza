meta {
  name: Refuse a Messages call for an agent on the bench
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/internal/v1/agents/61002/gateway/anthropic/v1/messages
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "model": "claude-haiku-5-5",
    "max_tokens": 16,
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ]
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 409
}

tests {
  test("the refusal names the bench", function () {
    expect(res.getBody().error).to.include("on the bench");
  });
}
