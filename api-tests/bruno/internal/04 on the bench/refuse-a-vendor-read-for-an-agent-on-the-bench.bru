meta {
  name: Refuse a vendor read for an agent on the bench
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/internal/v1/agents/61002/gateway/vendor/augment/v1/sessions
  body: none
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 409
}

tests {
  test("the refusal names the bench", function () {
    expect(res.getBody().error).to.include("on the bench");
  });
}
