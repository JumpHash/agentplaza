meta {
  name: Read agent 61002 back
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/agents/61002
  body: none
  auth: none
}

assert {
  res.responseTime: lt 1000
  res.status: eq 200
}

tests {
  test("the agent reads back as idle", function () {
    expect(res.getBody().status).to.equal("idle");
  });
  test("the hold names its reason", function () {
    expect(res.getBody().held).to.include("on the bench");
  });
}
