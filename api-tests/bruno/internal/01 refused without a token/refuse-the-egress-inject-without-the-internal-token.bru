meta {
  name: Refuse the egress inject without the internal token
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/internal/egress/inject
  body: json
  auth: none
}

body:json {
  {
    "cid": 61003,
    "host": "example.com",
    "port": 443,
    "method": "GET",
    "path": "/v1"
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
