meta {
  name: Refuse the opencode messages without the internal token
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/opencode/v1/messages
  body: json
  auth: none
}

body:json {
  {
    "model": "x",
    "max_tokens": 16,
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ]
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
