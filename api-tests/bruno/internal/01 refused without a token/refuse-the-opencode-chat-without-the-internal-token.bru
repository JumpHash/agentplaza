meta {
  name: Refuse the opencode chat without the internal token
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/opencode/v1/chat/completions
  body: json
  auth: none
}

body:json {
  {
    "model": "x",
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ]
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
