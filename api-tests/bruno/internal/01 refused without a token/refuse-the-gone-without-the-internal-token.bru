meta {
  name: Refuse the gone without the internal token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/gone
  body: json
  auth: none
}

body:json {
  {
    "reason": "session ended"
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
