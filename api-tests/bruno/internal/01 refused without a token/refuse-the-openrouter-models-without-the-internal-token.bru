meta {
  name: Refuse the openrouter models without the internal token
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/openrouter/v1/models
  body: none
  auth: none
}

assert {
  res.responseTime: lt 1000
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
