meta {
  name: Refuse the vendor read without the internal token
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/vendor/augment/v1/sessions
  body: none
  auth: none
}

assert {
  res.responseTime: lt 1000
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
