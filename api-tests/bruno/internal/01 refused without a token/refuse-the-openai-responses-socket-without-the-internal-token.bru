meta {
  name: Refuse the openai responses socket without the internal token
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/openai/v1/responses
  body: none
  auth: none
}

headers {
  Connection: Upgrade
  Upgrade: websocket
  Sec-WebSocket-Version: 13
  Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==
}

assert {
  res.responseTime: lt 1000
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
