meta {
  name: Refuse the artifact read without the internal token
  type: http
  seq: 33
}

get {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/artifacts/art-t-internal-none
  body: none
  auth: none
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
