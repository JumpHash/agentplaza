meta {
  name: Refuse the message without the internal token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/message
  body: json
  auth: none
}

body:json {
  {
    "type": "heartbeat",
    "seq": 1
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
