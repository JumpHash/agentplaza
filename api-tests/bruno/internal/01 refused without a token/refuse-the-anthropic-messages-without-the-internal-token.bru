meta {
  name: Refuse the anthropic messages without the internal token
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/anthropic/v1/messages
  body: json
  auth: none
}

body:json {
  {
    "model": "claude-haiku-5-5",
    "max_tokens": 16,
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ]
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
