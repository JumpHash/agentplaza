meta {
  name: Create a project for t-internal stop all
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

body:json {
  {
    "title": "t-internal stop all",
    "goal": "Internal API tests",
    "kind": "code"
  }
}

script:post-response {
  bru.setVar("int_proj_stp", res.getBody().id);
}

assert {
  res.responseTime: lt 1000
  res.status: gte 200
  res.status: lt 300
}

tests {
  test("the project has an id", function () {
    expect(res.getBody().id).to.be.a("string");
  });
}
