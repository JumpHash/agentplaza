meta {
  name: Hold a Weft write while the plaza is stopped
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/internal/v1/agents/61008/gateway/weft/records/unsigned
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "kind": "attest",
    "body": {}
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 423
  res.body.error: eq "STOP ALL is on: Weft takes no writes"
}
