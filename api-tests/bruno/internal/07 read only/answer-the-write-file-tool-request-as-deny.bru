meta {
  name: Answer the write_file tool request as deny
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/internal/v1/agents/61006/message
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "type": "tool_request",
    "work": 1,
    "call": "r1",
    "name": "write_file",
    "input": {
      "path": "/workspace/a.txt",
      "content": "a"
    }
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
  res.body.reply.type: eq "tool_decision"
  res.body.reply.is_error: eq true
}

tests {
  test("the decision is deny", function () {
    expect(res.getBody().reply.decision).to.equal("deny");
  });
  test("the reason is read-only", function () {
    expect(res.getBody().reply.output).to.equal("this agent is read-only: write_file is not allowed");
  });
}
