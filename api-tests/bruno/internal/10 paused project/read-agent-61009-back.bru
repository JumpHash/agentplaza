meta {
  name: Read agent 61009 back
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/agents/61009
  body: none
  auth: none
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
}

tests {
  test("the agent reads back as idle", function () {
    expect(res.getBody().status).to.equal("idle");
  });
  test("no session, so no project", function () {
    expect(res.getBody().project).to.be.null;
  });
  test("no session, so the pause holds nothing", function () {
    expect(res.getBody().held).to.be.null;
  });
}
