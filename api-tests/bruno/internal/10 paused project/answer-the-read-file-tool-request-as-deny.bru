meta {
  name: Answer the read_file tool request as deny
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/internal/v1/agents/61009/message
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "type": "tool_request",
    "work": 1,
    "call": "pa1",
    "name": "read_file",
    "input": {
      "path": "/x"
    }
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
  res.body.reply.type: eq "tool_decision"
  res.body.reply.is_error: eq true
}

tests {
  test("the decision is deny", function () {
    expect(res.getBody().reply.decision).to.equal("deny");
  });
  test("the hold names the paused project", function () {
    expect(res.getBody().reply.output).to.include("paused");
  });
}
