meta {
  name: Answer the read tool request as allow: no session, so the pause holds nothing
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/internal/v1/agents/61009/message
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "type": "tool_request",
    "work": 1,
    "call": "pa1",
    "name": "read",
    "input": {
      "files": [{"path": "/x"}]
    }
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
  res.body.reply.type: eq "tool_decision"
  res.body.reply.is_error: eq false
}

tests {
  test("the decision is allow", function () {
    expect(res.getBody().reply.decision).to.equal("allow");
  });
  test("nothing is refused: the agent holds no session on the paused project", function () {
    expect(res.getBody().reply.is_error).to.equal(false);
  });
}
