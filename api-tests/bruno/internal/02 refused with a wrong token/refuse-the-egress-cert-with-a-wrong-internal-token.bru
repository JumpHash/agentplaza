meta {
  name: Refuse the egress cert with a wrong internal token
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/internal/egress/cert
  body: json
  auth: none
}

headers {
  x-apz-internal: t-internal-wrong
}

body:json {
  {
    "cid": 61003,
    "host": "example.com"
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
