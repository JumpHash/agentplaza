meta {
  name: Refuse the gemini models with a wrong internal token
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/gemini/v1beta/models
  body: none
  auth: none
}

headers {
  x-apz-internal: t-internal-wrong
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
