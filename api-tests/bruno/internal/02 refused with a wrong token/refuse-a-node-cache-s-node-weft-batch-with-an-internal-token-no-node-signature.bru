meta {
  name: Refuse a node cache's node weft batch with an internal token, no node signature
  type: http
  seq: 39
}

post {
  url: {{baseUrl}}/internal/v1/nodes/1/weft/wire/want
  body: json
  auth: none
}

headers {
  x-apz-internal: t-internal-wrong
}

body:json {
  {
    "hashes": []
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 403
  res.body.error: eq "bad node signature"
}
