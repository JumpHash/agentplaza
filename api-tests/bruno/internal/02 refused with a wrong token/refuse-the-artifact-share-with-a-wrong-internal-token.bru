meta {
  name: Refuse the artifact share with a wrong internal token
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/artifacts/art-t-internal-none/share
  body: json
  auth: none
}

headers {
  x-apz-internal: t-internal-wrong
}

body:json {
  {
    "reason": "x"
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
