meta {
  name: Refuse the blob upload with a wrong internal token
  type: http
  seq: 31
}

put {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/artifacts/blobs?content_type=text/plain
  body: text
  auth: none
}

headers {
  x-apz-internal: t-internal-wrong
  Content-Type: text/plain
}

body:text {
  abc
}

assert {
  res.responseTime: lt 1000
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
