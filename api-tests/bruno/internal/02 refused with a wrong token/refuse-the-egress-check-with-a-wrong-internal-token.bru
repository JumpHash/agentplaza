meta {
  name: Refuse the egress check with a wrong internal token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/internal/egress/check
  body: json
  auth: none
}

headers {
  x-apz-internal: t-internal-wrong
}

body:json {
  {
    "cid": 61003,
    "host": "example.com",
    "port": 443
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
