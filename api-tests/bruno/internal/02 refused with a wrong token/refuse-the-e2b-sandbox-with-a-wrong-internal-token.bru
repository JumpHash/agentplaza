meta {
  name: Refuse the e2b sandbox with a wrong internal token
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/internal/e2b/sandboxes/sb-t-internal-none
  body: none
  auth: none
}

headers {
  x-apz-internal: t-internal-wrong
}

assert {
  res.responseTime: lt 1000
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
