meta {
  name: Refuse the weft read with a wrong internal token
  type: http
  seq: 35
}

get {
  url: {{baseUrl}}/internal/v1/agents/61003/gateway/weft/wire/objects/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
  body: none
  auth: none
}

headers {
  x-apz-internal: t-internal-wrong
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 403
  res.body.error: eq "missing or wrong internal token"
}
