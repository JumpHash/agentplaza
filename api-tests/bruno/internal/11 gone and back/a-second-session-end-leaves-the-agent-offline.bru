meta {
  name: A second session end leaves the agent offline
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/internal/v1/agents/61010/gone
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "reason": "again"
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
}
