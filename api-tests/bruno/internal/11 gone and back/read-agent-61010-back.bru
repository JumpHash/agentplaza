meta {
  name: Read agent 61010 back
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/agents/61010
  body: none
  auth: none
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
}

tests {
  test("the agent reads back as offline", function () {
    expect(res.getBody().status).to.equal("offline");
  });
  test("no session, so no project", function () {
    expect(res.getBody().project).to.be.null;
  });
}
