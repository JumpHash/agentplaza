meta {
  name: Queue work for the agent
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/agents/61011/chat
  body: json
  auth: none
}

body:json {
  {
    "text": "t-internal queued work"
  }
}

script:post-response {
  bru.setVar("int_work", res.getBody().work);
}

assert {
  res.responseTime: lt 1000
  res.status: eq 200
}

tests {
  test("the work has a number", function () {
    expect(res.getBody().work).to.be.a("number");
  });
}
