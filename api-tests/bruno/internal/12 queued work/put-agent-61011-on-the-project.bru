meta {
  name: Put agent 61011 on the project
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/projects/{{int_proj_que}}/members
  body: json
  auth: none
}

body:json {
  {
    "cid": 61011
  }
}

assert {
  res.responseTime: lt 1000
  res.status: eq 200
}

tests {
  test("the agent's view names the project", function () {
    expect(res.getBody().project).to.equal(bru.getVar("int_proj_que"));
  });
}
