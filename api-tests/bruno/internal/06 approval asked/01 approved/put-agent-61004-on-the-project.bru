meta {
  name: Put agent 61004 on the project
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/projects/{{int_proj_apa}}/members
  body: json
  auth: none
}

body:json {
  {
    "cid": 61004
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
}

tests {
  test("the agent's view names the project", function () {
    expect(res.getBody().project).to.equal(bru.getVar("int_proj_apa"));
  });
}
