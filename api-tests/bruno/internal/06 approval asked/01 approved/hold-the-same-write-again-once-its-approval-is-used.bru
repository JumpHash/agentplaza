meta {
  name: Hold the same write again once its approval is used
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/internal/v1/agents/61004/message
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "type": "tool_request",
    "work": 1,
    "call": "ap1",
    "name": "edit",
    "input": {
      "create": [{"path": "/workspace/a.txt", "content": "a"}]
    }
  }
}

script:post-response {
  bru.setVar("int_appr_2", /\((a\d+)\)/.exec(res.getBody().reply.output)[1]);
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
  res.body.reply.type: eq "tool_decision"
  res.body.reply.is_error: eq true
}

tests {
  test("the decision is deny", function () {
    expect(res.getBody().reply.decision).to.equal("deny");
  });
  test("it needs a new approval", function () {
    expect(res.getBody().reply.output).to.include("waiting for the owner's approval");
  });
}
