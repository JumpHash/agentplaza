meta {
  name: Owner declines the second held write
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/v1/approvals/{{int_appr_2}}
  body: json
  auth: none
}

body:json {
  {
    "approve": false,
    "reason": "t-internal"
  }
}

assert {
  res.responseTime: lt {{budgetMs}}
  res.status: eq 200
  res.body.state: eq "denied"
}
