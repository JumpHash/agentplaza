meta {
  name: The declined command reads back as denied
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/approvals
  body: none
  auth: none
}

assert {
  res.responseTime: lt 1000
  res.status: eq 200
}

tests {
  test("the approval is denied", function () {
    const a = res.getBody().find((x) => x.id === bru.getVar("int_appr_d"));
    expect(a, "approval").to.exist;
    expect(a.state).to.equal("denied");
  });
}
