meta {
  name: List a project's agents, none yet
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v1/projects/{{projectId}}/members
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body: isArray
}

tests {
  test("nobody works on the project yet", function () {
    expect(res.getBody()).to.have.lengthOf(0);
  });
}
