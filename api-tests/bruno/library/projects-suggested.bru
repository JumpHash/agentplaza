meta {
  name: Suggest no agents for a project nobody worked on
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/v1/projects/{{projectId}}/suggested-members
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body: isArray
}

tests {
  test("no agent holds the project's tasks", function () {
    expect(res.getBody()).to.have.lengthOf(0);
  });
}
