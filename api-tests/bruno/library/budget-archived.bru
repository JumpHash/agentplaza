meta {
  name: Refuse to set budget aside for an archived project
  type: http
  seq: 41
}

post {
  url: {{baseUrl}}/v1/projects/{{archivedProjectId}}/budget
  body: json
  auth: none
}

body:json {
  {
    "credits": 100
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
  res.body.error: isString
}
