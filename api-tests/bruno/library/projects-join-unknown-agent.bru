meta {
  name: Answer 404 when adding an unknown agent
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/projects/{{projectId}}/members
  body: json
  auth: none
}

body:json {
  {
    "cid": 4242
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}
