meta {
  name: Refuse a task for an archived project
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

body:json {
  {
    "goal": "Too late",
    "budget": 200,
    "project": "{{archivedProjectId}}"
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
  res.body.error: isString
}
