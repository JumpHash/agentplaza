meta {
  name: Answer 409 when approving an unknown project
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/projects/no-such-project/approve
  body: json
  auth: none
}

body:json {
  {
    "note": "owner approval"
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
  res.body.error: isString
}
