meta {
  name: Set credits aside for a project
  type: http
  seq: 37
}

post {
  url: {{baseUrl}}/v1/projects/{{projectId}}/budget
  body: json
  auth: none
}

body:json {
  {
    "credits": 1000
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.own: eq true
  res.body.balance: eq 1000
}
