meta {
  name: Answer 404 for the links of a preview the hub does not know
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/previews/{{id}}/links
  body: none
  auth: none
}

vars:pre-request {
  id: pv999
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: eq "no preview pv999"
}
