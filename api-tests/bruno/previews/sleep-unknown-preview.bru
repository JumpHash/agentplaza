meta {
  name: Answer 404 when sleeping a preview the hub does not know
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/previews/{{id}}/sleep
  body: none
  auth: none
}

vars:pre-request {
  id: pv999
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: eq "no preview pv999"
}
