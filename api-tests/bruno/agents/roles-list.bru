meta {
  name: List the roles before any custom role exists
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/roles
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("no custom roles yet; built-in roles are listed", function () {
    const roles = res.getBody();
    expect(roles).to.be.an("array");
    expect(roles.filter((r) => r.source === "custom")).to.have.lengthOf(0);
    roles.forEach((r) => expect(r.source).to.equal("builtin"));
  });
}
