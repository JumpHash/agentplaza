meta {
  name: Create a custom role with unicode text
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/roles
  body: json
  auth: none
}

body:json {
  {
    "id": "t-agents-lead",
    "title": "Lead, équipe",
    "purpose": "Mène la recherche.",
    "responsibilities": [
      "Plan the search",
      "Lead the team"
    ],
    "deliverables": [
      "A list of sources"
    ],
    "collaboration": "Works with the scouts.",
    "boundaries": [
      "No publishing"
    ]
  }
}

script:post-response {
  bru.setVar("agents_role_created_ms", res.getBody().created_ms);
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.id: eq "t-agents-lead"
  res.body.title: eq "Lead, équipe"
  res.body.created_by: eq "owner"
}

tests {
  test("the saved role keeps its lists", function () {
    const b = res.getBody();
    expect(b.responsibilities).to.have.lengthOf(2);
    expect(b.deliverables).to.have.lengthOf(1);
    expect(b.created_ms).to.be.above(0);
  });
}
