meta {
  name: Refuse a custom role body that is not JSON
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/roles
  body: text
  auth: none
}

body:text {
  not json
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal says the role is bad", function () {
    expect(res.getBody().error).to.include("bad role");
  });
}
