meta {
  name: Answer 404 when deleting a built-in role
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/v1/roles/architect
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("built-in roles are not custom roles", function () {
    expect(res.getBody().error).to.include("no role architect");
  });
}
