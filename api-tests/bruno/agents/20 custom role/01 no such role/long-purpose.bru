meta {
  name: Refuse a custom role whose purpose is over 600 characters
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/roles
  body: json
  auth: none
}

body:json {
  {
    "id": "t-agents-lead",
    "title": "Lead, équipe",
    "purpose": "",
    "responsibilities": [
      "Plan the search",
      "Lead the team"
    ],
    "deliverables": [
      "A list of sources"
    ],
    "collaboration": "Works with the scouts.",
    "boundaries": [
      "No publishing"
    ]
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("longer than 600");
  });
}
