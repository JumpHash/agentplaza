meta {
  name: Refuse to reject a proposal that does not exist
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/agent-proposals/ap-none/reject
  body: json
  auth: none
}

body:json {
  {
    "reason": "Not needed"
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no proposal ap-none");
  });
}
