meta {
  name: Delete a custom role
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/v1/roles/{{roleId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.id: eq "scout-test"
}

tests {
  test("the role is reported removed", function () {
    expect(res.getBody().removed).to.equal(true);
  });
}
