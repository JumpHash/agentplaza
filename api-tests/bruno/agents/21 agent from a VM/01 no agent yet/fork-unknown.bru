meta {
  name: Answer 404 when forking an agent that does not exist
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/agents/999999/fork
  body: json
  auth: none
}

body:json {
  {
    "n": 2
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no agent 999999");
  });
}
