meta {
  name: Refuse a spawn whose count is text
  type: http
  seq: 37
}

post {
  url: {{baseUrl}}/v1/agents
  body: json
  auth: none
}

body:json {
  {
    "role": "architect",
    "count": "1"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("bad body");
  });
}
