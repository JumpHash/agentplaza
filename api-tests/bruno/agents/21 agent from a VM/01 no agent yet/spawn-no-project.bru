meta {
  name: Refuse a spawn for a project that does not exist
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/v1/agents
  body: json
  auth: none
}

body:json {
  {
    "role": "architect",
    "count": 1,
    "project": "pr-none"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no project pr-none");
  });
}
