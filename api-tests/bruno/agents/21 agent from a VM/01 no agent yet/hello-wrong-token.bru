meta {
  name: Refuse an agent's hello with a wrong internal token
  type: http
  seq: 47
}

post {
  url: {{baseUrl}}/internal/v1/agents/999999/hello
  body: json
  auth: none
}

headers {
  x-apz-internal: wrong-token
}

body:json {
  {
    "vm": 1
  }
}

assert {
  res.status: eq 403
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("missing or wrong internal token");
  });
}
