meta {
  name: Answer 404 when rating an agent that does not exist
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/agents/999999/rating
  body: json
  auth: none
}

body:json {
  {
    "value": 1
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no agent 999999");
  });
}
