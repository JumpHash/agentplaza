meta {
  name: Answer 404 for the contacts of an agent that does not exist
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/agents/999999/contacts
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no agent with guest CID 999999");
  });
}
