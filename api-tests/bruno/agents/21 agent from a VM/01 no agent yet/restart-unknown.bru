meta {
  name: Answer 404 when restarting an agent that does not exist
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/v1/agents/999999/restart
  body: json
  auth: none
}

body:json {
  {}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no agent 999999");
  });
}
