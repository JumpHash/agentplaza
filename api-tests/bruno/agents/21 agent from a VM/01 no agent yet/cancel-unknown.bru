meta {
  name: Answer 404 when cancelling the work of an agent that does not exist
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/v1/agents/999999/cancel
  body: json
  auth: none
}

body:json {
  {}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no such agent");
  });
}
