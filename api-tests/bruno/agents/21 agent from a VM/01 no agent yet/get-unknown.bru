meta {
  name: Answer 404 for an agent that does not exist when read
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/agents/999999
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no such agent");
  });
}
