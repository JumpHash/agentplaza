meta {
  name: Refuse a spawn of zero agents
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/v1/agents
  body: json
  auth: none
}

body:json {
  {
    "role": "architect",
    "count": 0
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("count must be 1..=16");
  });
}
