meta {
  name: Answer 404 when adding a contact to an agent that does not exist
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/agents/999999/contacts
  body: json
  auth: none
}

body:json {
  {
    "peer_cid": 41002
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no agent with guest CID 999999");
  });
}
