meta {
  name: Refuse a spawn of the orchestrator with a project
  type: http
  seq: 41
}

post {
  url: {{baseUrl}}/v1/agents
  body: json
  auth: none
}

body:json {
  {
    "role": "orchestrator",
    "count": 1,
    "project": "pr-none"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("works on every project");
  });
}
