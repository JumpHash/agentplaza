meta {
  name: A spawn of the orchestrator reaches noded and is refused
  type: http
  seq: 45
}

post {
  url: {{baseUrl}}/v1/agents
  body: json
  auth: none
}

body:json {
  {
    "role": "orchestrator",
    "count": 1
  }
}

assert {
  res.status: eq 502
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal comes from the node", function () {
    expect(res.getBody().error).to.match(/^noded/);
  });
}
