meta {
  name: Answer 404 when deleting a checkpoint of an agent that does not exist
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/v1/agents/999999/vm-checkpoints/c1
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no agent 999999");
  });
}
