meta {
  name: Refuse a spawn with no role
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/v1/agents
  body: json
  auth: none
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("missing field `role`");
  });
}
