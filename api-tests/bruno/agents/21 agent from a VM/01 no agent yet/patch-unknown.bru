meta {
  name: Answer 404 when renaming an agent that does not exist
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/agents/999999
  body: json
  auth: none
}

body:json {
  {
    "name": "Ghost"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no such agent");
  });
}
