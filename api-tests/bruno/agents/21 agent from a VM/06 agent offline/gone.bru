meta {
  name: Record that the agent's session has ended
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/internal/v1/agents/41001/gone
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "reason": "session ended"
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}
