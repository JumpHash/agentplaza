meta {
  name: Refuse a name of 17 characters
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/agents/41001
  body: json
  auth: none
}

body:json {
  {
    "name": "Abcdefghijklmnopq"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("2 to 16 characters");
  });
}
