meta {
  name: Refuse extending turns by zero
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/v1/agents/41001/control
  body: json
  auth: none
}

body:json {
  {
    "action": "extend_turns",
    "turns": 0
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("turns from 1 to 200");
  });
}
