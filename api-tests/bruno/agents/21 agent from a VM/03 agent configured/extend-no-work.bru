meta {
  name: Refuse extending turns when the agent has no running work
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/v1/agents/41001/control
  body: json
  auth: none
}

body:json {
  {
    "action": "extend_turns",
    "turns": 5
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("has no running work");
  });
}
