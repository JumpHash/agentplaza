meta {
  name: Refuse a model name with no provider
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/v1/agents/41001
  body: json
  auth: none
}

body:json {
  {
    "model": "nope"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("<provider>/<model>");
  });
}
