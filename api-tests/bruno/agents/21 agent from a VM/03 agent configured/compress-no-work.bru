meta {
  name: Refuse a compress when the agent has no running work
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/v1/agents/41001/control
  body: json
  auth: none
}

body:json {
  {
    "action": "compress"
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("has no running work");
  });
}
