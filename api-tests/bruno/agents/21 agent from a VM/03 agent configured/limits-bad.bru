meta {
  name: Refuse a compress threshold that is out of range
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/v1/agents/41001/control
  body: json
  auth: none
}

body:json {
  {
    "action": "set_limits",
    "compress_at": 10
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("compress_at must be");
  });
}
