meta {
  name: Refuse a rename whose body is not JSON
  type: http
  seq: 11
}

patch {
  url: {{baseUrl}}/v1/agents/41001
  body: text
  auth: none
}

body:text {
  not json
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("bad body");
  });
}
