meta {
  name: Refuse a rating whose value is text
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/v1/agents/41001/rating
  body: json
  auth: none
}

body:json {
  {
    "value": "high"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("invalid rating");
  });
}
