meta {
  name: Refuse a species that is not in the robot list
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/v1/agents/41001/species
  body: json
  auth: none
}

body:json {
  {
    "species": "nope-species"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no species");
  });
}
