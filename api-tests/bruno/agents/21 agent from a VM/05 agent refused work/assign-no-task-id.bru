meta {
  name: Refuse an assignment that names no task
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/agents/41001/assign
  body: json
  auth: none
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("task_id");
  });
}
