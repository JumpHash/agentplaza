meta {
  name: Refuse a message to an agent on the bench
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/agents/41001/tell
  body: json
  auth: none
}

body:json {
  {
    "text": "hi"
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("is on the bench");
  });
}
