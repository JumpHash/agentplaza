meta {
  name: Make sure the agent is registered before its work is refused
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/internal/v1/agents/41001/hello
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "vm": 1
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the hello answers the agent's profile", function () {
    expect(res.getBody().profile).to.be.an("object");
    expect(res.getBody().profile.system).to.include("(CID 41001)");
  });
}
