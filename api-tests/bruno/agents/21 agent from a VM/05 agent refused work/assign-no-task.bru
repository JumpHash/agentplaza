meta {
  name: Refuse an assignment of a task that does not exist
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/agents/41001/assign
  body: json
  auth: none
}

body:json {
  {
    "task_id": "t-none"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no such task");
  });
}
