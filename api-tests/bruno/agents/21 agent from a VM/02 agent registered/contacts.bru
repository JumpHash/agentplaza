meta {
  name: A registered agent has no contacts yet
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/agents/41001/contacts
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.agent_cid: eq 41001
}

tests {
  test("no contact is listed", function () {
    expect(res.getBody().contacts).to.have.lengthOf(0);
    expect(res.getBody().total).to.equal(0);
  });
}
