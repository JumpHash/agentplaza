meta {
  name: A registered agent has no limits set
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/v1/agents/41001/limits
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("every limit is unset", function () {
    const b = res.getBody();
    expect(b.max_turns).to.be.null;
    expect(b.compress_at).to.be.null;
    expect(b.keep_recent).to.be.null;
  });
}
