meta {
  name: Refuse a name another agent already has
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/agents/41002
  body: json
  auth: none
}

body:json {
  {
    "name": "Mira"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("already used by another agent");
  });
}
