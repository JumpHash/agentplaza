meta {
  name: List the agent's contacts: one contact, the peer
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/agents/41001/contacts
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.total: eq 1
}

tests {
  test("the peer is the only contact", function () {
    const c = res.getBody().contacts;
    expect(c).to.have.lengthOf(1);
    expect(c[0].peer_cid).to.equal(41002);
    expect(c[0].kind).to.equal("met");
  });
}
