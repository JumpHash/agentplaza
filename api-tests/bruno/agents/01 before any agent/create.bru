meta {
  name: Create a custom role
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/roles
  body: json
  auth: none
}

body:json {
  {
    "id": "scout-test",
    "title": "Scout",
    "purpose": "Finds sources for the team.",
    "responsibilities": ["Search the web"],
    "deliverables": ["A list of sources"]
  }
}

script:post-response {
  bru.setVar("roleId", res.getBody().id);
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.id: eq "scout-test"
  res.body.title: eq "Scout"
  res.body.created_by: eq "owner"
}
