meta {
  name: List the agents on a hub with no node
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/agents
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the roster is an empty array", function () {
    expect(res.getBody()).to.be.an("array").that.is.empty;
  });
}
