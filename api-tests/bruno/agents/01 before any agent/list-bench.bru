meta {
  name: List the bench on a hub with no node
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/v1/agents?project=bench
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body: isArray
}

tests {
  test("nobody waits on the bench", function () {
    expect(res.getBody()).to.have.lengthOf(0);
  });
}
