meta {
  name: Read the custom role back from the list
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/roles
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the new role is listed as custom with its title", function () {
    const role = res.getBody().find((r) => r.id === "scout-test");
    expect(role).to.not.be.undefined;
    expect(role.source).to.equal("custom");
    expect(role.title).to.equal("Scout");
    expect(role.agents).to.equal(0);
  });
}
