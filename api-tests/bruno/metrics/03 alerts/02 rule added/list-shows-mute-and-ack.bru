meta {
  name: List the alerts and see the mute, the ack and their history
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/metrics/alerts
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the mute and the acknowledgement are listed with the rule", function () {
    const id = bru.getVar("metrics_rule_id");
    const body = res.getBody();
    expect(body.muted.find((m) => m[0] === id)).to.not.be.undefined;
    expect(body.acked.find((a) => a[0] === id && a[1] === "global")).to.not.be.undefined;
    const whats = body.history.filter((h) => h[1] === id).map((h) => h[3]);
    expect(whats).to.include("muted");
    expect(whats).to.include("acknowledged");
  });
}
