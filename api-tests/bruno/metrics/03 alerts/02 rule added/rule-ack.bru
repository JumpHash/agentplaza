meta {
  name: Acknowledge the owner's rule for the global scope
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/metrics/alerts/{{metrics_rule_id}}/ack
  body: json
  auth: none
}

body:json {
  {
    "subject": "global"
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.ok: eq true
}
