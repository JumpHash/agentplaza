meta {
  name: Switch the owner's rule back on
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/metrics/alerts/{{metrics_rule_id}}/on
  body: json
  auth: none
}

body:json {
  {
    "on": true
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.rule.on: eq true
}
