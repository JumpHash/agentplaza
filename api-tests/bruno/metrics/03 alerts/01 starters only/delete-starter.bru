meta {
  name: Refuse to delete a starter rule
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/v1/metrics/alerts/rules/starter-ttft
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the error says a starter cannot be deleted", function () {
    expect(res.getBody().error).to.include("starter");
  });
}
