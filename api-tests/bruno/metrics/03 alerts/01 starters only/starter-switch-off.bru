meta {
  name: Switch a starter rule off and keep its threshold
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/v1/metrics/alerts/rules
  body: json
  auth: none
}

body:json {
  {
    "id": "starter-ttft",
    "name": "First token p95 over 2 s",
    "metric": "llm.ttft_ms",
    "agg": "p95",
    "scope": "global",
    "cmp": "gt",
    "threshold": 1,
    "for_ms": 600000,
    "severity": "critical",
    "on": false
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.ok: eq true
  res.body.rule.on: eq false
}

tests {
  test("only the switch changed on a starter", function () {
    expect(res.getBody().rule.threshold).to.equal(2000);
  });
}
