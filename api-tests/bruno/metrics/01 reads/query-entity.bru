meta {
  name: Read a series grouped by entity
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/metrics/query
  body: json
  auth: none
}

body:json {
  {
    "metric": "cpu",
    "scope": "global",
    "from_ms": 0,
    "to_ms": 3600000,
    "step_ms": 60000,
    "agg": "avg",
    "group": "entity"
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the answer lists groups", function () {
    expect(res.getBody().groups).to.be.an("array");
  });
}
