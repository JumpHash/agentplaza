meta {
  name: Refuse a view whose shift is not a number
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/metrics/view?tab=overview&shift=soon
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the error names the shift", function () {
    expect(res.getBody().error).to.include("shift");
  });
}
