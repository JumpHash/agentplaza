meta {
  name: List the service-level objectives
  type: http
  seq: 37
}

get {
  url: {{baseUrl}}/v1/metrics/slos
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
