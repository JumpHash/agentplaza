meta {
  name: Refuse to open an agent whose id is not a number
  type: http
  seq: 44
}

post {
  url: {{baseUrl}}/v1/metrics/open/first
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error names the agent", function () {
    expect(res.getBody().error).to.include("agent");
  });
}
