meta {
  name: Refuse a grouping with an empty label
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/v1/metrics/query
  body: json
  auth: none
}

body:json {
  {
    "metric": "cpu",
    "scope": "global",
    "from_ms": 0,
    "to_ms": 3600000,
    "step_ms": 60000,
    "agg": "avg",
    "group": "label:"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error names the group", function () {
    expect(res.getBody().error).to.include("group must be");
  });
}
