meta {
  name: Refuse an events window whose start is not a number
  type: http
  seq: 29
}

get {
  url: {{baseUrl}}/v1/metrics/events?scope=global&from=yesterday
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the error names from", function () {
    expect(res.getBody().error).to.include("from");
  });
}
