meta {
  name: Read a series with a step as large as a u64
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/v1/metrics/query
  body: json
  auth: none
}

body:json {
  {
    "metric": "cpu",
    "scope": "global",
    "from_ms": 0,
    "to_ms": 3600000,
    "step_ms": 18446744073709551615,
    "agg": "max",
    "group": "all"
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the answer lists groups", function () {
    expect(res.getBody().groups).to.be.an("array");
  });
}
