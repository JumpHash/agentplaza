meta {
  name: Refuse a forecast with an unknown range
  type: http
  seq: 39
}

get {
  url: {{baseUrl}}/v1/metrics/forecast?range=2w
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the error names the range", function () {
    expect(res.getBody().error).to.include("range");
  });
}
