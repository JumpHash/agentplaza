meta {
  name: Refuse a call page whose before is not a number
  type: http
  seq: 33
}

get {
  url: {{baseUrl}}/v1/metrics/calls/page?before=x
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error names before", function () {
    expect(res.getBody().error).to.include("before");
  });
}
