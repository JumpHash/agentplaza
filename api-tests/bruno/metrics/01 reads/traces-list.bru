meta {
  name: List the kept traces
  type: http
  seq: 34
}

get {
  url: {{baseUrl}}/v1/metrics/traces?scope=global&limit=5
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the traces are a list", function () {
    expect(res.getBody()).to.be.an("array");
  });
}
