meta {
  name: List the metric scopes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/metrics/scopes
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the scope tree is a list", function () {
    expect(res.getBody()).to.be.an("array");
  });
}
