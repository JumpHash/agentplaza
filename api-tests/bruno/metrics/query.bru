meta {
  name: Read a metric series grouped by all
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/metrics/query
  body: json
  auth: none
}

body:json {
  {
    "metric": "cpu",
    "scope": "global",
    "from_ms": 0,
    "to_ms": 3600000,
    "step_ms": 60000,
    "agg": "avg",
    "group": "all"
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.groups: isArray
}
