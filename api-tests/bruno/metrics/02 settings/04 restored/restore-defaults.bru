meta {
  name: Restore the default settings
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/v1/metrics/settings
  body: json
  auth: none
}

body:json {
  {
    "level": "standard",
    "retention": {
      "chunks_hours": 48,
      "minute_days": 14,
      "hour_days": 400,
      "calls_days": 90,
      "traces_days": 7,
      "traces_cap_mb": 2048,
      "events_days": 90
    },
    "budgets": [],
    "monthly_budget_usd": null,
    "basis_days": 14,
    "outside": {
      "openmetrics": false,
      "otlp": false,
      "otlp_url": "",
      "otlp_confirmed": false
    }
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.level: eq "standard"
}

tests {
  test("the defaults are back", function () {
    const body = res.getBody();
    expect(body.retention.calls_days).to.equal(90);
    expect(body.budgets).to.have.lengthOf(0);
    expect(body.monthly_budget_usd).to.equal(null);
    expect(body.basis_days).to.equal(14);
  });
}
