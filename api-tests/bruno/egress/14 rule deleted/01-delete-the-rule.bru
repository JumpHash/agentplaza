meta {
  name: Delete the rule
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/v1/egress/inject/{{egress_rule_id}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the delete answers ok", function () {
    expect(res.getBody().ok).to.equal(true);
  });
}
