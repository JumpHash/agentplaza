meta {
  name: Refuse a secret that is not in the vault
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/egress/inject
  body: json
  auth: none
}

body:json {
  {
    "host": "api.bru-egress.test",
    "port": 443,
    "methods": [
      "GET"
    ],
    "path_prefix": "/v1",
    "header": "Authorization",
    "format": "Bearer ${SECRET}",
    "secret": "BRU_EGRESS_UNBOUND"
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal says no bound secret has that name", function () {
    expect(res.getBody().error).to.include("is bound to the egress consumer");
  });
}
