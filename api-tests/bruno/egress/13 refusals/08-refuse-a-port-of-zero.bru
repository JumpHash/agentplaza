meta {
  name: Refuse a port of zero
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/egress/inject
  body: json
  auth: none
}

body:json {
  {
    "host": "api.bru-egress.test",
    "port": 0,
    "methods": [
      "GET"
    ],
    "path_prefix": "/v1",
    "header": "Authorization",
    "format": "Bearer ${SECRET}",
    "secret": "BRU_EGRESS_KEY"
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal gives the port range", function () {
    expect(res.getBody().error).to.equal("the port is 1 to 65535");
  });
}
