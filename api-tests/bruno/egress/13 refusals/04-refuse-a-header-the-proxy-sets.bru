meta {
  name: Refuse a header the proxy sets itself
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/egress/inject
  body: json
  auth: none
}

body:json {
  {
    "host": "api.bru-egress.test",
    "port": 443,
    "methods": [
      "GET"
    ],
    "path_prefix": "/v1",
    "header": "Host",
    "format": "Bearer ${SECRET}",
    "secret": "BRU_EGRESS_KEY"
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}

tests {
  test("the refusal names the framing header", function () {
    expect(res.getBody().error).to.include("framing header");
  });
}
