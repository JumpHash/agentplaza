meta {
  name: List the rules before any is made
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/egress/inject
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the rules answer a list, and none names the test host", function () {
    const rules = res.getBody().rules;
    expect(rules).to.be.an("array");
    expect(rules.some((r) => r.host === "api.bru-egress.test")).to.equal(false);
  });
}
