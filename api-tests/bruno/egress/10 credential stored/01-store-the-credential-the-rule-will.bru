meta {
  name: Store the credential the rule will add
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/vault/secrets
  body: json
  auth: none
}

body:json {
  {
    "name": "BRU_EGRESS_KEY",
    "kind": "api_key",
    "label": "bru egress",
    "value": "bru-egress-value-0123456789",
    "scope": {
      "kind": "plaza"
    },
    "bindings": [
      "egress"
    ]
  }
}

assert {
  res.status: eq 200
  res.body.name: eq "BRU_EGRESS_KEY"
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("egress_secret_id", res.getBody().id);
}

tests {
  test("the secret is bound to the egress consumer and no value comes back", function () {
    expect(res.getBody().bindings).to.deep.equal(["egress"]);
    expect(JSON.stringify(res.getBody())).to.not.include("bru-egress-value-0123456789");
  });
}
