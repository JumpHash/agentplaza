meta {
  name: Refuse a secret that is not bound to the egress consumer
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/egress/inject/{{egress_rule_id}}
  body: json
  auth: none
}

body:json {
  {
    "secret": "BRU_EGRESS_UNBOUND"
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}

tests {
  test("the refusal says the secret is not bound", function () {
    expect(res.getBody().error).to.include("is bound to the egress consumer");
  });
}
