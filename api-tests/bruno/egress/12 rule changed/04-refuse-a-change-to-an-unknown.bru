meta {
  name: Refuse a change to an unknown rule
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/v1/egress/inject/egress_rule_nope
  body: json
  auth: none
}

body:json {
  {
    "enabled": true
  }
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
