meta {
  name: Call the hub of a loose job that does not exist (health)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/foundry/jobs/t-job-nohub/hub/health
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("there is no loose hub for that job", function () {
    expect(res.getBody().error).to.equal("no loose hub for this job");
  });
}
