meta {
  name: Call the hub of a loose job that does not exist (init)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/foundry/jobs/t-job-nohub/hub/init
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
}

tests {
  test("there is no loose hub for that job", function () {
    expect(res.getBody().error).to.equal("no loose hub for this job");
  });
}
