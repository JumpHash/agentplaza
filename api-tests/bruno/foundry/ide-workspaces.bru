meta {
  name: List the IDE's workspaces (only project repos on a fresh hub)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/ide/workspaces
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body: isArray
}

tests {
  test("no agents or workstations: only the repos of the projects opened earlier in the run", function () {
    const body = res.getBody();
    expect(body).to.be.an("array");
    // The projects folder runs first and opens projects, whose repositories Weft lists as repo workspaces.
    for (const ws of body) {
      expect(ws.kind).to.equal("repo");
      expect(ws.id).to.match(/^repo:/);
    }
  });
}
