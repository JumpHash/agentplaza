meta {
  name: List the jobs (empty on a fresh hub)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/foundry/jobs
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body: isArray
}

tests {
  test("no jobs on a fresh hub", function () {
    expect(res.getBody()).to.be.an("array").that.is.empty;
  });
}
