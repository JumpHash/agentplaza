meta {
  name: Refuse an upload row whose number is a string
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/foundry/datasets/upload?name=t-ds-bad
  body: text
  auth: none
}

body:text {
  {"ts":1700000000000,"label":"cheap","prompt_chars":"many","prompt_tokens":25,"tool_count":0,"history_turns":0,"attachments":0,"prior_failures":0,"task_kind":"chat","domain":"support","tenant_tier":"free","requested_model":"m-small","task_id":"t-ds-00"}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error names the feature", function () {
    expect(res.getBody().error).to.equal("line 1: prompt_chars must be a whole number");
  });
}
