meta {
  name: Export a cascade dataset from the plaza's records
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/foundry/datasets
  body: json
  auth: none
}

body:json {
  {
    "kind": "cascade",
    "name": "t-ds-export"
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("fdy_export", res.getBody().id);
}

tests {
  test("the export is kept with its kind", function () {
    expect(res.getBody().id).to.match(/^ds-/);
    expect(res.getBody().name).to.equal("t-ds-export");
  });
}
