meta {
  name: Refuse an export whose body is not JSON
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/foundry/datasets
  body: text
  auth: none
}

body:text {
  not json
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error names the export spec", function () {
    expect(res.getBody().error).to.match(/^export spec:/);
  });
}
