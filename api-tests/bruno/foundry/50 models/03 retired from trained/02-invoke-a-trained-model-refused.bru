meta {
  name: Invoke a trained model: refused
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/foundry/models/{{fmdl_b}}/invoke
  body: json
  auth: none
}

body:json {
  {
    "x0": 0.5, "x1": -0.2, "x2": 1.0
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal says only shadow and promoted models run", function () {
    expect(res.getBody().error).to.include("only shadow and promoted models run");
  });
}
