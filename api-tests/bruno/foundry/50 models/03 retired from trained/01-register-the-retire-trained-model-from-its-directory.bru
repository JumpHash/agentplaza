meta {
  name: Register the retire-trained model from its directory
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/foundry/models/import
  body: json
  auth: none
}

body:json {
  {
    "path": "{{fmdl_dir}}/retire-trained"
  }
}

script:pre-request {
  bru.setVar("fmdl_dir", bru.cwd() + "/foundry/fixtures");
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}
script:post-response {
  bru.setVar("fmdl_b", res.getBody().id);
}
tests {
  test("the second model starts trained", function () {
    expect(res.getBody().state).to.equal("trained");
  });
}
