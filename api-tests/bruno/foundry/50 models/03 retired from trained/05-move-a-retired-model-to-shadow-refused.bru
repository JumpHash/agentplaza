meta {
  name: Move a retired model to shadow: refused
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/foundry/models/{{fmdl_b}}/shadow
  body: none
  auth: none
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
}

tests {
  test("the error names retired", function () {
    expect(res.getBody().error).to.include("is retired");
  });
}
