meta {
  name: Move a trained model to shadow
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/foundry/models/{{fmdl_a}}/shadow
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the model is in shadow", function () {
    expect(res.getBody().state).to.equal("shadow");
  });
}
