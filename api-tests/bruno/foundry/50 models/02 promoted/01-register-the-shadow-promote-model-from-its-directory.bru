meta {
  name: Register the shadow-promote model from its directory
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/foundry/models/import
  body: json
  auth: none
}

body:json {
  {
    "path": "{{fmdl_dir}}/shadow-promote"
  }
}

script:pre-request {
  bru.setVar("fmdl_dir", bru.cwd() + "/foundry/fixtures");
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}
script:post-response {
  bru.setVar("fmdl_a", res.getBody().id);
}
tests {
  test("a registered model starts trained with no agent", function () {
    const body = res.getBody();
    expect(body.state).to.equal("trained");
    expect(body.agent_cid).to.be.null;
    expect(body.card.id).to.match(/^t-shadow-promote-[0-9a-f]{8}$/);
  });
}
