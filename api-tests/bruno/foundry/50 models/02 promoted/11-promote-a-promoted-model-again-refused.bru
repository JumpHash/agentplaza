meta {
  name: Promote a promoted model again: refused
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/foundry/models/{{fmdl_a}}/promote
  body: none
  auth: none
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
}

tests {
  test("the error names the state", function () {
    expect(res.getBody().error).to.include("is promoted: a model is promoted from shadow");
  });
}
