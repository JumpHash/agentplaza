meta {
  name: Shadow a promoted model: refused
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/foundry/models/{{fmdl_a}}/shadow
  body: none
  auth: none
}

assert {
  res.status: eq 409
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal says the model is promoted", function () {
    expect(res.getBody().error).to.include("is promoted");
  });
}
