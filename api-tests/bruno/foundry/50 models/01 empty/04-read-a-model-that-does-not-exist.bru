meta {
  name: Read a model that does not exist
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/foundry/models/t-no-model
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error says no such model", function () {
    expect(res.getBody().error).to.equal("no such model");
  });
}
