meta {
  name: A search is refused while huggingface.co is blocked
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/foundry/hf/models?search=t-llama
  body: none
  auth: none
}

assert {
  res.status: eq 403
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal names the block list", function () {
    expect(res.getBody().error).to.include("fetch_block");
  });
}
