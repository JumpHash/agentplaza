meta {
  name: Refuse an import body that is not JSON
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/v1/foundry/hf/import
  body: text
  auth: none
}

body:text {
  not json
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal says the body is bad", function () {
    expect(res.getBody().error).to.match(/^bad body/);
  });
}
