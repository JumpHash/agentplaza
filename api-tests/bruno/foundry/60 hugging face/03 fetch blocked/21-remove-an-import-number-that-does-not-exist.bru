meta {
  name: Remove an import number that does not exist
  type: http
  seq: 21
}

delete {
  url: {{baseUrl}}/v1/foundry/hf/imports/999
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
}

tests {
  test("the refusal says there is no such import", function () {
    expect(res.getBody().error).to.equal("no such import");
  });
}
