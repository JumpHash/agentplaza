meta {
  name: Refuse a search with a limit that is not a number
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/foundry/hf/models?search=t-llama&limit=ten
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the refusal gives the limit range", function () {
    expect(res.getBody().error).to.include("1..=100");
  });
}
