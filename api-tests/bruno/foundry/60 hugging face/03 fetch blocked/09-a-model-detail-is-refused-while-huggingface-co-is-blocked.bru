meta {
  name: A model detail is refused while huggingface.co is blocked
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/foundry/hf/models/t-org/t-model
  body: none
  auth: none
}

assert {
  res.status: eq 403
  res.responseTime: lt 1000
}

tests {
  test("the refusal names the block list", function () {
    expect(res.getBody().error).to.include("fetch_block");
  });
}
