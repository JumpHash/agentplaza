meta {
  name: Read an import number that is not a number
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/v1/foundry/hf/imports/abc
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error says a whole number", function () {
    expect(res.getBody().error).to.include("whole number");
  });
}
