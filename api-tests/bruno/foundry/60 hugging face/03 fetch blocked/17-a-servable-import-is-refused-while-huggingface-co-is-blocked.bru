meta {
  name: A servable import is refused while huggingface.co is blocked (nothing is downloaded)
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/v1/foundry/hf/import
  body: json
  auth: none
}

body:json {
  {
    "id": "t-org/t-model",
    "as": "servable"
  }
}

assert {
  res.status: eq 403
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal names the block list and the url that was not fetched", function () {
    expect(res.getBody().error).to.include("fetch_block");
    expect(res.getBody().url).to.equal("https://huggingface.co/t-org/t-model");
  });
}
