meta {
  name: Read an import number that does not exist
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/v1/foundry/hf/imports/999
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error says no such import", function () {
    expect(res.getBody().error).to.equal("no such import");
  });
}
