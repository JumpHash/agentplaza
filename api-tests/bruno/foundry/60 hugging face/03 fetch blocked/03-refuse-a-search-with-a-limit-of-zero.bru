meta {
  name: Refuse a search with a limit of zero
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/foundry/hf/models?search=t-llama&limit=0
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error names the limit range", function () {
    expect(res.getBody().error).to.match(/^limit must be 1\.\.=100/);
  });
}
