meta {
  name: Remove the token again: still no token
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/v1/foundry/hf/token
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("no token", function () {
    expect(res.getBody().hf_token_set).to.equal(false);
  });
}
