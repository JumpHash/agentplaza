meta {
  name: The status still shows no token after the refusals
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/foundry/hf/status
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("no token was stored", function () {
    expect(res.getBody().hf_token_set).to.equal(false);
  });
}
