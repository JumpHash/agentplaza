meta {
  name: Remove a token that was never set
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/v1/foundry/hf/token
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("still no token", function () {
    expect(res.getBody().hf_token_set).to.equal(false);
  });
}
