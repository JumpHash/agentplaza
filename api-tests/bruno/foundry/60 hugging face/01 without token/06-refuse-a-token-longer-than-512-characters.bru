meta {
  name: Refuse a token longer than 512 characters
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/v1/foundry/hf/token
  body: json
  auth: none
}

body:json {
  {
    "value": ""
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the refusal says the token must be one line with no spaces", function () {
    expect(res.getBody().error).to.include("one line with no spaces");
  });
}
