meta {
  name: Upload a dataset with no file named
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/foundry/datasets/upload
  body: json
  auth: none
}

body:json {
  {"name": "no-path.jsonl"}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the error asks for a name and a path", function () {
    expect(res.getBody().error).to.equal("{name, path} names the upload");
  });
}
