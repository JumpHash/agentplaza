meta {
  name: List the datasets
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/foundry/datasets
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body: isArray
}

tests {
  test("every dataset in the list has an id and a kind", function () {
    // The folders under this one (run before it) upload and export datasets, so the list is not empty.
    for (const ds of res.getBody()) {
      expect(ds.id).to.be.a("string");
      expect(ds.kind).to.be.a("string");
    }
  });
}
