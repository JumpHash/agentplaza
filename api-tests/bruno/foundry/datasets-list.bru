meta {
  name: List the datasets (empty on a fresh hub)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/foundry/datasets
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body: isArray
}

tests {
  test("no datasets on a fresh hub", function () {
    expect(res.getBody()).to.be.an("array").that.is.empty;
  });
}
