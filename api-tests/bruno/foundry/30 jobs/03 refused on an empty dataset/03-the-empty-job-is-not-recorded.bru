meta {
  name: The empty job is not recorded
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/foundry/jobs/t-job-empty
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
}

tests {
  test("the empty job is not there: no such job", function () {
    expect(res.getBody().error).to.equal("no such job");
  });
}
