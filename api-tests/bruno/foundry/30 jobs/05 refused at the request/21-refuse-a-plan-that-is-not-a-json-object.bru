meta {
  name: Refuse a plan that is not a JSON object
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/v1/foundry/plan
  body: json
  auth: none
}

body:json {
  "just a string"
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.equal("the job is a JSON object");
  });
}
