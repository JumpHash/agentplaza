meta {
  name: Refuse a job with no datasets
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/foundry/jobs
  body: json
  auth: none
}

body:json {
  {"recipe": "rung-predictor@1", "budget_gpu_hours": 1}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.equal("datasets is a non-empty array of dataset ids");
  });
}
