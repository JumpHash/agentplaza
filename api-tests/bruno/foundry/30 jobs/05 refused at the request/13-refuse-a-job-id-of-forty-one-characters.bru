meta {
  name: Refuse a job id of forty-one characters
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/v1/foundry/jobs
  body: json
  auth: none
}

body:json {
  {"job_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "recipe": "rung-predictor@1", "datasets": ["ds-x"], "budget_gpu_hours": 1}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.match(/^job_id is 1-40 letters/);
  });
}
