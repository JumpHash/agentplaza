meta {
  name: Refuse an unknown mode
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/foundry/jobs
  body: json
  auth: none
}

body:json {
  {"recipe": "rung-predictor@1", "datasets": ["ds-x"], "budget_gpu_hours": 1, "mode": "sideways"}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.equal("mode is single, tight or loose");
  });
}
