meta {
  name: Refuse a recipe name with capital letters
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/foundry/jobs
  body: json
  auth: none
}

body:json {
  {"recipe": "Rung@1", "datasets": ["ds-x"], "budget_gpu_hours": 1}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("is not NAME@VERSION");
  });
}
