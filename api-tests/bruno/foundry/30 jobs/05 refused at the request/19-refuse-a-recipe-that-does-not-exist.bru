meta {
  name: Refuse a recipe that does not exist
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/v1/foundry/jobs
  body: json
  auth: none
}

body:json {
  {"recipe": "no-such-recipe@1", "datasets": ["ds-x"], "budget_gpu_hours": 1}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.equal("no recipe no-such-recipe@1");
  });
}
