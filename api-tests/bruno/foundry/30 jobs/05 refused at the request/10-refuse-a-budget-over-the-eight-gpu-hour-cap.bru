meta {
  name: Refuse a budget over the eight GPU-hour cap
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/foundry/jobs
  body: json
  auth: none
}

body:json {
  {"recipe": "rung-predictor@1", "datasets": ["ds-x"], "budget_gpu_hours": 9}
}

assert {
  res.status: eq 403
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("over the 8 GPU-hour cap");
  });
}
