meta {
  name: Refuse a device block with a string where a number goes
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/v1/foundry/jobs
  body: json
  auth: none
}

body:json {
  {"recipe": "rung-predictor@1", "datasets": ["ds-x"], "budget_gpu_hours": 1, "devices": {"min_devices": "two"}}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.match(/^devices: /);
  });
}
