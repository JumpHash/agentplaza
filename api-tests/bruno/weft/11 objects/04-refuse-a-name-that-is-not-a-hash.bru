meta {
  name: Refuse an upload whose name is not a hash
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/weft/wire/objects/not-a-hash
  body: text
  auth: none
}

body:text {
  hello from bru
}

assert {
  res.status: eq 400
  res.responseTime: lt 2000
}

tests {
  test("the refusal says it is not a hash", function () {
    expect(res.getBody().error).to.equal("not a hash");
  });
}
