meta {
  name: Remove the connection from the repo, as the owner
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/weft/console
  body: json
  auth: none
}

body:json {
  {"kind": "connection.remove", "body": {"repo": "t-weft-repo-b", "id": "t-conn-a"}}
}

assert {
  res.status: eq 200
  res.responseTime: lt 2000
}
