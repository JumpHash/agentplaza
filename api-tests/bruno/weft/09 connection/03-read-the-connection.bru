meta {
  name: The repo shows its connection as in step, with no credential in it
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/weft/repos/t-weft-repo-b
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 2000
}

tests {
  test("the connection is listed with its remote, branch, author and state", function () {
    const conn = res.getBody().connections.find((c) => c.id === "t-conn-a");
    expect(conn).to.exist;
    expect(conn.remote).to.equal("file:///nonexistent/t-weft-remote.git");
    expect(conn.platform).to.equal("git");
    expect(conn.branch).to.equal("main");
    expect(conn.author).to.equal("Owner <owner@example.test>");
    expect(conn.state).to.equal("in-step");
  });
}
