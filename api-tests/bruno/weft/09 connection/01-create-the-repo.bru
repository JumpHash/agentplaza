meta {
  name: Create the repo a connection will be added to
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/weft/console
  body: json
  auth: none
}

body:json {
  {"kind": "repo.create", "body": {"repo": "t-weft-repo-b", "project": "t-weft-project"}}
}

assert {
  res.status: eq 200
  res.responseTime: lt 2000
}
