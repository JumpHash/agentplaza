meta {
  name: Revert docs to the built-in content, saved as a newer version 3
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/v1/recipes/docs
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  req.setBody({ toml: bru.getVar("docs_v1_toml").replace("version = 1", "version = 3") });
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.recipe.version: eq 3
  res.body.recipe.title: eq "Documentation"
}
