meta {
  name: List the review recipes, with the three built in at their versions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/recipes
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("code is at version 3, docs and research at 1, and proposals is a list", function () {
    const body = res.getBody();
    const at = (id, v) => body.recipes.some((r) => r.id === id && r.version === v);
    expect(at("code", 3)).to.equal(true);
    expect(at("docs", 1)).to.equal(true);
    expect(at("research", 1)).to.equal(true);
    expect(body.proposals).to.be.an("array");
  });
}
