meta {
  name: Refuse a recipe whose nodes wait on each other
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/v1/recipes/docs
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  req.setBody({ toml: 'id = "docs"\nversion = 9\ntitle = "t"\n\n[[node]]\nid = "a"\nkind = "tool"\ntool = "tree"\nafter = ["b"]\n\n[[node]]\nid = "b"\nkind = "tool"\ntool = "tree"\nafter = ["a"]\n\n[[node]]\nid = "gate"\nkind = "gate"\n' });
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: eq "the recipe's links make a cycle"
}
