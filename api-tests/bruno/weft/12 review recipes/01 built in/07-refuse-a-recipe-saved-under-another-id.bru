meta {
  name: Refuse a recipe saved under another recipe's id
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/v1/recipes/research
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  req.setBody({ toml: 'id = "docs"\nversion = 9\ntitle = "t"\n\n[[node]]\nid = "gate"\nkind = "gate"\n' });
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: eq "the recipe's id is not the route's"
}
