meta {
  name: Record a task's qualification stages and lab minutes
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/evals/qualified
  body: json
  auth: none
}

body:json {
  {
    "task": "{{taskId}}",
    "stages": 2,
    "lab_minutes": 45
  }
}

assert {
  res.status: eq 200
}

tests {
  test("the qualification is recorded on the task's eval records", function () {
    expect(res.getBody().lab_minutes).to.equal(45);
  });
}
