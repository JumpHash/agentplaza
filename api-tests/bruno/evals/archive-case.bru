meta {
  name: Archive a task with its known outcome as a benchmark case
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/evals/archive
  body: json
  auth: none
}

body:json {
  {
    "project": "{{projectId}}",
    "task": "old-1",
    "start": "root",
    "goal": "Write the notes",
    "check": "the notes are written and reviewed",
    "outcome": "landed"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("the archived case has an id", function () {
    expect(res.getBody().id).to.be.a("number");
  });
}
