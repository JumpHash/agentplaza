meta {
  name: Refuse a change that is not a JSON object
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/v1/mcp/servers/bru-fake-mcp
  body: json
  auth: none
}

body:json {
  [
    "not",
    "an",
    "object"
  ]
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
