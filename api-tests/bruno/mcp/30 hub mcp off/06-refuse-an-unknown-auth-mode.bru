meta {
  name: Refuse an unknown auth mode
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/v1/hub-mcp
  body: json
  auth: none
}

body:json {
  {
    "enabled": false,
    "bind": "local",
    "allowed_origins": [],
    "auth_mode": "anyone"
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}

tests {
  test("the refusal names the modes", function () {
    expect(res.getBody().error).to.equal("auth_mode is secure or open");
  });
}
