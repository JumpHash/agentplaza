meta {
  name: Refuse an origin that carries a path
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/v1/hub-mcp
  body: json
  auth: none
}

body:json {
  {
    "enabled": false,
    "bind": "local",
    "allowed_origins": [
      "https://evil.test/path"
    ]
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}
