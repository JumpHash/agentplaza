meta {
  name: Refuse a plain-http address while private addresses are off
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/mcp/servers
  body: json
  auth: none
}

body:json {
  {
    "id": "bru-plain-mcp",
    "name": "Plain",
    "transport": {
      "kind": "http",
      "url": "http://127.0.0.1:9/mcp"
    },
    "allow_private": false
  }
}

assert {
  res.status: eq 400
  res.body.field: eq transport.url
  res.responseTime: lt 1000
}
