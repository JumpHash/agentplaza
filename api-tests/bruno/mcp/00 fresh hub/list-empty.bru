meta {
  name: List the MCP servers on an empty hub
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/mcp/servers
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the list is an empty array", function () {
    const body = res.getBody();
    expect(body).to.be.an("array");
    expect(body.length).to.equal(0);
  });
}
