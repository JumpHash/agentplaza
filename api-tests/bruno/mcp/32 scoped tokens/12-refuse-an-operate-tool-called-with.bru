meta {
  name: Refuse an operate tool called with the observe token
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{mcp_observe_token}}
  Mcp-Session-Id: {{mcp_observe_session}}
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 4,
    "method": "tools/call",
    "params": {
      "name": "create_task",
      "arguments": {}
    }
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the wrong-scope call is refused as an unknown tool", function () {
    const error = res.getBody().error;
    expect(error.code).to.equal(-32602);
    expect(error.message).to.equal("unknown tool: create_task");
  });
}
