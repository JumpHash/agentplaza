meta {
  name: Refuse a call with an unknown session
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/mcp
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{mcp_observe_token}}
  Mcp-Session-Id: sess_bru_nope
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 8,
    "method": "tools/list",
    "params": {}
  }
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt 1000
}
