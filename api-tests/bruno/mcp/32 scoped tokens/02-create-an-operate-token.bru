meta {
  name: Create an operate token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/hub-mcp/tokens
  body: json
  auth: none
}

body:json {
  {
    "name": "bru operate",
    "scope": "operate"
  }
}

assert {
  res.status: eq 201
  res.body.token: isString
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("mcp_operate_token", res.getBody().token);
  bru.setVar("mcp_operate_id", res.getBody().record.id);
}

tests {
  test("the record names the operate scope", function () {
    expect(res.getBody().record.scope).to.equal("operate");
  });
}
