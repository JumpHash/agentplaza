meta {
  name: Create an observe token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/hub-mcp/tokens
  body: json
  auth: none
}

body:json {
  {
    "name": "bru observe",
    "scope": "observe"
  }
}

assert {
  res.status: eq 201
  res.body.token: isString
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("mcp_observe_token", res.getBody().token);
  bru.setVar("mcp_observe_id", res.getBody().record.id);
}

tests {
  test("the token starts with its prefix and the record has no value", function () {
    const body = res.getBody();
    expect(body.token).to.match(/^apz_mcp_/);
    expect(body.record.scope).to.equal("observe");
    expect(body.record).to.not.have.property("token");
  });
}
