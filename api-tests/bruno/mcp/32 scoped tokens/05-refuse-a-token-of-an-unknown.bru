meta {
  name: Refuse a token of an unknown scope
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/hub-mcp/tokens
  body: json
  auth: none
}

body:json {
  {
    "name": "bru bad scope",
    "scope": "root"
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal names the scopes", function () {
    expect(res.getBody().error).to.equal("scope is observe, operate or govern");
  });
}
