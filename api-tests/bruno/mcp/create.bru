meta {
  name: Add an MCP server
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/mcp/servers
  body: json
  auth: none
}

body:json {
  {
    "id": "test-server",
    "name": "Test server",
    "transport": {
      "kind": "stdio",
      "image": "ghcr.io/example/server:1.0",
      "command": ["serve"]
    },
    "tools": {
      "allow": "all"
    }
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.id: eq test-server
  res.body.name: eq Test server
}

tests {
  test("the created server shows its config and a status", function () {
    const body = res.getBody();
    expect(body.transport.kind).to.equal("stdio");
    expect(body).to.have.property("status");
  });
}

script:post-response {
  bru.setVar("mcpId", res.getBody().id);
}
