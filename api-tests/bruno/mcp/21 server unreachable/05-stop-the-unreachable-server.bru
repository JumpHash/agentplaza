meta {
  name: Stop the unreachable server
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/mcp/servers/bru-fake-mcp/stop
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the server is stopped", function () {
    expect(res.getBody().status).to.not.equal("running");
  });
}
