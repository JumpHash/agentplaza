meta {
  name: Refuse a header whose format has no placeholder
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/mcp/servers
  body: json
  auth: none
}

body:json {
  {
    "id": "bru-bad-hdr",
    "name": "Bad header",
    "transport": {
      "kind": "http",
      "url": "http://127.0.0.1:9/mcp"
    },
    "allow_private": true,
    "headers": {
      "Authorization": {
        "secret": "BRU_MCP_TOKEN",
        "format": "Bearer"
      }
    }
  }
}

assert {
  res.status: eq 400
  res.body.field: eq headers.Authorization
  res.responseTime: lt {{budgetMs}}
}
