meta {
  name: Refuse a stdio server whose image name has spaces
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/mcp/servers
  body: json
  auth: none
}

body:json {
  {
    "id": "bru-bad-image",
    "name": "Bad image",
    "transport": {
      "kind": "stdio",
      "image": "bad image"
    }
  }
}

assert {
  res.status: eq 400
  res.body.field: eq transport.image
  res.responseTime: lt {{budgetMs}}
}
