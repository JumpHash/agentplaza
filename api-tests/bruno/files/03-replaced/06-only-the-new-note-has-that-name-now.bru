meta {
  name: Only the new note has that name now
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/files?kind=attachment
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("one file with the name, the new one", function () {
    const m = res.getBody().filter((f) => f.name === "t-files-notes.md");
    expect(m.length).to.equal(1);
    expect(m[0].id).to.equal(bru.getVar("file_note2"));
  });
}
