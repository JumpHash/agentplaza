meta {
  name: Read the picture's share data
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/artifact/{{sh_pic_share}}/data
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the file's name and type", function () {
    const f = res.getBody().file;
    expect(f.name).to.equal("t-files-pic.png");
    expect(f.content_type).to.equal("image/png");
  });
}
