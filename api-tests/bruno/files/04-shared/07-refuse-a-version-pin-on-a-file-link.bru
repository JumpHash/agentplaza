meta {
  name: Refuse a version pin on a file link
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/shares
  body: json
  auth: none
}

body:json {
  {
    "target": {
      "kind": "file",
      "id": "{{file_note2}}"
    },
    "version": 1
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
