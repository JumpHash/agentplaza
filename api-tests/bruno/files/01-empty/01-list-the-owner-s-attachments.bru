meta {
  name: List the owner's attachments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/files?kind=attachment
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("a list", function () {
    expect(res.getBody()).to.be.an("array");
  });
}
