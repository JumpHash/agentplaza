meta {
  name: Refuse an upload whose name is too long
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/v1/files?name=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.txt
  body: text
  auth: none
}

headers {
  content-type: text/plain
}

body:text {
  x
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
