meta {
  name: A name with accented letters and spaces is cleaned
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/v1/files?name=%C3%BCn%C3%AFcode%20notes.txt
  body: text
  auth: none
}

headers {
  content-type: text/plain
}

body:text {
  unicode
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("file_unicode", res.getBody().id);
}

tests {
  test("each odd character becomes an underscore", function () {
    expect(res.getBody().name).to.equal("_n_code_notes.txt");
  });
}
