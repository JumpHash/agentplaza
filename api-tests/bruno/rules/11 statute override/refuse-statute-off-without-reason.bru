meta {
  name: Refuse to switch a statute off without a reason
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/v1/laws/overrides/S-000a
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "disabled": true
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}
