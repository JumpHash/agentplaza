meta {
  name: Switch the constitutional law back on, which needs no confirmation
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/v1/laws/overrides/C-001a
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "disabled": false
  }
}

assert {
  res.status: eq 200
  res.body.override: eq null
  res.responseTime: lt {{budgetMs}}
}
