meta {
  name: List the refusals with a limit of zero: the page is clamped to one
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/laws/violations?limit=0
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body: isArray
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("at most one row", function () {
  expect(res.getBody().length).to.be.at.most(1);
  });
}
