meta {
  name: List the recorded refusals of the law, a page at a time
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/laws/violations?law=C-001a&limit=1
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body: isArray
  res.responseTime: lt 1000
}

tests {
  test("the page holds at most one refusal of that law", function () {
  const rows = res.getBody();
    expect(rows.length).to.be.at.most(1);
    rows.forEach((r) => expect(r.law).to.equal("C-001a"));
  });
}
