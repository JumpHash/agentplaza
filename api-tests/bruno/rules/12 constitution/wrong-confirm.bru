meta {
  name: Refuse a confirmation that names another law
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/v1/laws/overrides/C-001a
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "disabled": true,
    "reason": "Bruno suite",
    "confirm": "C-001b"
  }
}

assert {
  res.status: eq 409
  res.body.error: isString
  res.responseTime: lt 1000
}

tests {
  test("the refusal says the confirmation does not match", function () {
  expect(res.getBody().error).to.contain("does not match");
  });
}
