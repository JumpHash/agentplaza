meta {
  name: Rename a rule
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/laws/rules/{{ruleId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Renamed by the API suite"
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.title: eq "Renamed by the API suite"
}
