meta {
  name: Make the artifact t-looks share 05 as an agent
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/internal/v1/agents/5/gateway/artifacts
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "spec": {
      "title": "t-looks share 05",
      "panels": [
        {
          "id": "sales",
          "title": "Sales",
          "span": 6,
          "body": {
            "type": "dataset",
            "columns": [
              {
                "key": "region",
                "label": "Region"
              },
              {
                "key": "total",
                "label": "Total",
                "kind": "number"
              }
            ],
            "rows": [
              [
                "north",
                12
              ],
              [
                "south",
                9
              ]
            ],
            "total": 2
          }
        },
        {
          "id": "trend",
          "title": "Trend",
          "span": 6,
          "body": {
            "type": "chart",
            "unit": "count",
            "height": 200,
            "x": {
              "type": "labels",
              "labels": [
                "mon",
                "tue",
                "wed"
              ]
            },
            "series": [
              {
                "name": "orders",
                "tone": "chart-1",
                "values": [
                  3,
                  5,
                  4
                ]
              }
            ]
          }
        }
      ]
    }
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("sh5_art", res.getBody().id);
}

tests {
  test("the agent gets the id, version 1 and its author", function () {
    const b = res.getBody();
    expect(b.id).to.be.a("string");
    expect(b.version).to.equal(1);
    expect(b.title).to.equal("t-looks share 05");
    expect(b.ref).to.equal("artifact:" + b.id);
  });
}
