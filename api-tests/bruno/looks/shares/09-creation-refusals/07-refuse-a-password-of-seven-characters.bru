meta {
  name: Refuse a password of seven characters
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/shares
  body: json
  auth: none
}

body:json {
  {
    "target": {
      "kind": "artifact",
      "id": "{{sh9_art}}"
    },
    "password": "1234567"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
