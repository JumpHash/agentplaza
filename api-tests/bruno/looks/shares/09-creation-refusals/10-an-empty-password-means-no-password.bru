meta {
  name: An empty password means no password
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/shares
  body: json
  auth: none
}

body:json {
  {
    "target": {
      "kind": "artifact",
      "id": "{{sh9_art}}"
    },
    "password": ""
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("sh9_empty", res.getBody().id);
}

tests {
  test("no password is set", function () {
    expect(res.getBody().has_password).to.equal(false);
  });
}
