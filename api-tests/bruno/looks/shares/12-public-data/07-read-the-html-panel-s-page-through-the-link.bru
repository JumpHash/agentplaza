meta {
  name: Read the HTML panel's page through the link
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/artifact/{{sh12_share}}/frame/page/index.html
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the page is HTML and sandboxed", function () {
    expect(res.getHeader("content-type")).to.include("text/html");
    expect(String(res.getBody())).to.include("Hello from the frame");
    expect(res.getHeader("content-security-policy")).to.include("sandbox");
  });
}
