meta {
  name: Make the artifact t-looks share 12 as an agent
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/internal/v1/agents/5/gateway/artifacts
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "spec": {
      "title": "t-looks share 12",
      "panels": [
        {
          "id": "picture",
          "title": "Picture",
          "span": 6,
          "body": {
            "type": "image",
            "alt": "A small dot",
            "blob": {
              "id": "{{sh12_blob}}",
              "content_type": "image/png",
              "bytes": 22
            }
          }
        },
        {
          "id": "page",
          "title": "Frame",
          "span": 6,
          "body": {
            "type": "html",
            "entry": "index.html",
            "height": 200,
            "files": [
              {
                "path": "index.html",
                "text": "<!doctype html><p>Hello from the frame</p>"
              }
            ]
          }
        },
        {
          "id": "words",
          "title": "Notes",
          "span": 12,
          "body": {
            "type": "document",
            "markdown": "A note the test wrote."
          }
        }
      ]
    }
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("sh12_art", res.getBody().id);
}

tests {
  test("the agent gets the id, version 1 and its author", function () {
    const b = res.getBody();
    expect(b.id).to.be.a("string");
    expect(b.version).to.equal(1);
    expect(b.title).to.equal("t-looks share 12");
    expect(b.ref).to.equal("artifact:" + b.id);
  });
}
