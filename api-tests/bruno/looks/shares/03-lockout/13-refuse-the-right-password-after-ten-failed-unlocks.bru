meta {
  name: Refuse the right password after ten failed unlocks
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/artifact/{{sh3_share}}/unlock
  body: json
  auth: none
}

body:json {
  {
    "password": "lockout pass"
  }
}

assert {
  res.status: eq 429
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal says to try later", function () {
    expect(res.getBody().error).to.include("too many attempts");
  });
}
