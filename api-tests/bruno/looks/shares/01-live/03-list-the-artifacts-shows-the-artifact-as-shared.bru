meta {
  name: List the artifacts shows the artifact as shared
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/artifacts?q=t-looks%20share%2001
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the artifact row says it is shared", function () {
    const row = res.getBody().find((a) => a.id === bru.getVar("sh1_art"));
    expect(row, "row").to.not.be.undefined;
    expect(row.shared).to.equal(true);
  });
}
