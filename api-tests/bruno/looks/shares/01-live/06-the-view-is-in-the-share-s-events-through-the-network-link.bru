meta {
  name: The view is in the share's events, through the network link
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/shares/{{sh1_share}}/events
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the first event is a view made over the network", function () {
    const b = res.getBody();
    expect(b[0].kind).to.equal("view");
    expect(b[0].via).to.equal("network");
  });
}
