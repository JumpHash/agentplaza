meta {
  name: The link serves version 1 again
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/artifact/{{sh4_share}}/data
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("version 1", function () {
    expect(res.getBody().artifact.version).to.equal(1);
  });
}
