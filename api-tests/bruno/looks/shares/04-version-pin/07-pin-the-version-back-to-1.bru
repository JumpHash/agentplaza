meta {
  name: Pin the version back to 1
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/v1/shares/{{sh4_share}}
  body: json
  auth: none
}

body:json {
  {
    "version": 1
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("pinned to 1 again", function () {
    expect(res.getBody().version).to.equal(1);
  });
}
