meta {
  name: Create a share pinned to version 1
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/shares
  body: json
  auth: none
}

body:json {
  {
    "target": {
      "kind": "artifact",
      "id": "{{sh4_art}}"
    },
    "version": 1
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("sh4_share", res.getBody().id);
}

tests {
  test("the share pins version 1", function () {
    expect(res.getBody().version).to.equal(1);
  });
}
