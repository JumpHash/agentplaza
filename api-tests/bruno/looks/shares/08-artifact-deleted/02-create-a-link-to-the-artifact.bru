meta {
  name: Create a link to the artifact
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/shares
  body: json
  auth: none
}

body:json {
  {
    "target": {
      "kind": "artifact",
      "id": "{{sh8_art}}"
    }
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("sh8_share", res.getBody().id);
}
