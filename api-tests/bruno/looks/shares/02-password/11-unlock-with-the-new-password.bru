meta {
  name: Unlock with the new password
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/artifact/{{sh2_share}}/unlock
  body: json
  auth: none
}

body:json {
  {
    "password": "another pass"
  }
}

assert {
  res.status: eq 204
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  const raw = res.getHeader("set-cookie");
  const first = Array.isArray(raw) ? raw[0] : String(raw || "");
  bru.setVar("sh2_cookie", first.split(";")[0]);
}
