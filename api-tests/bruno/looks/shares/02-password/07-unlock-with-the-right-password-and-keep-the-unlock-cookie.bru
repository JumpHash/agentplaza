meta {
  name: Unlock with the right password and keep the unlock cookie
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/artifact/{{sh2_share}}/unlock
  body: json
  auth: none
}

body:json {
  {
    "password": "correct horse"
  }
}

assert {
  res.status: eq 204
  res.responseTime: lt 1000
}

script:post-response {
  const raw = res.getHeader("set-cookie");
  const first = Array.isArray(raw) ? raw[0] : String(raw || "");
  bru.setVar("sh2_cookie", first.split(";")[0]);
}

tests {
  test("the unlock sets a cookie for this share only", function () {
    expect(bru.getVar("sh2_cookie")).to.match(/^apz_share_[0-9a-f]{32}=/);
  });
}
