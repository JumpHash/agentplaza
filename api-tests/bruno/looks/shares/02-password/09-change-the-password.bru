meta {
  name: Change the password
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/v1/shares/{{sh2_share}}
  body: json
  auth: none
}

body:json {
  {
    "password": "another pass"
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the share still has a password", function () {
    expect(res.getBody().has_password).to.equal(true);
  });
}
