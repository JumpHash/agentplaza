meta {
  name: Read the share without a password or cookie
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/artifact/{{sh2_share}}/data
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("it is open", function () {
    expect(res.getBody().artifact.id).to.equal(bru.getVar("sh2_art"));
  });
}
