meta {
  name: Read a password-protected share without unlocking it
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/artifact/{{sh2_share}}/data
  body: none
  auth: none
}

assert {
  res.status: eq 401
  res.responseTime: lt 1000
}

tests {
  test("it asks for the password", function () {
    expect(res.getBody().needs_password).to.equal(true);
  });
}
