meta {
  name: Clear the password
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/v1/shares/{{sh2_share}}
  body: json
  auth: none
}

body:json {
  {
    "password": null
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("no password any more", function () {
    expect(res.getBody().has_password).to.equal(false);
  });
}
