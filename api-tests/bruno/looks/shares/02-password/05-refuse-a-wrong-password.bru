meta {
  name: Refuse a wrong password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/artifact/{{sh2_share}}/unlock
  body: json
  auth: none
}

body:json {
  {
    "password": "wrong password"
  }
}

assert {
  res.status: eq 403
  res.responseTime: lt 1000
}

tests {
  test("the refusal says wrong password", function () {
    expect(res.getBody().error).to.equal("wrong password");
  });
}
