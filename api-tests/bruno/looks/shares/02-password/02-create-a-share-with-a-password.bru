meta {
  name: Create a share with a password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/shares
  body: json
  auth: none
}

body:json {
  {
    "target": {
      "kind": "artifact",
      "id": "{{sh2_art}}"
    },
    "password": "correct horse"
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("sh2_share", res.getBody().id);
}

tests {
  test("the share reports a password but never shows it", function () {
    const text = JSON.stringify(res.getBody());
    expect(res.getBody().has_password).to.equal(true);
    expect(text).to.not.include("correct horse");
    expect(res.getBody()).to.not.have.property("password_hash");
  });
}
