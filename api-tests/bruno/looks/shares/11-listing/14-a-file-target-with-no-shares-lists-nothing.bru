meta {
  name: A file target with no shares lists nothing
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/v1/shares?target=file:fnope
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("empty", function () {
    expect(res.getBody()).to.deep.equal([]);
  });
}
