meta {
  name: Refuse a new version whose panels are empty
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/internal/v1/agents/5/gateway/artifacts/{{looks_art}}
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "spec": {
      "title": "t-looks Notes",
      "panels": []
    }
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
