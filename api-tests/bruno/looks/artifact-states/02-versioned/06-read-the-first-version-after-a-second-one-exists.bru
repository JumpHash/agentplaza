meta {
  name: Read the first version after a second one exists
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/v1/artifacts/{{looks_art}}?v=1
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("version 1 keeps its own panel and the latest is 2", function () {
    const b = res.getBody();
    expect(b.version).to.equal(1);
    expect(b.latest).to.equal(2);
    expect(b.panels[0].body.markdown).to.equal("A note the test wrote.");
  });
}
