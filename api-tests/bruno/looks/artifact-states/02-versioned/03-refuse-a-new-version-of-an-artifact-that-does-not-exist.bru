meta {
  name: Refuse a new version of an artifact that does not exist
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/internal/v1/agents/5/gateway/artifacts/aunknownid00
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "spec": {
      "title": "t-looks Notes",
      "panels": [
        {
          "id": "notes",
          "title": "Notes",
          "span": 12,
          "body": {
            "type": "document",
            "markdown": "A note the test wrote."
          }
        }
      ]
    }
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
