meta {
  name: Refuse a new version with no spec
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/internal/v1/agents/5/gateway/artifacts/{{looks_art}}
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "nope": 1
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
