meta {
  name: List the versions oldest first
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/artifacts/{{looks_art}}/versions
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("two versions, oldest first", function () {
    const b = res.getBody();
    expect(b.length).to.equal(2);
    expect(b[0].version).to.equal(1);
    expect(b[1].version).to.equal(2);
  });
}
