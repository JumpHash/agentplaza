meta {
  name: The agent cannot read its deleted artifact
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/internal/v1/agents/5/gateway/artifacts/{{looks_art}}
  body: none
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
