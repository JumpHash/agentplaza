meta {
  name: Read one page of the dataset's rows
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/artifacts/{{looks_art}}/rows?panel=sales&limit=1
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("one row of two, with the total", function () {
    const b = res.getBody();
    expect(b.rows.length).to.equal(1);
    expect(b.total).to.equal(2);
    expect(b.columns.length).to.equal(2);
  });
}
