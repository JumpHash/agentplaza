meta {
  name: Export the dataset panel as CSV
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/v1/artifacts/{{looks_art}}/export?format=csv&panel=sales
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the CSV has the rows and an attachment name", function () {
    expect(String(res.getBody())).to.include("north");
    expect(res.getHeader("content-disposition")).to.include("attachment");
    expect(res.getHeader("content-disposition")).to.include(".csv");
  });
}
