meta {
  name: Sort and filter the dataset's rows
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/artifacts/{{looks_art}}/rows?panel=sales&sort=total&desc=1&filter=north
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("only the north row is left", function () {
    const b = res.getBody();
    expect(b.rows.length).to.equal(1);
    expect(b.rows[0][0]).to.equal("north");
  });
}
