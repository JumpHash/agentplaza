meta {
  name: Refuse an artifact body that is not JSON
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/internal/v1/agents/5/gateway/artifacts
  body: text
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
  content-type: application/json
}

body:text {
  this is not json
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
