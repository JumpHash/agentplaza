meta {
  name: Refuse an agent's artifact from a cid that is not a number
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/internal/v1/agents/abc/gateway/artifacts
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "spec": {
      "title": "t-looks Notes",
      "panels": [
        {
          "id": "notes",
          "title": "Notes",
          "span": 12,
          "body": {
            "type": "document",
            "markdown": "A note the test wrote."
          }
        }
      ]
    },
    "project": "t-looks"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
