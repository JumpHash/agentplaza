meta {
  name: Refuse an agent's artifact without the internal token
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/internal/v1/agents/5/gateway/artifacts
  body: json
  auth: none
}

body:json {
  {
    "spec": {
      "title": "t-looks Notes",
      "panels": [
        {
          "id": "notes",
          "title": "Notes",
          "span": 12,
          "body": {
            "type": "document",
            "markdown": "A note the test wrote."
          }
        }
      ]
    },
    "project": "t-looks"
  }
}

assert {
  res.status: eq 403
  res.responseTime: lt {{budgetMs}}
}
