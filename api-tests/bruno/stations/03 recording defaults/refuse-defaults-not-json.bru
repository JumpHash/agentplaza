meta {
  name: Refuse recording defaults whose body does not parse
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/v1/stations/recording-defaults
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"record": }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}
