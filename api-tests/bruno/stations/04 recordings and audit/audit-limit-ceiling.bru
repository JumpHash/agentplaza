meta {
  name: List the audit with a limit over the ceiling
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v1/stations/audit?limit=5000
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body: isArray
}

tests {
  test("the audit is capped at 1000 rows", function () {
    expect(res.getBody().length).to.be.at.most(1000);
  });
}
