meta {
  name: List the audit newest first
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/v1/stations/audit?limit=50
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body: isArray
}

tests {
  test("the rows are ordered by time, newest first", function () {
    const at = res.getBody().map((r) => r.at_ms);
    for (let i = 1; i < at.length; i++) {
      expect(at[i]).to.be.at.most(at[i - 1]);
    }
  });
}
