meta {
  name: Answer 404 for a recording that does not exist
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/stations/recordings/r0-t-missing
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no such recording");
  });
}
