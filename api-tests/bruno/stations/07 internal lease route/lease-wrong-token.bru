meta {
  name: Refuse an agent's lease with a wrong internal token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/internal/v1/agents/1/stations/w-t-missing/leases
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-apz-internal: t-stations-wrong
}

body:json {
  {
    "kind": "shared"
  }
}

assert {
  res.status: eq 403
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("internal token");
  });
}
