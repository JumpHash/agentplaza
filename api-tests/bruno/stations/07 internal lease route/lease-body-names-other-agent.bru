meta {
  name: Refuse an agent's lease whose body names another agent
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/internal/v1/agents/1/stations/w-t-missing/leases
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "agent": 2,
    "kind": "shared"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("not the agent in the path");
  });
}
