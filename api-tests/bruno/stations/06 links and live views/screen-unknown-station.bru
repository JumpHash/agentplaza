meta {
  name: Answer 404 for the live screen of a workstation that does not exist
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/stations/w-t-missing/screen?session=shared
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no such workstation");
  });
}
