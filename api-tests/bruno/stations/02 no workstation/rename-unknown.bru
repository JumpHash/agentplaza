meta {
  name: Answer 404 to a rename of a workstation that does not exist
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/v1/stations/w-t-missing
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Lab bench ワーク"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}
