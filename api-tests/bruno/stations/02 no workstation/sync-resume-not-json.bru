meta {
  name: Refuse a sync resume whose body does not parse
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/v1/stations/w-t-missing/sync/resume
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"apply_deletions": }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}
