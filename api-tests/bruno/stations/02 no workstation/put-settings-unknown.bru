meta {
  name: Answer 404 to saving settings for a workstation that does not exist
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/v1/stations/w-t-missing/settings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "record_fps": 2
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}
