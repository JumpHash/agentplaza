meta {
  name: Answer 404 to a lease on a workstation that does not exist
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/v1/stations/w-t-missing/leases
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "agent": 1,
    "kind": "shared",
    "task": "t-stations-lease"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}
