meta {
  name: Refuse a workstation VM with less RAM than a Linux VM needs
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/stations/vms
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "node": "n0",
    "os": "linux",
    "name": "t-stations-vm",
    "cpus": 2,
    "ram_mb": 2047,
    "disk_gb": 16
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("ram_mb");
  });
}
