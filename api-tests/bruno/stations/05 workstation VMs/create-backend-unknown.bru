meta {
  name: Refuse a workstation VM backend that is not auto, plaza or qemu
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/v1/stations/vms
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "node": "n0",
    "os": "linux",
    "name": "t-stations-vm",
    "cpus": 2,
    "ram_mb": 4096,
    "disk_gb": 16,
    "backend": "vmware"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("backend must be");
  });
}
