meta {
  name: Answer 404 to sleeping a workstation VM that does not exist
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/v1/stations/vms/wv-t-missing/sleep
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("no workstation VM");
  });
}
