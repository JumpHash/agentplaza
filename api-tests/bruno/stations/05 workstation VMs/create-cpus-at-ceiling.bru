meta {
  name: Pass the CPU ceiling and fail only at noded, which is absent
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/stations/vms
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "node": "n0",
    "os": "linux",
    "name": "t-stations-vm",
    "cpus": 16,
    "ram_mb": 4096,
    "disk_gb": 16
  }
}

assert {
  res.status: eq 502
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("unreachable");
  });
}
