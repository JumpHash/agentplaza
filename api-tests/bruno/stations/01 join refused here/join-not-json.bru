meta {
  name: Answer 400 to a workstation join whose body does not parse
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/stations/join
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"code": }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}
