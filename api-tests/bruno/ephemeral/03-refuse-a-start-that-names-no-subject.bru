meta {
  name: Refuse a start that names no subject
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/ephemeral
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"environment": "probe-env"}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
