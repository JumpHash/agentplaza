meta {
  name: Refuse an instance of an environment that is not ephemeral
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/projects/{{life_pid}}/ephemeral
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"environment": "probe-env", "subject": {"lane": "ch-probe"}}
}

assert {
  res.status: eq 409
  res.responseTime: lt {{budgetMs}}
}
