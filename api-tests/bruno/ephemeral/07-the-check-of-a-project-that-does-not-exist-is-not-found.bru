meta {
  name: Check a project that does not exist is not found
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/projects/no-such-project/ephemeral/against
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"environment": "probe-env", "subject": {"lane": "ch-1"}}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
