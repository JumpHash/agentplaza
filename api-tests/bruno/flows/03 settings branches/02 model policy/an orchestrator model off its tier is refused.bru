meta {
  name: an orchestrator model off its tier is refused
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/v1/settings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

script:pre-request {
  const s = JSON.parse(bru.getVar("flowSettingsCurrent"));
  s.orchestrator_model = "deepseek/deepseek-flash";
  req.setBody(s);
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("flowSettingsCurrent", JSON.stringify(res.getBody()));
  }
}

tests {
  test("the refusal names the tier and the allowed list", function () {
    expect(res.getBody().error).to.include('not allowed for the orchestrator tier');
    expect(res.getBody().error).to.include('anthropic/claude-opus-5-5');
  });
}
