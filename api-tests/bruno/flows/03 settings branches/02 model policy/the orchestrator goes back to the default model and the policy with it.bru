meta {
  name: the orchestrator goes back to the default model and the policy with it
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/v1/settings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

script:pre-request {
  const s = JSON.parse(bru.getVar("flowSettingsCurrent"));
  s.orchestrator_model = "anthropic/claude-opus-5-5";
  s.model_policy.orchestrator = s.model_policy.orchestrator.filter((m) => m !== "deepseek/deepseek-flash");
  s.role_models = {};
  req.setBody(s);
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("flowSettingsCurrent", JSON.stringify(res.getBody()));
  }
}

tests {
  test("the default orchestrator is back and the list has its four", function () {
    expect(res.getBody().orchestrator_model).to.equal('anthropic/claude-opus-5-5');
    expect(res.getBody().model_policy.orchestrator.length).to.equal(4);
    expect(res.getBody().role_models).to.deep.equal({});
  });
}
