meta {
  name: a model in use cannot be dropped from the orchestrator list
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/v1/settings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

script:pre-request {
  const s = JSON.parse(bru.getVar("flowSettingsCurrent"));
  s.model_policy.orchestrator = s.model_policy.orchestrator.filter((m) => m !== "deepseek/deepseek-flash");
  req.setBody(s);
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("flowSettingsCurrent", JSON.stringify(res.getBody()));
  }
}

tests {
  test("the refusal names the tier", function () {
    expect(res.getBody().error).to.include('not allowed for the orchestrator tier');
  });
}
