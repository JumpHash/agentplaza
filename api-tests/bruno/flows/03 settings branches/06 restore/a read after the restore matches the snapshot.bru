meta {
  name: a read after the restore matches the snapshot
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/settings
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the read agrees with the snapshot", function () {
    const s = JSON.parse(bru.getVar('flowSettingsSnapshot'));
    expect(res.getBody().max_turns).to.equal(s.max_turns);
    expect(res.getBody().health_interval_s).to.equal(s.health_interval_s);
  });
}
