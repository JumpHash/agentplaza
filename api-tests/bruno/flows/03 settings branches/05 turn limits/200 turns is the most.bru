meta {
  name: 200 turns is the most
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/v1/settings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

script:pre-request {
  const s = JSON.parse(bru.getVar("flowSettingsCurrent"));
  s.max_turns = 200;
  req.setBody(s);
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("flowSettingsCurrent", JSON.stringify(res.getBody()));
  }
}

tests {
  test("200 kept", function () {
    expect(res.getBody().max_turns).to.equal(200);
  });
}
