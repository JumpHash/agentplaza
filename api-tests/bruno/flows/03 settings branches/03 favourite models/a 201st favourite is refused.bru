meta {
  name: a 201st favourite is refused
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/v1/settings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

script:pre-request {
  const s = JSON.parse(bru.getVar("flowSettingsCurrent"));
  s.favourite_models = Array.from({ length: 201 }, (_, i) => "flows/model" + i);
  req.setBody(s);
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("flowSettingsCurrent", JSON.stringify(res.getBody()));
  }
}

tests {
  test("the refusal names the limit", function () {
    expect(res.getBody().error).to.include('at most 200');
  });
}
