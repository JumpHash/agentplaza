meta {
  name: a duplicate favourite is refused
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/v1/settings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

script:pre-request {
  const s = JSON.parse(bru.getVar("flowSettingsCurrent"));
  s.favourite_models = ["anthropic/claude-sonnet-5-5", "anthropic/claude-sonnet-5-5"];
  req.setBody(s);
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("flowSettingsCurrent", JSON.stringify(res.getBody()));
  }
}

tests {
  test("the refusal names the duplicate", function () {
    expect(res.getBody().error).to.include('listed twice');
  });
}
