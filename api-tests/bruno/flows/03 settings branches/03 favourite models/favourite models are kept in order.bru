meta {
  name: favourite models are kept in order
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/v1/settings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

script:pre-request {
  const s = JSON.parse(bru.getVar("flowSettingsCurrent"));
  s.favourite_models = ["anthropic/claude-sonnet-5-5", "openai/gpt-6-luna"];
  req.setBody(s);
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("flowSettingsCurrent", JSON.stringify(res.getBody()));
  }
}

tests {
  test("both are kept in the order given", function () {
    expect(res.getBody().favourite_models).to.deep.equal(['anthropic/claude-sonnet-5-5', 'openai/gpt-6-luna']);
  });
}
