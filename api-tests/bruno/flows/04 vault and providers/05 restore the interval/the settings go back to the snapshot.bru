meta {
  name: the settings go back to the snapshot
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/v1/settings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

script:pre-request {
  req.setBody(JSON.parse(bru.getVar("flowVaultSettingsSnapshot")));
}

tests {
  test("the interval is what it was before the folder", function () {
    const s = JSON.parse(bru.getVar("flowVaultSettingsSnapshot"));
    expect(res.getBody().health_interval_s).to.equal(s.health_interval_s);
  });
}
