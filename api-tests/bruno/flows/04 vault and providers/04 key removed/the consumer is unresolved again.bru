meta {
  name: the consumer is unresolved again
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/vault/consumers
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the anthropic binding has no key", function () {
    const c = res.getBody().find((x) => x.binding === 'provider:anthropic');
    expect(c, 'anthropic consumer').to.not.be.undefined;
    expect(c.per_node.n0).to.equal('missing');
  });
}
