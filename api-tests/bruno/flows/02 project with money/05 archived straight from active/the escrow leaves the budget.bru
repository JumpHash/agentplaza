meta {
  name: the escrow leaves the budget
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/projects/{{flowActivePid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("400 left", function () {
    expect(res.getBody().balance).to.equal(400);
    expect(res.getBody().plaza).to.equal(Number(bru.getVar('flowActivePlazaBefore')) - 900);
  });
}
