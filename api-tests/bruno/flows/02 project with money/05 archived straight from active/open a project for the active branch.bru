meta {
  name: open a project for the active branch
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "flows active archive",
    "goal": "Archived while still in build"
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("flowActivePid", res.getBody().id);
}
