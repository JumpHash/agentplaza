meta {
  name: open a project for the small budget
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "flows small budget",
    "goal": "A budget that cannot fund every task"
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("flowSmallPid", res.getBody().id);
}
