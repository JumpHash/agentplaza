meta {
  name: the plaza budget is whole after the small-budget archive
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/v1/treasury
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the plaza budget is what it was before", function () {
    expect(res.getBody().plaza_budget).to.equal(Number(bru.getVar('flowSmallPlazaBefore')));
  });
}
