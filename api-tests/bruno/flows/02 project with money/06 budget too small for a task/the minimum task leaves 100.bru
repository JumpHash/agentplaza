meta {
  name: the minimum task leaves 100
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/v1/projects/{{flowSmallPid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("100 left", function () {
    expect(res.getBody().balance).to.equal(100);
    expect(res.getBody().plaza).to.equal(Number(bru.getVar('flowSmallPlazaBefore')) - 300);
  });
}
