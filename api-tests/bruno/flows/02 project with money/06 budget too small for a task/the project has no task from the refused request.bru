meta {
  name: the project has no task from the refused request
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/projects/{{flowSmallPid}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("no tasks on the project", function () {
    expect(res.getBody().tasks).to.deep.equal([]);
  });
}
