meta {
  name: a task of exactly the minimum is accepted
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "goal": "flows minimum task",
    "project": "{{flowSmallPid}}",
    "budget": 200
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("flowSmallT1", res.getBody().id);
}
