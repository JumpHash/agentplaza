meta {
  name: a task the budget cannot fund is refused
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "goal": "flows unfundable task",
    "project": "{{flowSmallPid}}",
    "budget": 1000
  }
}

tests {
  test("it is refused, not created (the hub answers 500 today, a 409 is expected)", function () {
    expect(res.status).to.not.equal(201);
    expect(res.status).to.be.at.least(400);
  });
}
