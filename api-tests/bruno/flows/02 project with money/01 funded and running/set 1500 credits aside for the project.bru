meta {
  name: set 1500 credits aside for the project
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/projects/{{flowMoneyPid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "credits": 1500
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the project holds 1500 and the plaza gave them up", function () {
    expect(res.getBody().balance).to.equal(1500);
    expect(res.getBody().plaza).to.equal(Number(bru.getVar('flowMoneyPlazaBefore')) - 1500);
  });
}
