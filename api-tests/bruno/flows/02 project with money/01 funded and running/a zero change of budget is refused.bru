meta {
  name: a zero change of budget is refused
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/projects/{{flowMoneyPid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "credits": 0
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal names the zero", function () {
    expect(res.getBody().error).to.include('credits is not 0');
  });
}
