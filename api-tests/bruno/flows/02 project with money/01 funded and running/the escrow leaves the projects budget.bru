meta {
  name: the escrow leaves the project's budget
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/projects/{{flowMoneyPid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("1500 less the 400 escrowed", function () {
    expect(res.getBody().balance).to.equal(1100);
    expect(res.getBody().plaza).to.equal(Number(bru.getVar('flowMoneyPlazaBefore')) - 1500);
  });
}
