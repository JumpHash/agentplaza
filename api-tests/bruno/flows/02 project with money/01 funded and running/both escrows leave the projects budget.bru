meta {
  name: both escrows leave the project's budget
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/v1/projects/{{flowMoneyPid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("800 left after both tasks", function () {
    expect(res.getBody().balance).to.equal(800);
    expect(res.getBody().plaza).to.equal(Number(bru.getVar('flowMoneyPlazaBefore')) - 1500);
  });
}
