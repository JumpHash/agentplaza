meta {
  name: a new project has no budget of its own
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/projects/{{flowMoneyPid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("no budget of its own yet: no cap, nothing spent", function () {
    expect(res.getBody().cap).to.equal(null);
    expect(res.getBody().spent).to.equal(0);
  });
}
