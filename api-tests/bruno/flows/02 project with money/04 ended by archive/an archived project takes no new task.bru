meta {
  name: an archived project takes no new task
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "goal": "flows task after archive",
    "project": "{{flowMoneyPid}}"
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("it says the project takes no new tasks", function () {
    expect(res.getBody().error).to.include('takes no new tasks');
  });
}
