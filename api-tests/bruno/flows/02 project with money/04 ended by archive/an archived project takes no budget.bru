meta {
  name: an archived project takes no budget
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/projects/{{flowMoneyPid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "credits": 10
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
}

tests {
  test("it says the budget went back", function () {
    expect(res.getBody().error).to.include('went back to the plaza');
  });
}
