meta {
  name: a sweep with no one to watch the project is refused
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/projects/{{flowMoneyPid}}/maintenance/sweep
  body: none
  auth: none
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
}

tests {
  test("the refusal is the missing watcher", function () {
    expect(res.getBody().error).to.include('no agents to watch it');
  });
}
