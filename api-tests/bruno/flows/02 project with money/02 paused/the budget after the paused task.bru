meta {
  name: the budget after the paused task
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/projects/{{flowMoneyPid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("700 left", function () {
    expect(res.getBody().balance).to.equal(700);
    expect(res.getBody().plaza).to.equal(Number(bru.getVar('flowMoneyPlazaBefore')) - 1600);
  });
}
