meta {
  name: move the project to maintenance while paused
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/projects/{{flowMoneyPid}}/mode
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "mode": "maintenance"
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the mode is maintenance and the project is still paused", function () {
    expect(res.getBody().mode).to.equal('maintenance');
    expect(res.getBody().paused).to.equal(true);
  });
}
