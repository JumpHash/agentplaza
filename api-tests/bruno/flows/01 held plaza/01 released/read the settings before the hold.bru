meta {
  name: read the settings before the hold
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/settings
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

script:post-response {
  const s = res.getBody();
  delete s.dev_models;
  bru.setVar("flowHeldSettings", JSON.stringify(s));
}
