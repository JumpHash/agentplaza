meta {
  name: read the plaza budget before the hold
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/treasury
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("flowHeldPlazaBudget", res.getBody().plaza_budget);
}

tests {
  test("the plaza budget is a number", function () {
    expect(res.getBody().plaza_budget).to.be.a('number');
  });
}
