meta {
  name: the sandbox fails on its node, not the hold
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/e2b/sandboxes
  body: json
  auth: none
}

headers {
  X-API-Key: {{flowHeldE2bKey}}
  Content-Type: application/json
}

body:json {
  {
    "templateID": "base"
  }
}

assert {
  res.status: eq 503
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the node is unreachable, which the hold no longer causes", function () {
    expect(res.getBody().error_code).to.equal('sandbox_node_unreachable');
  });
}
