meta {
  name: resume again is harmless
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/plaza/resume
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("still released", function () {
    expect(res.getBody().paused).to.equal(false);
  });
}
