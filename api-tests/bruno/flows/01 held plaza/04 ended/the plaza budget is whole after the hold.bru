meta {
  name: the plaza budget is whole after the hold
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/treasury
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the plaza has what it had before the flow", function () {
    expect(res.getBody().plaza_budget).to.equal(Number(bru.getVar('flowHeldPlazaBudget')));
  });
}
