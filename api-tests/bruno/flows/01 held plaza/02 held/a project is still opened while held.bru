meta {
  name: a project is still opened while held
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "flows held second",
    "goal": "Opened while the plaza is held"
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("flowHeldPid2", res.getBody().id);
}
