meta {
  name: starting with a text revision is refused
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/owner/conversations/conv-flow-none/start
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"revision": "one"}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the refusal names the body", function () {
    expect(res.getBody().error).to.include('bad body');
  });
}
