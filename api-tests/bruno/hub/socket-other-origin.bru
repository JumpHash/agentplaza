meta {
  name: Refuse an event socket opened from another origin (403)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/v1/ws
  body: none
  auth: none
}

headers {
  Upgrade: websocket
  Connection: Upgrade
  Sec-WebSocket-Version: 13
  Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==
  Origin: https://elsewhere.invalid
}

assert {
  res.status: eq 403
  res.responseTime: lt {{budgetMs}}
}
