meta {
  name: Refuse an event socket that does not offer the event protocol
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v1/ws
  body: none
  auth: none
}

headers {
  Upgrade: websocket
  Connection: Upgrade
  Sec-WebSocket-Version: 13
  Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the answer names the subprotocol", function () {
    expect(res.getBody().error).to.include("subprotocol");
  });
}
