meta {
  name: Turn the editors on, keeping the other settings
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/v1/settings
  body: json
  auth: none
}

body:json {
  {}
}

script:pre-request {
  const s = JSON.parse(bru.getVar("acp_settings_saved"));
  s.acp_enabled = true;
  req.setBody(s);
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the editors are on and the rest of the settings are as they were", function () {
    expect(res.getBody().acp_enabled).to.equal(true);
  });
}
