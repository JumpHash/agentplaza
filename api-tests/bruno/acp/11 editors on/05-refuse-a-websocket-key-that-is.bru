meta {
  name: Refuse a WebSocket key that is not 16 bytes
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/acp
  body: none
  auth: none
}

headers {
  Upgrade: websocket
  Connection: Upgrade
  Sec-WebSocket-Version: 13
  Sec-WebSocket-Key: c2hvcnQ=
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}
