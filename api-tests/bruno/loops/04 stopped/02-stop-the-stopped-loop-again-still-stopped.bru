meta {
  name: Stop the stopped loop again: still stopped
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/v1/loops/{{floop_a}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("still stopped", function () {
    expect(res.getBody().state).to.equal("stopped");
  });
}
