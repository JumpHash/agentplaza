meta {
  name: Stop the third loop
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/v1/loops/{{floop_c}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("stopped", function () {
    expect(res.getBody().state).to.equal("stopped");
  });
}
