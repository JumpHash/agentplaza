meta {
  name: Stop the second loop
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/v1/loops/{{floop_b}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("stopped", function () {
    expect(res.getBody().state).to.equal("stopped");
  });
}
