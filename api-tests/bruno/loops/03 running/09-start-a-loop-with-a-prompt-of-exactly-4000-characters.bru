meta {
  name: Start a loop with a prompt of exactly 4000 characters
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/loops
  body: json
  auth: none
}

body:json {
  {
    "cid": 9101,
    "prompt": "",
    "every_minutes": 1,
    "max_runs": 0
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("floop_c", res.getBody().id);
}

tests {
  test("the loop keeps the whole 4000-character prompt", function () {
    expect(res.getBody().id).to.be.a("string");
    expect(res.getBody().cid).to.equal(9101);
    expect(res.getBody().prompt.length).to.equal(4000);
  });
}
