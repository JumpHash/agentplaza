meta {
  name: No loop of an agent with no project is listed
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/loops
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("none of ours is listed", function () {
    expect(res.getBody().filter((l) => l.cid === 9101)).to.have.lengthOf(0);
  });
}