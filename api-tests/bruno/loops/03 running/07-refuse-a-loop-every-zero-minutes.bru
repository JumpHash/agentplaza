meta {
  name: Refuse a loop every zero minutes
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/loops
  body: json
  auth: none
}

body:json {
  {
    "cid": 9101,
    "prompt": "Check the build queue",
    "every_minutes": 0,
    "max_runs": 0
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error says once a minute at most", function () {
    expect(res.getBody().error).to.include("at most once a minute");
  });
}
