meta {
  name: Refuse a loop with a prompt of 4001 characters
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/loops
  body: json
  auth: none
}

body:json {
  {
    "cid": 9101,
    "prompt": "",
    "every_minutes": 1,
    "max_runs": 0
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal gives the prompt range", function () {
    expect(res.getBody().error).to.include("1 to 4000 characters");
  });
}
