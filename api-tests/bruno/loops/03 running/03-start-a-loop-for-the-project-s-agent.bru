meta {
  name: Start a loop for the project's agent
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/loops
  body: json
  auth: none
}

body:json {
  {
    "cid": 9101,
    "prompt": "Check the build queue",
    "every_minutes": 1,
    "max_runs": 0
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("floop_a", res.getBody().id);
}

tests {
  test("the loop is running with no runs yet", function () {
    const lp = res.getBody();
    expect(lp.state).to.equal("running");
    expect(lp.runs).to.equal(0);
    expect(lp.cid).to.equal(9101);
    expect(lp.every_secs).to.equal(60);
    expect(lp.by).to.equal("owner");
  });
}
