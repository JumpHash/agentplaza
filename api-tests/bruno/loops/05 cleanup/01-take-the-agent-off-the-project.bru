meta {
  name: Take the agent off the project
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/v1/projects/{{floop_project}}/members/9101
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the agent is on no project", function () {
    expect(res.getBody().project).to.be.null;
  });
}
