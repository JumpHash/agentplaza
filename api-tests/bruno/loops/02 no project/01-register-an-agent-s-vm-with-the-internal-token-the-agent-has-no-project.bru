meta {
  name: Register an agent's VM with the internal token (the agent has no project)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/internal/v1/agents/9101/hello
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "role": "",
    "vm": 1,
    "caps": []
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the agent is registered: its profile names its CID", function () {
    expect(res.getBody().profile).to.be.an("object");
    expect(res.getBody().profile.system_parts.map((part) => part.text).join("\n")).to.include("CID 9101");
  });
}
