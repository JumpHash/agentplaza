meta {
  name: No loop for the agent with no project is listed
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/loops
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the agent with no project has no loop", function () {
    expect(res.getBody().filter(l => l.cid === 9101)).to.be.empty;
  });
}
