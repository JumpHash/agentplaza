meta {
  name: A loop for an agent with no project is refused
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/loops
  body: json
  auth: none
}

body:json {
  {
    "cid": 9101,
    "prompt": "Check the queue",
    "every_minutes": 5,
    "max_runs": 0
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error says the agent has no project", function () {
    expect(res.getBody().error).to.include("has no project");
  });
}
