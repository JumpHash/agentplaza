meta {
  name: A pull request in a repo that is not a project's is missing
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/v1/ide/workspaces/repo:t-ide-nope@main/pulls
  body: json
  auth: none
}

body:json {
  {
    "title": "t-ide pull"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
