meta {
  name: Unfurl a file URL on the hub
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/unfurl?url=/v1/files/{{unf_file}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the card is ok", function () {
    expect(res.getBody().ok).to.equal(true);
  });
}
