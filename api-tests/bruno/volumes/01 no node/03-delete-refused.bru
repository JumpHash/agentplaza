meta {
  name: Refuse a volume delete while no node answers
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/v1/volumes/t-vol-data
  body: none
  auth: none
}

assert {
  res.status: eq 502
  res.responseTime: lt 1000
}

tests {
  test("the hub says the node is unreachable", function () {
    expect(res.getBody().error).to.include("unreachable");
  });
}
