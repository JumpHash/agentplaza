meta {
  name: Remove the recovery slot
  type: http
  seq: 16
}

delete {
  url: {{baseUrl}}/v1/vault/slots/{{vault_recovery_slot}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the recovery slot is gone", function () {
    expect(res.getBody().slots.some((s) => s.kind === "recovery")).to.equal(false);
  });
}
