meta {
  name: Refuse a secret read while the vault is sealed
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/vault/secrets
  body: none
  auth: none
}

assert {
  res.status: eq 503
  res.body.error: isString
  res.responseTime: lt 1000
}

tests {
  test("the refusal says the vault is sealed", function () {
    expect(res.getBody().error).to.equal("vault sealed");
  });
}
