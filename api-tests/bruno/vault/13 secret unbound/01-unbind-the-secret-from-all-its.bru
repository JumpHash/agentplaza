meta {
  name: Unbind the secret from all its consumers
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/v1/vault/secrets/{{vault_life_id}}
  body: json
  auth: none
}

body:json {
  {
    "bindings": []
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the entry has no bindings now", function () {
    expect(res.getBody().bindings).to.deep.equal([]);
  });
}
