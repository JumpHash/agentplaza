meta {
  name: Refuse a test once the secret has no binding
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/vault/secrets/{{vault_life_id}}/test
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}

tests {
  test("the refusal says there is no binding to test", function () {
    expect(res.getBody().error).to.include("no bindings to test");
  });
}
