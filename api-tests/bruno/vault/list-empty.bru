meta {
  name: List the vault's entries before any secret
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/vault/secrets
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the list is empty on a fresh scratch hub", function () {
    const body = res.getBody();
    expect(body).to.be.an("array");
    expect(body.length).to.equal(0);
  });
}
