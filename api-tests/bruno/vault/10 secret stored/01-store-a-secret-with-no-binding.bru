meta {
  name: Store a secret with no binding
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/vault/secrets
  body: json
  auth: none
}

body:json {
  {
    "name": "BRU_LIFE_KEY",
    "kind": "token",
    "label": "bru lifecycle",
    "value": "bru-life-value-0123456789",
    "scope": {
      "kind": "plaza"
    },
    "bindings": []
  }
}

assert {
  res.status: eq 200
  res.body.current: eq 1
  res.body.name: eq "BRU_LIFE_KEY"
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("vault_life_id", res.getBody().id);
}

tests {
  test("the stored entry is unbound, at version 1, with no value", function () {
    const body = res.getBody();
    expect(body.bindings).to.deep.equal([]);
    expect(body.current).to.equal(1);
    expect(body).to.not.have.property("value");
    expect(JSON.stringify(res.getBody())).to.not.include("bru-life-value-0123456789");
  });
}
