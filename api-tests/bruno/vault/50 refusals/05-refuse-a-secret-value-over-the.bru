meta {
  name: Refuse a secret value over the size limit
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/vault/secrets
  body: json
  auth: none
}

body:json {
  {
    "name": "BRU_REF_KEY",
    "kind": "api_key",
    "value": "x",
    "scope": {
      "kind": "plaza"
    }
  }
}

script:pre-request {
  req.setBody({ name: "BRU_REF_KEY", kind: "api_key", value: "x".repeat(16385), scope: { kind: "plaza" } });
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal does not echo the value", function () {
    const body = res.getBody();
    expect(body.error).to.include("too long");
    expect(JSON.stringify(body)).to.not.include("xxxxxxxxxxxxxxxx");
  });
}
