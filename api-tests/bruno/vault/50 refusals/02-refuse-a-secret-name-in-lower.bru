meta {
  name: Refuse a secret name in lower case
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/vault/secrets
  body: json
  auth: none
}

body:json {
  {
    "name": "bru_ref",
    "kind": "api_key",
    "value": "bru-ref-value-0123",
    "scope": {
      "kind": "plaza"
    }
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal says what a name is", function () {
    expect(res.getBody().error).to.include("upper case letters");
  });
}
