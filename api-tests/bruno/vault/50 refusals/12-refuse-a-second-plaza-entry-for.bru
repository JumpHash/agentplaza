meta {
  name: Refuse a second plaza entry for the same name
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/vault/secrets
  body: json
  auth: none
}

body:json {
  {
    "name": "BRU_DUP_KEY",
    "kind": "generic",
    "value": "bru-dup-other-0123",
    "scope": {
      "kind": "plaza"
    }
  }
}

assert {
  res.status: eq 409
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal says the name has one plaza entry", function () {
    expect(res.getBody().error).to.include("already has a plaza entry");
  });
}
