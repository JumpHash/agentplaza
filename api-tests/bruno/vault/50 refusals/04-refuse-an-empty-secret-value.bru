meta {
  name: Refuse an empty secret value
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/vault/secrets
  body: json
  auth: none
}

body:json {
  {
    "name": "BRU_REF_KEY",
    "kind": "api_key",
    "value": "",
    "scope": {
      "kind": "plaza"
    }
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
