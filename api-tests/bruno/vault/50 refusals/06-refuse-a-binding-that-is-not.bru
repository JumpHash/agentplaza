meta {
  name: Refuse a binding that is not one
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/vault/secrets
  body: json
  auth: none
}

body:json {
  {
    "name": "BRU_REF_KEY",
    "kind": "api_key",
    "value": "bru-ref-value-0123",
    "scope": {
      "kind": "plaza"
    },
    "bindings": [
      "bogus"
    ]
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
