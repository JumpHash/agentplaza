meta {
  name: Refuse a secret of an unknown kind
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/vault/secrets
  body: json
  auth: none
}

body:json {
  {
    "name": "BRU_REF_KEY",
    "kind": "secret",
    "value": "bru-ref-value-0123",
    "scope": {
      "kind": "plaza"
    }
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the refusal lists the kinds", function () {
    expect(res.getBody().error).to.include("is not a kind");
  });
}
