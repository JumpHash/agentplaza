meta {
  name: Roll the secret back to version 1
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/vault/secrets/{{vault_life_id}}/rollback
  body: json
  auth: none
}

body:json {
  {
    "v": 1
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("version 1 is current again", function () {
    expect(res.getBody().current).to.equal(1);
  });
}
