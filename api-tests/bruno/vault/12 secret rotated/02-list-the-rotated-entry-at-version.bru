meta {
  name: List the rotated entry at version 2
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/vault/secrets
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the list shows version 2 as current", function () {
    const entry = res.getBody().find((e) => e.id === bru.getVar("vault_life_id"));
    expect(entry.current).to.equal(2);
    expect(JSON.stringify(res.getBody())).to.not.include("bru-life-value-v2-0123456789");
  });
}
