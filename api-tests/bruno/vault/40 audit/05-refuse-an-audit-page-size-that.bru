meta {
  name: Refuse an audit page size that is not a number
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/vault/audit?limit=lots
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}

tests {
  test("the refusal names the page size", function () {
    expect(res.getBody().error).to.equal("limit must be a number");
  });
}
