meta {
  name: The list no longer shows the deleted secret
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/vault/secrets
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the deleted id is not listed", function () {
    const found = res.getBody().find((e) => e.id === bru.getVar("vault_life_id"));
    expect(found).to.be.undefined;
  });
}
