meta {
  name: List the vault's entries before any secret of the owner's
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/vault/secrets
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("a fresh scratch hub holds its Weft keys and the OpenRouter header defaults, and nothing else", function () {
    const body = res.getBody();
    expect(body).to.be.an("array");
    // Weft makes its hub key and its export signing key on first start. The hub also keeps the OpenRouter
    // provider's default header values (HTTP-Referer, X-OpenRouter-Title) in the vault, since those are literals.
    // Later requests add a Weft key per agent (WEFT_AGENT_<cid>), which is the only other name allowed here.
    const names = body.map((s) => s.name);
    const fixed = [
      "OPENROUTER_HEADER_HTTP_REFERER",
      "OPENROUTER_HEADER_X_OPENROUTER_TITLE",
      "WEFT_HUB_KEY",
      "WEFT_SIGNING_KEY",
    ];
    expect(names.filter((n) => fixed.includes(n)).sort()).to.deep.equal([...fixed].sort());
    expect(names.filter((n) => !fixed.includes(n)).every((n) => /^WEFT_AGENT_\d+$/.test(n))).to.be.true;
  });
}
