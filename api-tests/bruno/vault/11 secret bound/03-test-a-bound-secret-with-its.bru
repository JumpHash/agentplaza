meta {
  name: Test a bound secret with its first binding
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/vault/secrets/{{vault_life_id}}/test
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the check answers not ok: an MCP server or a tool has no check here", function () {
    const body = res.getBody();
    expect(body.ok).to.equal(false);
    expect(body.detail).to.be.a("string");
    expect(JSON.stringify(res.getBody())).to.not.include("bru-life-value-0123456789");
  });
}
