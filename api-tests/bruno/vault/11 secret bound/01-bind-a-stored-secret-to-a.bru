meta {
  name: Bind a stored secret to a tool and an MCP server
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/v1/vault/secrets/{{vault_life_id}}
  body: json
  auth: none
}

body:json {
  {
    "label": "bru lifecycle bound",
    "bindings": [
      "tool:bru-life",
      "mcp:bru-life-server"
    ]
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the bindings are kept sorted and the label is the new one", function () {
    const body = res.getBody();
    expect(body.bindings).to.deep.equal(["mcp:bru-life-server", "tool:bru-life"]);
    expect(body.label).to.equal("bru lifecycle bound");
    expect(body).to.not.have.property("value");
    expect(JSON.stringify(res.getBody())).to.not.include("bru-life-value-0123456789");
  });
}
