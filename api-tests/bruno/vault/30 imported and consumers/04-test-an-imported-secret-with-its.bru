meta {
  name: Test an imported secret with its bound tool
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/vault/secrets/{{vault_imp_a}}/test
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the tool has no check of its own, so the answer is not ok", function () {
    expect(res.getBody().ok).to.equal(false);
    expect(JSON.stringify(res.getBody())).to.not.include("bru-imp-a-value-0123");
  });
}
