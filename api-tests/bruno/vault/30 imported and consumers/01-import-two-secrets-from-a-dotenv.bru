meta {
  name: Import two secrets from a dotenv file
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/vault/import
  body: json
  auth: none
}

body:json {
  {
    "format": "dotenv",
    "text": "BRU_IMP_A=bru-imp-a-value-0123\nBRU_IMP_B=bru-imp-b-value-0123\nbru_lower=not-a-name\n",
    "scope": {
      "kind": "plaza"
    },
    "bindings": {
      "BRU_IMP_A": [
        "tool:bru-import"
      ]
    }
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  const b = res.getBody();
  bru.setVar("vault_imp_a", b.imported.find((i) => i.name === "BRU_IMP_A").id);
  bru.setVar("vault_imp_b", b.imported.find((i) => i.name === "BRU_IMP_B").id);
}

tests {
  test("both good names are imported, the bad and the duplicate line are skipped", function () {
    const body = res.getBody();
    const names = body.imported.map((i) => i.name).sort();
    expect(names).to.deep.equal(["BRU_IMP_A", "BRU_IMP_B"]);
    expect(body.skipped.length).to.be.at.least(1);
    expect(JSON.stringify(res.getBody())).to.not.include("bru-imp-a-value-0123");expect(JSON.stringify(res.getBody())).to.not.include("bru-imp-b-value-0123");
  });
}
