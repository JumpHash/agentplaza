meta {
  name: Refuse an accent with six characters after the #
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/v1/providers/t-prov-compat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "t-prov-compat",
    "kind": "openai-compatible",
    "label": "Scratch compatible 2",
    "accent": "#12345",
    "base_url": "https://127.0.0.1:9/v1",
    "auth": {
      "secret": "T_PROV_COMPAT_KEY"
    },
    "models": [
      "t-model-c"
    ]
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
