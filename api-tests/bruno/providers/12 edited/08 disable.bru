meta {
  name: Disable a provider: it keeps its settings and shows off
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/v1/providers/t-prov-compat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "t-prov-compat",
    "kind": "openai-compatible",
    "label": "Scratch compatible 2",
    "accent": "#ff8800",
    "base_url": "https://127.0.0.1:9/v1",
    "auth": {
      "secret": "T_PROV_COMPAT_KEY"
    },
    "models": [
      "t-model-c"
    ],
    "enabled": false
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body.enabled: eq false
  res.body.health.status: eq "off"
  res.body.credential: eq "secret"
}
