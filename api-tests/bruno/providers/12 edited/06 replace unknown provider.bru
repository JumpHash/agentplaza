meta {
  name: Answer 404 when replacing an unknown provider
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/v1/providers/no-such-provider
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "no-such-provider",
    "kind": "openai-compatible",
    "label": "Scratch compatible 2",
    "accent": "#ff8800",
    "base_url": "https://127.0.0.1:9/v1",
    "auth": {
      "secret": "T_PROV_COMPAT_KEY"
    },
    "models": [
      "t-model-c"
    ]
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
}
