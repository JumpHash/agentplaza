meta {
  name: Replace a provider's label and accent: the key slot is kept
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/v1/providers/t-prov-compat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "t-prov-compat",
    "kind": "openai-compatible",
    "label": "Scratch compatible 2",
    "accent": "#ff8800",
    "base_url": "https://127.0.0.1:9/v1",
    "auth": {
      "secret": "T_PROV_COMPAT_KEY"
    },
    "models": [
      "t-model-c"
    ]
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.label: eq "Scratch compatible 2"
  res.body.accent: eq "#ff8800"
  res.body.credential: eq "secret"
  res.body.models: isArray
}
