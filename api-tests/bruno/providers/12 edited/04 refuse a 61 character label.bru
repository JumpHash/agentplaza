meta {
  name: Refuse a label longer than 60 characters
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/providers/t-prov-compat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "t-prov-compat",
    "kind": "openai-compatible",
    "label": "Scratch compatible 2",
    "accent": "#ff8800",
    "base_url": "https://127.0.0.1:9/v1",
    "auth": {
      "secret": "T_PROV_COMPAT_KEY"
    },
    "models": [
      "t-model-c"
    ]
  }
}

script:pre-request {
  req.setBody({"id": "t-prov-compat", "kind": "openai-compatible", "label": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "accent": "#ff8800", "base_url": "https://127.0.0.1:9/v1", "auth": {"secret": "T_PROV_COMPAT_KEY"}, "models": ["t-model-c"]});
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the answer states the limit", function () {
    expect(res.getBody().error).to.include("60");
  });
}
