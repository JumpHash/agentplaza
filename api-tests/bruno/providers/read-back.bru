meta {
  name: Read the provider back
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/providers/scratch-provider
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.id: eq "scratch-provider"
  res.body.kind: eq "openai-compatible"
  res.body.models: isArray
}
