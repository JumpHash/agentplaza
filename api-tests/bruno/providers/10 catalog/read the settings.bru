meta {
  name: read the settings and keep them
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/settings
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  const s = res.getBody();
  delete s.dev_models;
  bru.setVar("provSettingsSnapshot", JSON.stringify(s));
}
