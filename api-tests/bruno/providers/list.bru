meta {
  name: List the providers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/providers
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body: isArray
}

tests {
  test("the test provider is not listed before it is created", function () {
    const ids = res.getBody().map((p) => p.id);
    expect(ids).to.not.include("scratch-provider");
  });
}
