meta {
  name: Refuse a provider body that does not parse
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/providers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": 5,
    "kind": "openai-compatible"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}
