meta {
  name: Answer 404 when setting the key of a deleted provider
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/v1/providers/t-prov-compat/secret
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "value": "scratch-test-key-0004"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
