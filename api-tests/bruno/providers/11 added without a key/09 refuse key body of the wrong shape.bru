meta {
  name: Refuse a key body without a value field
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/v1/providers/t-prov-compat/secret
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "key": "scratch-test-key-0002"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}
