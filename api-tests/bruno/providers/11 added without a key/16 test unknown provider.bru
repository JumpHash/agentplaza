meta {
  name: Answer 404 when testing an unknown provider
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/v1/providers/no-such-provider/test
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
}
