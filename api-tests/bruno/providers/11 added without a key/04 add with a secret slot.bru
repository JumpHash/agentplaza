meta {
  name: Add an OpenAI-compatible provider with a key slot and no key yet
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/providers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "t-prov-compat",
    "kind": "openai-compatible",
    "label": "Scratch compatible",
    "accent": "#5cc8ff",
    "base_url": "https://127.0.0.1:9/v1",
    "auth": {
      "secret": "T_PROV_COMPAT_KEY"
    },
    "models": [
      "t-model-a",
      "t-model-b"
    ]
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
  res.body.id: eq "t-prov-compat"
  res.body.kind: eq "openai-compatible"
  res.body.label: eq "Scratch compatible"
  res.body.accent: eq "#5cc8ff"
  res.body.enabled: eq true
  res.body.credential: eq "missing"
  res.body.health.status: eq "unknown"
  res.body.auth.secret: eq "T_PROV_COMPAT_KEY"
}

tests {
  test("the view names the key's slot and never carries a key", function () {
    expect(JSON.stringify(res.getBody())).to.not.include("scratch-test-key");
    expect(res.getBody()).to.not.have.property("secret");
  });
}
