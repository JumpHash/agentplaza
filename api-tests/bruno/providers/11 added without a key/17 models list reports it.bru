meta {
  name: The model listing reports the unreachable provider's error
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/v1/models
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 15000
}

tests {
  test("the error names the provider", function () {
    expect(res.getBody().errors.map((e) => e.provider)).to.include("t-prov-compat");
  });
}
