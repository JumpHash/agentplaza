meta {
  name: The used code names the node it made
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/nodes/codes
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("code a is used, by the joined node", function () {
    const c = res.getBody().find((x) => x.id === bru.getVar("node_code_a_id"));
    expect(c.state).to.equal("used");
    expect(c.used_by).to.equal(bru.getVar("node_joined_id"));
  });
}
