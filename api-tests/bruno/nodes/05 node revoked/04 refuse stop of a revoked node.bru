meta {
  name: Refuse to stop a revoked node (409)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/nodes/{{node_joined_id}}/stop
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
}

tests {
  test("the refusal says it is revoked", function () {
    expect(res.getBody().error).to.include("revoked");
  });
}
