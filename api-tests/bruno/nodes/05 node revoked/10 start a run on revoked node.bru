meta {
  name: Refuse a run on a revoked node (502)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/nodes/{{node_joined_id}}/runs
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 502
  res.responseTime: lt {{budgetMs}}
}
