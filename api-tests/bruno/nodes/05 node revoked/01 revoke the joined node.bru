meta {
  name: Revoke a joined node's access
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/nodes/{{node_joined_id}}/revoke
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.revoked: eq true
  res.body.online: eq false
}

tests {
  test("the answer is the node it revoked", function () {
    expect(res.getBody().id).to.equal(bru.getVar("node_joined_id"));
  });
}
