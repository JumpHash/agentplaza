meta {
  name: Refuse a rebalance whose dry_run flag is not a boolean
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/nodes/rebalance
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "dry_run": "maybe"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
