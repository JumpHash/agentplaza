meta {
  name: Issue a join code whose label is longer than 64 characters
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/nodes/codes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "label": "x",
    "ttl_minutes": 5
  }
}

script:pre-request {
  req.setBody({label: "L".repeat(100), ttl_minutes: 5});
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the new code is issued with a 64 character label", function () {
    expect(res.getBody().id).to.be.a("string");
  });
}
