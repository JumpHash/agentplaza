meta {
  name: The revoked code is listed as revoked
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/nodes/codes
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("code b is revoked and unused", function () {
    const c = res.getBody().find((x) => x.id === bru.getVar("node_code_b_id"));
    expect(c.state).to.equal("revoked");
    expect(c.used_by == null).to.equal(true);
  });
}
