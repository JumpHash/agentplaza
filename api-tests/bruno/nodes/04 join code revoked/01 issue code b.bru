meta {
  name: Issue a second join code to be revoked
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/nodes/codes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "label": "t-node-b"
  }
}

script:post-response {
  function joinSecret(token) {
    const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    const payload = token.slice("apzj1.".length);
    let bits = 0, count = 0, text = "";
    for (const ch of payload) {
      const v = alphabet.indexOf(ch);
      if (v < 0) continue;
      bits = ((bits << 6) | v) & 0xffffff;
      count += 6;
      if (count >= 8) { count -= 8; text += String.fromCharCode((bits >> count) & 0xff); }
    }
    return JSON.parse(text).s;
  }
  bru.setVar("node_code_b_id", res.getBody().id);
  bru.setVar("node_join_b_secret", joinSecret(res.getBody().token));
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
  res.body.token: isString
}
