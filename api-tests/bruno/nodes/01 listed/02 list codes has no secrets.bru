meta {
  name: List the join codes: no token or secret is ever listed
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/nodes/codes
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body: isArray
}

tests {
  test("no code carries its token or secret hash", function () {
    res.getBody().forEach((c) => { expect(c).to.not.have.property("token"); expect(c).to.not.have.property("secret_sha256"); });
  });
}
