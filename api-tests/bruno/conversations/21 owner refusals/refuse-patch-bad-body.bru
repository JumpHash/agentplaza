meta {
  name: Refuse a change whose title is not text
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/v1/owner/conversations/conv-999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": 1
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}
