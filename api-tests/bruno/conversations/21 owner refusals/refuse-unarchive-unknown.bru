meta {
  name: Answer 404 when unarchiving an unknown conversation
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/v1/owner/conversations/conv-999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "archived": false
  }
}

assert {
  res.status: eq 404
  res.body.error: isString
  res.responseTime: lt 1000
}
