meta {
  name: Refuse a title longer than 80 characters
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/v1/owner/conversations/conv-999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  }
}

assert {
  res.status: eq 400
  res.body.error: contains "at most 80"
  res.responseTime: lt {{budgetMs}}
}
