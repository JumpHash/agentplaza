meta {
  name: Refuse a start that names no revision
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/v1/owner/conversations/conv-999/start
  body: json
  auth: none
}

body:json {
  {
    "go": true
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}
