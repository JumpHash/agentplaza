meta {
  name: Answer 404 when renaming an unknown conversation
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/v1/owner/conversations/conv-999
  body: json
  auth: none
}

body:json {
  {
    "title": "Release 0.9"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}
