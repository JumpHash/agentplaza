meta {
  name: Answer 404 when starting an unknown conversation's project
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/owner/conversations/conv-999/start
  body: json
  auth: none
}

body:json {
  {
    "revision": 1
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}
