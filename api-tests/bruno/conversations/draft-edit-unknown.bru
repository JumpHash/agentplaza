meta {
  name: Answer 404 when editing an unknown conversation's draft
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/v1/owner/conversations/conv-999/draft
  body: json
  auth: none
}

body:json {
  {
    "revision": 0,
    "title": "Release 0.9",
    "goal": "Tag 0.9"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}
