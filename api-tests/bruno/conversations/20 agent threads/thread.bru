meta {
  name: Read the thread between two agents that have not spoken
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/conversations/8701/8702
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.messages: isArray
  res.responseTime: lt 1000
}

tests {
  test("the thread names both agents and is empty", function () {
  const body = res.getBody();
    expect(body.a).to.equal(8701);
    expect(body.b).to.equal(8702);
    expect(body.messages).to.be.empty;
  });
}
