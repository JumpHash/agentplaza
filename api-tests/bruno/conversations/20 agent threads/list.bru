meta {
  name: List the conversations between agents
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/conversations
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.conversations: isArray
  res.body.pairs: isArray
  res.responseTime: lt 1000
}

tests {
  test("the list is paged at 50", function () {
  expect(res.getBody().limit).to.equal(50);
  });
}
