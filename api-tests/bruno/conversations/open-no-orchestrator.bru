meta {
  name: Refuse a conversation while no orchestrator is connected
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/owner/conversations
  body: json
  auth: none
}

body:json {
  {
    "text": "The scheduler tests are flaky and I want 0.9 out this week."
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the orchestrator", function () {
    expect(res.getBody().error).to.contain("orchestrator");
  });
}
