meta {
  name: A known task nothing has reviewed lists no runs and names the task
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/tasks/{{rev_tid}}/reviews
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.task: eq {{rev_tid}}
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the task has no review runs", function () {
    expect(res.getBody().runs).to.be.an("array");
    expect(res.getBody().runs).to.have.lengthOf(0);
  });
}
