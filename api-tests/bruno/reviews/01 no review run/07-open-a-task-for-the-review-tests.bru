meta {
  name: Open a task for the review tests
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"goal": "t-reviews: a task nothing has reviewed", "budget": 200, "project": "{{rev_pid}}"}
}

assert {
  res.status: eq 201
  res.body.state: eq "open"
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("rev_tid", res.getBody().id);
}
