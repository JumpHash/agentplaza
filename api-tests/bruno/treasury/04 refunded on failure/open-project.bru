meta {
  name: Open a project for the treasury tests
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "t-treasury project",
    "goal": "Refund tests",
    "kind": "code"
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("treasuryProject", res.getBody().id);
}
