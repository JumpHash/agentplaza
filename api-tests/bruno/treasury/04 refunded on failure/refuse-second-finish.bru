meta {
  name: Refuse a second finish of the same task
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/tasks/{{treasuryTask}}/finish
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "outcome": "failed"
  }
}

assert {
  res.status: eq 409
  res.body.error: isString
  res.responseTime: lt 1000
}
