meta {
  name: List the agent wallets as cid, name and balance
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/treasury/wallets
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body: isArray
  res.responseTime: lt 1000
}

tests {
  test("each wallet names its agent and its balance", function () {
  res.getBody().forEach((w) => {
      expect(w.cid).to.be.a("number");
      expect(w.name).to.be.a("string");
      expect(w.balance).to.be.a("number");
    });
  });
}
