meta {
  name: Refuse a fine that names no memo
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/v1/treasury/fine
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cid": 8801,
    "amount": 5
  }
}

assert {
  res.status: eq 400
  res.body.error: isString
  res.responseTime: lt 1000
}
