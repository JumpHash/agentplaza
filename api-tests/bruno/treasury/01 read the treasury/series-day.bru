meta {
  name: Show the treasury over time by day
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/treasury/series?bucket=day
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.bucket_ms: eq 86400000
  res.responseTime: lt 1000
}

tests {
  test("the series has points in time order", function () {
  const body = res.getBody();
    expect(body.points).to.be.an("array");
    expect(body.from_ms).to.be.below(body.to_ms);
    body.points.forEach((p, i) => {
      if (i > 0) expect(p.at_ms).to.be.above(body.points[i - 1].at_ms);
    });
  });
}
