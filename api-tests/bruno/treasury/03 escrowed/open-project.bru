meta {
  name: Open a project for the treasury tests
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "t-treasury project",
    "goal": "Escrow tests",
    "kind": "code"
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("treasuryProject", res.getBody().id);
}

tests {
  test("the project has an id", function () {
  expect(res.getBody().id).to.match(/^pr\d+$/);
  });
}
