meta {
  name: Post a task with a budget, which escrows it
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "goal": "t-treasury task",
    "project": "{{treasuryProject}}",
    "budget": 300,
    "role": "researcher"
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("treasuryTask", res.getBody().id);
}

tests {
  test("the task is open with its budget", function () {
  expect(res.getBody().budget).to.equal(300);
    expect(res.getBody().state).to.equal("open");
  });
}

docs {
  The task is for a role the test agent does not have, so the scheduler does not hand it to the agent before
  the folder's own claim does (on a slow runner it did, and the claim met a task already claimed).
}
