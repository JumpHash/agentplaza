meta {
  name: Post a task with a budget, which escrows it
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "goal": "t-treasury done",
    "project": "{{treasuryProject}}",
    "budget": 200
  }
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("treasuryTask", res.getBody().id);
}
