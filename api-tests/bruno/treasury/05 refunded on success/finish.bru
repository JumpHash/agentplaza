meta {
  name: Finish the task as done
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/tasks/{{treasuryTask}}/finish
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "outcome": "done",
    "note": "t-treasury"
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the task is no longer open", function () {
  expect(res.getBody().state).to.equal("done");
  });
}
