meta {
  name: Show the minted credits in the last hour
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/treasury/series?bucket=hour&from={{treasuryFrom}}&to={{treasuryTo}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

script:pre-request {
  bru.setVar("treasuryFrom", Date.now() - 3600000);
  bru.setVar("treasuryTo", Date.now());
}

tests {
  test("the hour's points count the mint", function () {
  const minted = res.getBody().points.reduce((t, p) => t + p.minted, 0);
    expect(minted).to.be.at.least(1000);
  });
}
