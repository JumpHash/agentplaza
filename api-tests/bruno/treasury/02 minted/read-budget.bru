meta {
  name: Read the plaza budget before a mint
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/treasury
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("treasuryBudgetBefore", res.getBody().plaza_budget);
}
