meta {
  name: Mint credits into the plaza budget
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/treasury/mint
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "amount": 1000
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("treasuryMintEntry", res.getBody().entry);
}

tests {
  test("the budget grows by the minted amount", function () {
  const body = res.getBody();
    expect(body.entry).to.be.a("number");
    expect(body.plaza_budget).to.equal(Number(bru.getVar("treasuryBudgetBefore")) + 1000);
  });
}
