meta {
  name: After the refused starts, the run list is still unreachable
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/runs
  body: none
  auth: none
}

assert {
  res.status: eq 502
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the hub says the node is unreachable", function () {
    expect(res.getBody().error).to.include("unreachable");
  });
}
