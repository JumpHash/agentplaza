meta {
  name: Start a run with an empty object
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/runs
  body: json
  auth: none
}

body:json {
  {}
}

assert {
  res.status: eq 502
  res.responseTime: lt 1000
}

tests {
  test("the hub says the node is unreachable", function () {
    expect(res.getBody().error).to.include("unreachable");
  });
}
