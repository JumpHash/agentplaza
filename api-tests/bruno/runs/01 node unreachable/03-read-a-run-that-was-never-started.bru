meta {
  name: Read a run that was never started
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/runs/t-run-1
  body: none
  auth: none
}

assert {
  res.status: eq 502
  res.responseTime: lt 1000
}

tests {
  test("the hub says the node is unreachable", function () {
    expect(res.getBody().error).to.include("unreachable");
  });
}
