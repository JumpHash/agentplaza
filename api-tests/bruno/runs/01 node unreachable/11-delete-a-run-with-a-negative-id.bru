meta {
  name: Delete a run with a negative id
  type: http
  seq: 11
}

delete {
  url: {{baseUrl}}/v1/runs/-1
  body: none
  auth: none
}

assert {
  res.status: eq 502
  res.responseTime: lt 1000
}

tests {
  test("the hub says the node is unreachable", function () {
    expect(res.getBody().error).to.include("unreachable");
  });
}
