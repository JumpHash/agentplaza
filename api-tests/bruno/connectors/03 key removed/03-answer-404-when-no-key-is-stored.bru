meta {
  name: Answer 404 when removing a key that is not stored
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/v1/connectors/unsplash/secret
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
}

tests {
  test("the refusal says no key is stored", function () {
    expect(res.getBody().error).to.equal("connector `unsplash` has no key stored");
  });
}
