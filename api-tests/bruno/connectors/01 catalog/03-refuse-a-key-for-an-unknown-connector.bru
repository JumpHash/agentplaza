meta {
  name: Answer 404 when setting a key for an unknown connector
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/v1/connectors/t-no-such-connector/secret
  body: json
  auth: none
}

body:json {
  {"value": "t-value"}
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error: isString
}
