meta {
  name: List connector proposals, newest first, as a list
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/connectors/proposals
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the proposals are a list, each with its state", function () {
    const list = res.getBody();
    expect(list).to.be.an("array");
    list.forEach((p) => expect(p).to.have.property("state"));
  });
}
