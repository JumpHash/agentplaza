meta {
  name: Refuse a review body that is not JSON
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/connectors/proposals/cp-999/review
  body: text
  auth: none
}

body:text {
  approve: yes
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: contains "bad body"
}
