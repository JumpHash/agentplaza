meta {
  name: Refuse a fork while held, before the sandbox is looked up
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff/fork
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "count": 1
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "sandbox_held"
}
