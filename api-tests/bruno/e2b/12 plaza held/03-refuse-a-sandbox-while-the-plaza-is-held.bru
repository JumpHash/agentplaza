meta {
  name: Refuse a sandbox while the plaza is held
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/e2b/sandboxes
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "templateID": "base"
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "sandbox_held"
}
