meta {
  name: Refuse a build start while the plaza is held
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/e2b/v2/templates/{{e2bHeldTemplate}}/builds/{{e2bHeldBuild}}
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "fromImage": "e2bdev/base"
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
  res.body.error_code: eq "sandbox_held"
}
