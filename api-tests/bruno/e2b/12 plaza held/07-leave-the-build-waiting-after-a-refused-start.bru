meta {
  name: Leave the build waiting after a refused start
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/e2b/templates/{{e2bHeldTemplate}}/builds/{{e2bHeldBuild}}/status
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the build has not started", function () {
    expect(res.getBody().status).to.equal("waiting");
  });
}
