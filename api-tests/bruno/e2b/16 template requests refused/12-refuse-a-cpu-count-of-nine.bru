meta {
  name: Refuse a CPU count of nine
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/e2b/v3/templates
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "name": "e2b-cpu-tmpl",
    "cpuCount": 9
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error_code: eq "invalid_request"
}
