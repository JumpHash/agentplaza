meta {
  name: Refuse more than 32 tags
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/e2b/v3/templates
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "name": "e2b-many-tmpl",
    "tags": [
      "t0",
      "t1",
      "t2",
      "t3",
      "t4",
      "t5",
      "t6",
      "t7",
      "t8",
      "t9",
      "t10",
      "t11",
      "t12",
      "t13",
      "t14",
      "t15",
      "t16",
      "t17",
      "t18",
      "t19",
      "t20",
      "t21",
      "t22",
      "t23",
      "t24",
      "t25",
      "t26",
      "t27",
      "t28",
      "t29",
      "t30",
      "t31",
      "t32"
    ]
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "invalid_request"
}

tests {
  test("at most 32 tags", function () {
    expect(res.getBody().message).to.equal("at most 32 tags");
  });
}
