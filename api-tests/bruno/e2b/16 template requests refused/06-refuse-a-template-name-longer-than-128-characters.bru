meta {
  name: Refuse a template name longer than 128 characters
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/e2b/v3/templates
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "invalid_request"
}
