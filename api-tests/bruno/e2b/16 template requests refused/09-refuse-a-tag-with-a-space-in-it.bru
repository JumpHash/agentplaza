meta {
  name: Refuse a tag with a space in it
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/e2b/v3/templates
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "name": "e2b-bad-tmpl:bad tag"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "invalid_request"
}
