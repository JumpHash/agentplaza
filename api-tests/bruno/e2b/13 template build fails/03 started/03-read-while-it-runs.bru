meta {
  name: Read the build while it runs or has failed
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/e2b/templates/{{e2bFailTemplate}}/builds/{{e2bFailBuild}}/status
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the build is building, or has already failed", function () {
    expect(["building", "error"]).to.include(res.getBody().status);
  });
}
