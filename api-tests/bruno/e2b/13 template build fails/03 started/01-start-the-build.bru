meta {
  name: Start the build with a copied archive and a command
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/e2b/v2/templates/{{e2bFailTemplate}}/builds/{{e2bFailBuild}}
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "fromImage": "e2bdev/base",
    "steps": [
      {
        "type": "ENV",
        "args": [
          "E2B_MODE",
          "test"
        ]
      },
      {
        "type": "COPY",
        "args": [
          "app",
          "/home/user/app",
          "user",
          "0755"
        ],
        "filesHash": "{{e2bHash}}"
      },
      {
        "type": "RUN",
        "args": [
          "echo ready"
        ]
      }
    ],
    "startCmd": "sleep 3600",
    "readyCmd": "true"
  }
}

assert {
  res.status: eq 202
  res.responseTime: lt {{budgetMs}}
}
