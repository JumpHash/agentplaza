meta {
  name: Find the template by its alias
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/e2b/templates/aliases/e2b-fail-tmpl
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the alias names the template", function () {
    expect(res.getBody().templateID).to.equal(bru.getVar("e2bFailTemplate"));
    expect(res.getBody().public).to.equal(false);
  });
}
