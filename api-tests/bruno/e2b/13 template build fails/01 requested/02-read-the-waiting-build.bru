meta {
  name: Read the new build as waiting
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/e2b/templates/{{e2bFailTemplate}}/builds/{{e2bFailBuild}}/status
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the build waits for its start and logs its request", function () {
    expect(res.getBody().status).to.equal("waiting");
    expect(res.getBody().buildID).to.equal(bru.getVar("e2bFailBuild"));
    expect(res.getBody().logs.some((l) => l.includes("requested"))).to.equal(true);
  });
}
