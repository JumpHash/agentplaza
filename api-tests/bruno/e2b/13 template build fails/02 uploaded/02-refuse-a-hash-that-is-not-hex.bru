meta {
  name: Refuse an upload link for a file hash that is not hex
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/e2b/templates/{{e2bFailTemplate}}/files/not-a-hash
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
