meta {
  name: Refuse a start of the failed build
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/e2b/v2/templates/{{e2bFailTemplate}}/builds/{{e2bFailBuild}}
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "fromImage": "e2bdev/base"
  }
}

assert {
  res.status: eq 409
  res.responseTime: lt 1000
  res.body.error_code: eq "template_build_started"
}
