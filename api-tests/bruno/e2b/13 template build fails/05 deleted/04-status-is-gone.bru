meta {
  name: The build's status is gone with the template
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/e2b/templates/{{e2bFailTemplate}}/builds/{{e2bFailBuild}}/status
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error_code: eq "template_not_found"
}
