meta {
  name: The alias is gone with the template
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/e2b/templates/aliases/e2b-fail-tmpl
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error_code: eq "template_not_found"
}
