meta {
  name: Refuse the tags of a template that does not exist
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/e2b/templates/e2b-nope-tmpl/tags
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error_code: eq "template_not_found"
}
