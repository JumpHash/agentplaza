meta {
  name: Refuse removing tags from a template that does not exist
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/e2b/templates/tags
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "name": "e2b-nope-tmpl",
    "tags": [
      "x"
    ]
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "template_not_found"
}
