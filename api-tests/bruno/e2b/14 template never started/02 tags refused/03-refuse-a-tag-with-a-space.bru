meta {
  name: Refuse a tag with a space in it
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/e2b/templates/tags
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "target": "e2b-wait-tmpl",
    "tags": [
      "bad tag"
    ]
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "invalid_request"
}
