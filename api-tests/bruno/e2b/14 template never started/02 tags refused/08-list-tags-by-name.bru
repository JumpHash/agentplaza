meta {
  name: List a template's tags by its name
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/e2b/templates/e2b-wait-tmpl/tags
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("no build has a tag yet", function () {
    expect(res.getBody()).to.have.lengthOf(0);
  });
}
