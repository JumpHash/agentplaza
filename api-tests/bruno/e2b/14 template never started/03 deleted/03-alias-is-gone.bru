meta {
  name: The alias is gone
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/e2b/templates/aliases/e2b-wait-tmpl
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "template_not_found"
}
