meta {
  name: Refuse the status of a deleted build
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/e2b/templates/{{e2bWaitTemplate}}/builds/{{e2bWaitBuild}}/status
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error_code: eq "template_not_found"
}
