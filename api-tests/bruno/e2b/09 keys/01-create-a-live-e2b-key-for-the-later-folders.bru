meta {
  name: Create a live E2B key for the later folders
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/e2b/keys
  body: json
  auth: none
}

body:json {
  {
    "label": "bruno e2b live"
  }
}

script:post-response {
  bru.setVar("e2bLiveKey", res.getBody().key);
  bru.setVar("e2bLiveKeyId", res.getBody().id);
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body.label: eq "bruno e2b live"
}

tests {
  test("the live key has the e2b_ prefix and forty hex digits", function () {
    expect(res.getBody().key).to.match(/^e2b_[0-9a-f]{40}$/);
  });
}
