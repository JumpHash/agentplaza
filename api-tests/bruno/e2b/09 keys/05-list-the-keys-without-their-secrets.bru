meta {
  name: List the keys without their secrets
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/e2b/keys
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the live key is listed by its label, and no entry carries a secret", function () {
    const keys = res.getBody().keys;
    expect(keys).to.be.an("array");
    const live = keys.find((k) => k.id === bru.getVar("e2bLiveKeyId"));
    expect(live).to.exist;
    expect(live.label).to.equal("bruno e2b live");
    keys.forEach((k) => expect(k).to.not.have.property("key"));
  });
}
