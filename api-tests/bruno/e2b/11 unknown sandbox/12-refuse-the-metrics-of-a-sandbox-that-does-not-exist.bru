meta {
  name: Refuse the metrics of a sandbox that does not exist
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff/metrics
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error_code: eq "sandbox_not_found"
}
