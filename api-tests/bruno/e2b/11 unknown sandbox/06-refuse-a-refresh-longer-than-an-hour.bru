meta {
  name: Refuse a refresh longer than an hour
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff/refreshes
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "duration": 3601
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
