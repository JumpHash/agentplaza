meta {
  name: Refuse to resume a sandbox that does not exist
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff/resume
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "sandbox_not_found"
}
