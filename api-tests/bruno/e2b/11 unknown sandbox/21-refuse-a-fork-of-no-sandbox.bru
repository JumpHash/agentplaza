meta {
  name: Refuse a fork of no sandbox
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff/fork
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "count": 0
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
