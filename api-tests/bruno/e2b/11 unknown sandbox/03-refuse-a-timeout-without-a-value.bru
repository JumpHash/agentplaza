meta {
  name: Refuse a timeout without a value
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff/timeout
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error_code: eq "invalid_request"
}
