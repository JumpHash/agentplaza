meta {
  name: Refuse a v1 connect to a sandbox that does not exist
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff/connect
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "timeout": 60
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error_code: eq "sandbox_not_found"
}
