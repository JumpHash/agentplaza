meta {
  name: Refuse to end a sandbox that does not exist
  type: http
  seq: 1
}

delete {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error_code: eq "sandbox_not_found"
}

tests {
  test("the message names the sandbox", function () {
    expect(res.getBody().message).to.equal("no sandbox sbffffffffffffffff");
  });
}
