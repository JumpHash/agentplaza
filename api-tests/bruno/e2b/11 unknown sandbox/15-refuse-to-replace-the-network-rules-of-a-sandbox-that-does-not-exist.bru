meta {
  name: Refuse to replace the network rules of a sandbox that does not exist
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff/network
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "allowOut": [
      "example.com"
    ]
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "sandbox_not_found"
}
