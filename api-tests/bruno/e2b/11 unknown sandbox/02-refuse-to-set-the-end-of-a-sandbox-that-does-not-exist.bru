meta {
  name: Refuse to set the end of a sandbox that does not exist
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff/timeout
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "timeout": 60
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "sandbox_not_found"
}
