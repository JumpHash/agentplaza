meta {
  name: Refuse a v1 connect without a timeout
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff/connect
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the v1 connect needs a timeout", function () {
    expect(res.getBody().message).to.equal("timeout is required");
  });
}
