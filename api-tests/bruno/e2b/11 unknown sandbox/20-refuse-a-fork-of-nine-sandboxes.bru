meta {
  name: Refuse a fork of nine sandboxes
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/e2b/sandboxes/sbffffffffffffffff/fork
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "count": 9
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
