meta {
  name: Request a build for the refused starts
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/e2b/v3/templates
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "name": "e2b-refused-tmpl"
  }
}

script:post-response {
  bru.setVar("e2bRefusedTemplate", res.getBody().templateID);
  bru.setVar("e2bRefusedBuild", res.getBody().buildID);
}

assert {
  res.status: eq 202
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the default tag", function () {
    expect(res.getBody().tags).to.deep.equal(["default"]);
  });
}
