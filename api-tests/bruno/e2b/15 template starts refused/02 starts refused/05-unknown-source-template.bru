meta {
  name: Refuse a source template that does not exist
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/e2b/v2/templates/{{e2bRefusedTemplate}}/builds/{{e2bRefusedBuild}}
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "fromTemplate": "e2b-missing-tmpl"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error_code: eq "invalid_request"
}

tests {
  test("the message says why", function () {
    expect(res.getBody().message).to.include("no such template");
  });
}
