meta {
  name: Refuse a start of a build that does not exist
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/e2b/v2/templates/{{e2bRefusedTemplate}}/builds/00000000-0000-4000-8000-000000000000
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "fromImage": "e2bdev/base"
  }
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
  res.body.error_code: eq "template_build_not_found"
}
