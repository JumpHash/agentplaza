meta {
  name: Leave the build waiting after all the refusals
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/e2b/templates/{{e2bRefusedTemplate}}/builds/{{e2bRefusedBuild}}/status
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("nothing refused moved the build", function () {
    expect(res.getBody().status).to.equal("waiting");
  });
}
