meta {
  name: Refuse another base image
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/e2b/v2/templates/{{e2bRefusedTemplate}}/builds/{{e2bRefusedBuild}}
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "fromImage": "ubuntu:22.04"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error_code: eq "invalid_request"
}

tests {
  test("the message says why", function () {
    expect(res.getBody().message).to.include("no other image is pulled");
  });
}
