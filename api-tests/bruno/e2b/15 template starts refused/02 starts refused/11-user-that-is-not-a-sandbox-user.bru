meta {
  name: Refuse a USER step for a user the sandbox lacks
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/e2b/v2/templates/{{e2bRefusedTemplate}}/builds/{{e2bRefusedBuild}}
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "fromImage": "e2bdev/base",
    "steps": [
      {
        "type": "USER",
        "args": [
          "postgres"
        ]
      }
    ]
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error_code: eq "invalid_request"
}

tests {
  test("the message says why", function () {
    expect(res.getBody().message).to.include("user and root");
  });
}
