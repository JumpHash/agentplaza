meta {
  name: Refuse a start command longer than 64 KiB
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/e2b/v2/templates/{{e2bRefusedTemplate}}/builds/{{e2bRefusedBuild}}
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "fromImage": "e2bdev/base"
  }
}

script:pre-request {
  req.setBody({ fromImage: "e2bdev/base", startCmd: "x".repeat(65537) });
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error_code: eq "invalid_request"
}
