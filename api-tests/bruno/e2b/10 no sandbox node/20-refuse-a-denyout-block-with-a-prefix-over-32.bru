meta {
  name: Refuse a denyOut block with a prefix over 32
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/e2b/sandboxes
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "templateID": "base",
    "network": {
      "denyOut": [
        "10.0.0.0/33"
      ]
    }
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
