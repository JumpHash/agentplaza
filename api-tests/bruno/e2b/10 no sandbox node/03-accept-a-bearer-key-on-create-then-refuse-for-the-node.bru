meta {
  name: Accept a Bearer key on create, then refuse for the node
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/e2b/sandboxes
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{e2bLiveKey}}
}

body:json {
  {
    "templateID": "base",
    "timeout": 60
  }
}

assert {
  res.status: eq 503
  res.responseTime: lt {{budgetMs}}
}
