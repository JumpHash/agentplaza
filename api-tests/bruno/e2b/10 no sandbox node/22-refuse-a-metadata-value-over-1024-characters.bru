meta {
  name: Refuse a metadata value over 1024 characters
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/e2b/sandboxes
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "templateID": "base",
    "metadata": {
      "e2bbig": ""
    }
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
