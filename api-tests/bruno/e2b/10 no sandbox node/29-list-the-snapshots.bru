meta {
  name: List the snapshots
  type: http
  seq: 29
}

get {
  url: {{baseUrl}}/e2b/snapshots
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the snapshots are an array", function () {
    expect(res.getBody()).to.be.an("array");
  });
}
