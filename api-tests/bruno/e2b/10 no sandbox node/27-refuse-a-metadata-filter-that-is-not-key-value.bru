meta {
  name: Refuse a metadata filter that is not key=value
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/e2b/sandboxes?metadata=novalue
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error_code: eq "invalid_request"
}
