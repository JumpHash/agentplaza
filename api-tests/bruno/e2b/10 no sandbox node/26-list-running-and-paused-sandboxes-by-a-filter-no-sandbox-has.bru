meta {
  name: List running and paused sandboxes by a filter no sandbox has
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/e2b/v2/sandboxes?state=running,paused&metadata=e2bnone%3Dyes
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("nothing matches the filter", function () {
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody()).to.have.lengthOf(0);
  });
}
