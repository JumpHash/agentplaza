meta {
  name: Refuse a template id longer than 128 characters
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/e2b/sandboxes
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "templateID": "ttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
