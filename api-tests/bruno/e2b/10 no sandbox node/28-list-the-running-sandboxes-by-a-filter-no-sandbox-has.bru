meta {
  name: List the running sandboxes by a filter no sandbox has
  type: http
  seq: 28
}

get {
  url: {{baseUrl}}/e2b/sandboxes?metadata=e2bnone%3Dyes
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("nothing matches the filter", function () {
    expect(res.getBody()).to.have.lengthOf(0);
  });
}
