meta {
  name: Refuse a masked request host on a sandbox
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/e2b/sandboxes
  body: json
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

body:json {
  {
    "templateID": "base",
    "network": {
      "maskRequestHost": "example.com"
    }
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
