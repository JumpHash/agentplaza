meta {
  name: Refuse the metrics of several sandboxes without ids (sandbox_ids is required)
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/e2b/sandboxes/metrics
  body: none
  auth: none
}

headers {
  X-API-Key: {{e2bLiveKey}}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the answer says sandbox_ids is required", function () {
    expect(res.getBody().message).to.equal("sandbox_ids is required");
  });
}
