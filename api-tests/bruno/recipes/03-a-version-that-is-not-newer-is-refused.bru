meta {
  name: A recipe version that is not newer is refused
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/v1/recipes/change
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "toml": "id = \"change\"\nversion = 1\n[[steps]]\nid = \"build\"\nrole = \"builder\"\n"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("the hub refuses a version that is not newer than the built-in one", function () {
    expect(res.getBody().error || JSON.stringify(res.getBody())).to.include("version");
  });
}
