meta {
  name: Refuse a usage provider with a blank key
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/usage-providers
  body: json
  auth: none
}

body:json {
  {
    "id": "t-usage-hub",
    "url": "https://cliproxy.invalid:8317",
    "label": "t usage hub",
    "key": "   "
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the error says the key is required", function () {
    expect(res.getBody().error).to.include("management key is required");
  });
}
