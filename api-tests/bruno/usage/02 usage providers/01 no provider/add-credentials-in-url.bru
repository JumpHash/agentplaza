meta {
  name: Refuse a usage provider address with credentials in it
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/usage-providers
  body: json
  auth: none
}

body:json {
  {
    "id": "t-usage-hub",
    "url": "https://user:pw@cliproxy.invalid:8317",
    "label": "t usage hub",
    "key": "t-usage-key-0123456789"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}
