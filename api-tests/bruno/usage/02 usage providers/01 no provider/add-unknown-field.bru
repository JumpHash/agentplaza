meta {
  name: Refuse a usage provider body with an unknown field
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/usage-providers
  body: json
  auth: none
}

body:json {
  {
    "id": "t-usage-hub",
    "url": "https://cliproxy.invalid:8317",
    "label": "t usage hub",
    "key": "t-usage-key-0123456789",
    "token": "not-a-field"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the body is refused as bad", function () {
    expect(res.getBody().error).to.include("bad body");
  });
}
