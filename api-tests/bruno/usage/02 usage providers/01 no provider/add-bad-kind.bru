meta {
  name: Refuse a usage provider of another kind
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/usage-providers
  body: json
  auth: none
}

body:json {
  {
    "id": "t-usage-hub",
    "url": "https://cliproxy.invalid:8317",
    "label": "t usage hub",
    "key": "t-usage-key-0123456789",
    "kind": "other-hub"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the error names the kind", function () {
    expect(res.getBody().error).to.include("kind must be cliproxyapi");
  });
}
