meta {
  name: Refuse a calls page whose before is not a number
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/v1/usage/calls?before=x
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}

tests {
  test("the error names before", function () {
    expect(res.getBody().error).to.include("before");
  });
}
