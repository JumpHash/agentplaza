meta {
  name: List the newest model calls with no filter
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/v1/usage/calls
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the page has calls, a total and a cursor", function () {
    const body = res.getBody();
    expect(body.calls).to.be.an("array");
    expect(body.total).to.be.a("number");
    expect(body).to.have.property("next_before");
  });
}
