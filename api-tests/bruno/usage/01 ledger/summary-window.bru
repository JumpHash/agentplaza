meta {
  name: Summarize an explicit window
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/usage/summary?from=0&to=3600000
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

tests {
  test("the summary echoes the window", function () {
    const body = res.getBody();
    expect(body.from_ms).to.equal(0);
    expect(body.to_ms).to.equal(3600000);
  });
}
