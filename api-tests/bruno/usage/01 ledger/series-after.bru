meta {
  name: Refuse a series whose window ends before it starts
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v1/usage/series?from=2000&to=1000
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the error says from is after to", function () {
    expect(res.getBody().error).to.include("after");
  });
}
