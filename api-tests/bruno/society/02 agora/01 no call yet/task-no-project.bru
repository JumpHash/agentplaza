meta {
  name: Refuse a roled task with no project
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

body:json {
  {
    "goal": "Scout sources",
    "role": "architect"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("belongs to a project");
  });
}
