meta {
  name: Refuse the profile of an agent whose id is text
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/v1/agents/abc/profile
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("not an agent CID");
  });
}
