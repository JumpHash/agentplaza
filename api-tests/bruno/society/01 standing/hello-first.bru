meta {
  name: Register the first agent from its VM
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/internal/v1/agents/43001/hello
  body: json
  auth: none
}

headers {
  x-apz-internal: {{internalToken}}
}

body:json {
  {
    "vm": 1
  }
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the hello answers the agent's profile", function () {
    expect(res.getBody().profile).to.be.an("object");
    expect(res.getBody().profile.system_parts.map((part) => part.text).join("\n")).to.include("(CID 43001)");
  });
}
