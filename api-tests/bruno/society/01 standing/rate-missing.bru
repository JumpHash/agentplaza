meta {
  name: Refuse a rating with no value
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/agents/43001/rating
  body: json
  auth: none
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("invalid rating");
  });
}
