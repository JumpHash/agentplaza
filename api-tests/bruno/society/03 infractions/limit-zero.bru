meta {
  name: A limit of zero still answers at most one row
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/infractions?limit=0
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt {{budgetMs}}
  res.body: isArray
}

tests {
  test("at most one row", function () {
    expect(res.getBody().length).to.be.at.most(1);
  });
}
