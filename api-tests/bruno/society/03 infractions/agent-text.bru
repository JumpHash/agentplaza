meta {
  name: Refuse the infractions of an agent whose id is text
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/agents/abc/infractions
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
  res.body.error: isString
}

tests {
  test("the refusal names the problem", function () {
    expect(res.getBody().error).to.include("cid must be a number");
  });
}
