meta {
  name: Limit the infractions to one
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/infractions?limit=1
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
  res.body: isArray
}

tests {
  test("at most one row", function () {
    expect(res.getBody().length).to.be.at.most(1);
  });
}
