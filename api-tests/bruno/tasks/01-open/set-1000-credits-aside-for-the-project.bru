meta {
  name: Set 1000 credits aside for the project
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/projects/{{tsk_pid}}/budget
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"credits": 1000}
}

assert {
  res.status: eq 200
  res.body.balance: eq 1000
  res.responseTime: lt {{budgetMs}}
}
