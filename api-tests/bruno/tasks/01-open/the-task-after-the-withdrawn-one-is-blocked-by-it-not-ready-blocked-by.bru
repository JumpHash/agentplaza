meta {
  name: The task after the withdrawn one is blocked by it: not ready, blocked_by A
  type: http
  seq: 52
}

get {
  url: {{baseUrl}}/v1/tasks/{{tsk_b}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.ready: eq false
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("it is blocked by the withdrawn task", function () {
    expect(res.getBody().blocked_by).to.deep.equal([bru.getVar("tsk_a")]);
  });
}
