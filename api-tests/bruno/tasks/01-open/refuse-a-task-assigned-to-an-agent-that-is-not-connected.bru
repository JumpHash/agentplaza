meta {
  name: Refuse a task assigned to an agent that is not connected
  type: http
  seq: 44
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"goal": "t-tasks assigned", "budget": 200, "project": "{{tsk_pid}}", "assignee": 1000}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
