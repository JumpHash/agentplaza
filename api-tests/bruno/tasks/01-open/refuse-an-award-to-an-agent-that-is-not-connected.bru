meta {
  name: Refuse an award to an agent that is not connected
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/v1/tasks/{{tsk_a}}/award
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"agent_cid": 1000}
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
}
