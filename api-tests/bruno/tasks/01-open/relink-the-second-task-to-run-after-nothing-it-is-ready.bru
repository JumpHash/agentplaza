meta {
  name: Relink the second task to run after nothing: it is ready
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/v1/tasks/{{tsk_b}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"after": []}
}

assert {
  res.status: eq 200
  res.body.ready: eq true
  res.responseTime: lt 1000
}

tests {
  test("nothing is waited on", function () {
    expect(res.getBody().waiting_on).to.deep.equal([]);
  });
}
