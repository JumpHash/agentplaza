meta {
  name: Refuse a task that runs after a task that does not exist
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"goal": "t-tasks bad link", "budget": 200, "project": "{{tsk_pid}}", "after": ["t999999"]}
}

assert {
  res.status: eq 400
  res.body.error: contains "not a task"
  res.responseTime: lt {{budgetMs}}
}
