meta {
  name: Refuse a task with a zero budget
  type: http
  seq: 37
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"goal": "t-tasks zero budget", "budget": 0, "project": "{{tsk_pid}}"}
}

assert {
  res.status: eq 400
  res.responseTime: lt 1000
}
