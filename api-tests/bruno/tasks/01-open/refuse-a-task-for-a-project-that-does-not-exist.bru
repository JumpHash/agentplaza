meta {
  name: Refuse a task for a project that does not exist
  type: http
  seq: 41
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"goal": "t-tasks unknown project", "budget": 200, "project": "pr999999"}
}

assert {
  res.status: eq 404
  res.body.error: contains "no project"
  res.responseTime: lt 1000
}
