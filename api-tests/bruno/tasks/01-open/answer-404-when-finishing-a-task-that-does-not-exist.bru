meta {
  name: Answer 404 when finishing a task that does not exist
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/v1/tasks/t999999/finish
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"outcome": "done"}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
