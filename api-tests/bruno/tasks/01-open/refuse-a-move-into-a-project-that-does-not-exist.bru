meta {
  name: Refuse a move into a project that does not exist
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/v1/tasks/{{tsk_a}}/move
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"project": "pr999999"}
}

assert {
  res.status: eq 404
  res.responseTime: lt 1000
}
