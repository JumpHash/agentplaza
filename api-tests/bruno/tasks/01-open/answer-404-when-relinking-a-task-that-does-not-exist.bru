meta {
  name: Answer 404 when relinking a task that does not exist
  type: http
  seq: 14
}

patch {
  url: {{baseUrl}}/v1/tasks/t999999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"after": []}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
