meta {
  name: Refuse a task with no goal
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"budget": 200, "project": "{{tsk_pid}}"}
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
