meta {
  name: Refuse a claim with no agent named
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/v1/tasks/{{tsk_a}}/claim
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.body.error: contains "agent_cid"
  res.responseTime: lt 1000
}
