meta {
  name: Refuse a relink to a task that does not exist
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/v1/tasks/{{tsk_a}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"after": ["t999999"]}
}

assert {
  res.status: eq 400
  res.body.error: contains "not a task"
  res.responseTime: lt 1000
}
