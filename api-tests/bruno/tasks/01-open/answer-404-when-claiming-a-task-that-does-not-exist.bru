meta {
  name: Answer 404 when claiming a task that does not exist
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/v1/tasks/t999999/claim
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"agent_cid": 1000}
}

assert {
  res.status: eq 404
  res.responseTime: lt {{budgetMs}}
}
