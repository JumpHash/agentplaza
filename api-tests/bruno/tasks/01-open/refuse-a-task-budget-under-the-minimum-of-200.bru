meta {
  name: Refuse a task budget under the minimum of 200
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"goal": "t-tasks low budget", "budget": 199, "project": "{{tsk_pid}}"}
}

assert {
  res.status: eq 400
  res.body.error: contains "minimum of 200"
  res.responseTime: lt 1000
}
