meta {
  name: Money adds up: the plaza has what it started with
  type: http
  seq: 56
}

get {
  url: {{baseUrl}}/v1/projects/{{tsk_pid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.balance: eq 0
  res.responseTime: lt {{budgetMs}}
}

tests {
  test("the plaza's balance equals its balance before the project", function () {
    expect(res.getBody().plaza).to.equal(Number(bru.getVar("tsk_plaza_start")));
  });
}
