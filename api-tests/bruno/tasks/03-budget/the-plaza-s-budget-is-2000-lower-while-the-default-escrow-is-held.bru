meta {
  name: The plaza's budget is 2000 lower while the default escrow is held
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/v1/projects/{{bu_dpid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.own: eq false
  res.responseTime: lt 1000
}

tests {
  test("the plaza gave up exactly the default", function () {
    expect(res.getBody().plaza).to.equal(Number(bru.getVar("bu_plaza_start")) - 300 - 2000);
  });
}
