meta {
  name: A task with no budget takes the plaza's default of 2000 credits
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"goal": "t-tasks default escrow", "project": "{{bu_dpid}}"}
}

assert {
  res.status: eq 201
  res.body.budget: eq 2000
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("bu_dtask", res.getBody().id);
}
