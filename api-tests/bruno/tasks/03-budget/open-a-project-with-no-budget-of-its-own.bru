meta {
  name: Open a project with no budget of its own
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"title": "t-tasks default budget", "goal": "The plaza pays the default"}
}

assert {
  res.status: eq 201
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("bu_dpid", res.getBody().id);
}
