meta {
  name: Open a 200-credit task from the project's 300
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"goal": "t-tasks first 200", "budget": 200, "project": "{{bu_pid}}"}
}

assert {
  res.status: eq 201
  res.body.budget: eq 200
  res.responseTime: lt {{budgetMs}}
}

script:post-response {
  bru.setVar("bu_t1", res.getBody().id);
}
