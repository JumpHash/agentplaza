meta {
  name: A second 200-credit task is refused: only 100 is left
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"goal": "t-tasks second 200", "budget": 200, "project": "{{bu_pid}}"}
}

assert {
  res.status: neq 201
  res.body.error: isString
  res.responseTime: lt {{budgetMs}}
}
