meta {
  name: Open a project whose tasks will be blocked
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"title": "t-tasks blocked", "goal": "An upstream task is withdrawn"}
}

assert {
  res.status: eq 201
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("bl_pid", res.getBody().id);
}
