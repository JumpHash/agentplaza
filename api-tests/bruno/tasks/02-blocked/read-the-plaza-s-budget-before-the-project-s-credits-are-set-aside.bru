meta {
  name: Read the plaza's budget before the project's credits are set aside
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/projects/{{bl_pid}}/budget
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.responseTime: lt 1000
}

script:post-response {
  bru.setVar("bl_plaza_start", res.getBody().plaza);
}
