meta {
  name: Refuse a Linear base address over plain http to another host
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/v1/intake/connections/linear
  body: json
  auth: none
}

body:json {
  {
    "base_url": "http://api.linear.app/graphql"
  }
}

assert {
  res.status: eq 400
  res.responseTime: lt {{budgetMs}}
}
