# The lab VM's kernel (PLAN 22.6), on top of common.config: a topology's containers run in their own namespaces, joined to
# a bridge by veth pairs inside the guest, and their image layers are overlayfs. Agent VMs do not carry these; their
# kernel is built without LAB_KERNEL (scripts/mk-guest-kernel.sh). The tools the lab image carries are listed in
# scripts/guest/lab-tools.txt.

CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_NETDEVICES=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_OVERLAY_FS=y
