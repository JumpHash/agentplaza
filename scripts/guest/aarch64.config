# arm64 guests on KVM (Raspberry Pi 4/5, arm64 servers) and on Apple Silicon's
# Hypervisor.framework: everything comes from the device tree — the ns16550a UART, virtio,mmio
# devices, a GICv2 or GICv3, the architected timer, power-off through PSCI.

CONFIG_OF=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM64_4K_PAGES=y
# QEMU's virt machine (boot tests on hosts without arm64 KVM) has a PL011 UART instead.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
