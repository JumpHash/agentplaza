# The AgentPlaza guest kernel: what every agent VM needs, all built in (no modules), on top of
# `make tinyconfig`. scripts/mk-guest-kernel.sh merges this with <arch>.config and fails if any
# `=y` below does not survive into the final .config.

CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
# A 100 Hz tick: fewer timer interrupts (VM exits) while a guest runs. Sleeps keep their precision
# through the high-resolution timers.
CONFIG_HZ_100=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Boot: the initramfs (gzip cpio) is the root.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Filesystems: the pseudo ones init mounts, tmpfs, and the workspace volume (ext4).
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

# The console.
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Devices: everything is virtio over MMIO — the vsock channel (the guest's only link to the
# host; there is no network device), the workspace block device, the memory balloon.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BALLOON=y
# Free page reporting: the guest hands freed memory back to the host (the balloon's reporting queue),
# so an idle agent's host footprint follows what it uses, not what it once touched.
CONFIG_PAGE_REPORTING=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y

# Sockets: Unix and loopback TCP for the harness's local services, and vsock.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# Entropy without a hardware RNG device: the jitter entropy collector seeds the CRNG at boot.
CONFIG_CRYPTO=y
