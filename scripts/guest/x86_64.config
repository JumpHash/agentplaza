# x86_64 guests on KVM: devices on the command line (virtio_mmio.device=…), SMP through the MP
# table and ACPI (MADT), power-off through ACPI S5, KVM's paravirtual clock.

CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_MPPARSE=y
CONFIG_X86_X2APIC=y
CONFIG_ACPI=y
# ACPI's system sleep states carry S5, the power-off path the VMM implements.
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_ACPI_SLEEP=y
# ACPI installs its PCI-config region handler only with PCI support; the VMM boots with
# pci=off, so nothing is probed.
CONFIG_PCI=y
# One UART (ttyS0): the VM has no others to probe.
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
