      },
      {
        "name": "tool_search",
        "input": {
          "query": "plaza_verdict"
        }
      },
      {
        "name": "plaza_verdict",
        "input": {
          "pass": true,
          "notes": "mul() exists and its test passes.",
          "task": "$TASK"
        }
      },
      {
        "text": "Reviewed: pass."
      }
    ]
