{
  "fix-test": {
    "builder": [
      {
        "name": "read",
        "input": {
          "files": [
            {
              "path": "src/lib.rs"
            }
          ]
        }
      },
      {
        "name": "edit",
        "input": {
          "edits": [
            {
              "path": "src/lib.rs",
              "old": "a - b",
              "new": "a + b"
            }
          ]
        }
      },
      {
        "name": "run",
        "input": {
          "command": "rustc --edition 2021 --test src/lib.rs -o /tmp/apz-builder-check && /tmp/apz-builder-check"
        }
      },
      {
        "name": "tool_search",
        "input": {
          "query": "handover_write"
        }
      },
      {
        "name": "handover_write",
        "input": {
          "stands": "add() returns the sum of its arguments and the unit test passes.",
          "done": "The operator in add() is the only change.",
          "next": "Nothing: the reviewer checks the change.",
          "check_first": "That the check in the task passes."
        }
      },
      {
        "text": "Fixed add(): it subtracted instead of adding. The test passes. Handover: the operator in add() is the only change."
      }
    ],
    "reviewer": [
      {
        "name": "run",
        "input": {
          "command": "rustc --edition 2021 --test src/lib.rs -o /tmp/apz-review-check && /tmp/apz-review-check"
        }
      },
      {
        "name": "tool_search",
        "input": {
          "query": "plaza_verdict"
        }
      },
      {
        "name": "plaza_verdict",
        "input": {
          "pass": true,
          "notes": "The test passes and only add() changed.",
          "task": "$TASK"
        }
      },
      {
        "text": "Reviewed: pass."
      }
    ]
  },
  "add-function": {
