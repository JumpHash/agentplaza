              "content": "pub fn sub(a: i32, b: i32) -> i32 {\n    a - b\n}\n\npub fn mul(a: i32, b: i32) -> i32 {\n    a * b\n}\n\n#[cfg(test)]\nmod tests {\n    use super::{mul, sub};\n\n    #[test]\n    fn sub_subtracts() {\n        assert_eq!(sub(5, 3), 2);\n    }\n\n    #[test]\n    fn mul_multiplies() {\n        assert_eq!(mul(3, 4), 12);\n    }\n}\n"
            }
          ]
        }
      },
      {
        "name": "run",
        "input": {
          "command": "rustc --edition 2021 --test src/lib.rs -o /tmp/apz-builder-check && /tmp/apz-builder-check"
