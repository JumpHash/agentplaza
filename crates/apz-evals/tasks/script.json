      },
      {
        "name": "tool_search",
        "input": {
          "query": "handover_write"
        }
      },
      {
        "name": "handover_write",
        "input": {
          "stands": "mul() is in src/lib.rs with its test mul_multiplies, and the test passes.",
          "done": "The new function sits after sub().",
          "next": "Nothing: the reviewer checks the change.",
          "check_first": "That the check in the task passes."
        }
      },
      {
        "text": "Added mul() and its test mul_multiplies. Handover: the new function sits after sub()."
      }
    ],
    "reviewer": [
      {
        "name": "run",
        "input": {
          "command": "grep -q 'pub fn mul(' src/lib.rs && rustc --edition 2021 --test src/lib.rs -o /tmp/apz-review-check && /tmp/apz-review-check tests::mul_multiplies --exact"
