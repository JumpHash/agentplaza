// One credit line between a lender and a borrower (AP-073.R4, R7). Money is conserved: whatever the
// borrower draws leaves the lender's balance, and repays move it back. A write-off closes the line
// and the lender bears the loss; nothing is minted.

pack agentplaza.machines.credit_line version "0.1.0"

machine CreditLine "A credit line, with the two balances it moves between" {
  const Total: Credits                       // lender + borrower balances at the start

  var limit: Credits = 0 cr
  var used: Credits = 0 cr
  var lender: Credits = Total
  var borrower: Credits = 0 cr
  var open: Bool = true

  action Extend(n in Credits) {
    when open and n >= used and n <= lender + used
    limit' = n
  }

  action Draw(n in Credits) {
    when open and n > 0 cr and used + n <= limit and n <= lender
    used' = used + n
    lender' = lender - n
    borrower' = borrower + n
  }

  action Repay(n in Credits) {
    when n > 0 cr and n <= used and n <= borrower
    used' = used - n
    lender' = lender + n
    borrower' = borrower - n
  }

  action WriteOff "The borrower retires with an unpaid draw" {
    when open and used > 0 cr
    used' = 0 cr
    open' = false
  }

  invariant "Drawn never exceeds the line"   used <= limit or not open      implements AP-073.R4
  invariant "Balances never go negative"     lender >= 0 cr and borrower >= 0 cr
  invariant "Credits are conserved"          lender + borrower == Total     implements AP-073.R7
  transition "A closed line stays closed"    not open => not open'
}

model "three credits" of CreditLine {
  const Total = 3 cr
  domain Credits = 0 cr .. 3 cr
  deadlock allowed
}

mutant "Draw ignores the limit" of CreditLine {
  replace "used + n <= limit" in Draw with "true"
  expect violation "Drawn never exceeds the line"
}

mutant "Write-off mints the loss back to the lender" of CreditLine {
  replace "used' = 0 cr" in WriteOff with "used' = 0 cr; lender' = lender + used"
  expect violation "Credits are conserved"
}

witness "A line is fully drawn" of CreditLine in "three credits" {
  reachable open and used == limit and limit > 0 cr
}

witness "A line is written off with credits outstanding" of CreditLine in "three credits" {
  reachable not open and lender < Total
}
