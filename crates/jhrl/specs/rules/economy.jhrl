// Agent-to-agent transfers and credit lines (AP-073): checks over the money graph.

pack agentplaza.rules.economy version "0.1.0"

import agentplaza.model
import agentplaza.kinds

fn credit_limit(t: Number, scale: Credits) -> Credits "Treasury credit limit from reputation: ⌊L_T · T⌋ (AP-073.R2)" =
  floor(scale * t)

fn line_cap(score: Number, lender_balance: Credits, cap: Credits) -> Credits "Largest line a lender may extend: min(cap, ⌊0.5 · score · balance⌋) (AP-073.R4)" =
  min(cap, floor(0.5 * score * lender_balance))

check "Balance stays above the credit floor" {
  for a in agents
  require a.balance >= -a.credit_limit
  severity error
  message "{a.name}: balance {a.balance} is below its floor −{a.credit_limit}"
  implements AP-073.R1, AP-073.R2
}

check "Credit-line draw within its limit" {
  for l in credit_lines where l.valid_to == none
  require l.used <= l.limit
  severity error
  message "{l.from.name} → {l.to.name}: drawn {l.used} exceeds the line {l.limit}"
  implements AP-073.R4
}

check "Daily outgoing transfers within the cap" {
  for a in agents
  let out = sum([for x in a.out(TRANSFER) where (x.kind in {"pay", "line_draw", "line_repay"}) and (now - x.at <= 1 d) yield x.amount])
  require out <= transfer_daily_max(a) * 1 d
  severity error
  message "{a.name} moved {out} in the last day; the cap is {transfer_daily_max(a) * 1 d}"
  implements AP-073.R6
}

check "No transfers to oneself or within a lineage" {
  for x in transfers
  require x.from != x.to and x.from.predecessor != x.to and x.to.predecessor != x.from
  severity error
  message "{x.from.name} → {x.to.name}: transfer inside one lineage"
  implements AP-073.R6
}

check "Round-trip transfers" {
  for a in agents
  let back = cycles(transfers, from: a, within: cycle_window(a), returning: cycle_return_share(a))
  require count(back) == 0
  severity warning
  flag "circular_transfers" on [for c in back, x in c.agents yield x]
  message "{a.name}: {count(back)} transfer cycle(s) returned at least {cycle_return_share(a)} within {cycle_window(a)}"
  implements AP-073.R6
}
