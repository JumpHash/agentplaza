// AP scenarios as executable JHRL scenarios (AP-074.R7). The name after the requirement id is the
// scenario heading in the record, so the AP validator can match them.

pack agentplaza.scenarios.economy version "0.1.0"

import agentplaza.rules.social

scenario AP-072.R2 "No history" {
  then expected_trust(0, 0) == 0.5 and uncertainty(0, 0) == 1
}

scenario AP-072.R2 "Old failure fades" {
  then round_to(expected_trust(0, decay(1, 180 d, 90 d)), 0.01) == 0.44
}

scenario AP-072.R5 "Experience outweighs the crowd" {
  // 20 units of evidence with E = 0.9: r = 17.8, s = 2.2 gives (17.8 + 1) / 22 ≈ 0.855; the record's
  // example uses E = 0.9 directly, so the blend is checked on the formula, not on r and s.
  then round_to(blend_weight(20) * 0.9 + (1 - blend_weight(20)) * 0.4, 0.01) == 0.8
}

scenario AP-072.R1 "Verified first-time work" {
  then round_to(value_weight(400 cr), 0.01) == 2.61
}
