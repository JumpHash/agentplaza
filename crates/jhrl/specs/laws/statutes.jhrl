law "S-000a" "Every agent may work in its own sandbox" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may run commands and read its files in its own microVM, and only its own. Which tools it sees is set by its role (AP-055)."
  permit tool.exec
  principal is Agent
  resource is Sandbox
  when resource.agent == principal
}

law "S-000b" "Every agent may ask for approval" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may send a request up its approval chain (AP-038). C-004 still forbids pressuring or misleading approvers."
  permit approval.request
  principal is Agent
  resource is Approval
}

law "S-000c" "Agents may read artifacts" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may read artifacts, unless the artifact is hidden from its role (S-010d)."
  permit artifact.read
  principal is Agent
  resource is Artifact
}

law "S-000e" "Ordinary sandbox events are not offenses" {
  tier statute
  enforcement detective
  severity info
  statement "Lifecycle events from an agent's own sandbox (started, snapshot, resumed) are recorded and are not violations. C-001b singles out tamper signals."
  permit sandbox.event
  principal is Agent
  resource is Sandbox
  when resource.agent == principal
}

law "S-001a" "Builders may work in their own sandbox" {
  tier statute
  enforcement preventive
  severity info
  statement "A builder may run commands in its own microVM, and only its own."
  permit tool.exec
  principal is Agent
  resource is Sandbox
  when principal.role == "builder" and resource.agent == principal
}

law "S-001b" "Builders may reach package registries and the hub's git" {
  tier statute
  enforcement preventive
  severity info
  statement "A builder may connect to hosts in the package-registries and hub-git allowlists."
  permit egress.connect
  principal is Agent
  resource is Host
  when principal.role == "builder" and (resource.group == "package-registries" or resource.group == "hub-git")
}

law "S-001c" "Builders may publish artifacts" {
  tier statute
  enforcement preventive
  severity info
  statement "A builder may publish artifacts."
  permit artifact.publish
  principal is Agent
  resource is Artifact
  when principal.role == "builder"
}

law "S-001d" "Builders may message agents" {
  tier statute
  enforcement preventive
  severity info
  statement "A builder may send messages to agents."
  permit message.send
  principal is Agent
  resource is Agent
  when principal.role == "builder"
}

law "S-001e" "Builders may claim tasks as done" {
  tier statute
  enforcement preventive
  severity info
  statement "A builder may submit a completion claim for a task. The claim is verified, not trusted."
  permit claim.submit
  principal is Agent
  resource is Task
  when principal.role == "builder"
}

law "S-002a" "Reviewers may work in their own sandbox and fetch code" {
  tier statute
  enforcement preventive
  severity info
  statement "A reviewer may run commands in its own microVM and reach the hub's git and package registries."
  permit tool.exec
  principal is Agent
  resource is Sandbox
  when principal.role == "reviewer" and resource.agent == principal
}

law "S-002b" "Reviewers may connect to registries and the hub's git" {
  tier statute
  enforcement preventive
  severity info
  statement "A reviewer may connect to the package-registries and hub-git allowlists."
  permit egress.connect
  principal is Agent
  resource is Host
  when principal.role == "reviewer" and (resource.group == "package-registries" or resource.group == "hub-git")
}

law "S-002c" "Reviewers and verifiers may submit verdicts on tasks" {
  tier statute
  enforcement preventive
  severity info
  statement "A reviewer or a verifier may submit a review verdict on tasks."
  permit review.submit
  principal is Agent
  resource is Task
  when principal.role == "reviewer" or principal.role == "verifier"
}

law "S-003a" "Planners may work in their own sandbox and read the hub's git" {
  tier statute
  enforcement preventive
  severity info
  statement "A planner may run commands in its own microVM and reach the hub's git (specs and repos)."
  permit tool.exec
  principal is Agent
  resource is Sandbox
  when principal.role == "planner" and resource.agent == principal
}

law "S-003b" "Planners may read the hub's git" {
  tier statute
  enforcement preventive
  severity info
  statement "A planner may connect to the hub-git allowlist."
  permit egress.connect
  principal is Agent
  resource is Host
  when principal.role == "planner" and resource.group == "hub-git"
}

law "S-003c" "Planners may create tasks" {
  tier statute
  enforcement preventive
  severity info
  statement "A planner or the orchestrator may create tasks. Tasks still need plan approval before work starts."
  permit task.create
  principal is Agent
  resource is Town
  when principal.role == "planner" or principal.role == "orchestrator"
}

law "S-003d" "Planners may submit plans" {
  tier statute
  enforcement preventive
  severity info
  statement "A planner may submit a plan; it runs only after the plan gate (the orchestrator or the owner)."
  permit plan.submit
  principal is Agent
  resource is Town
  when principal.role == "planner"
}

law "S-004a" "The orchestrator assigns work" {
  tier statute
  enforcement preventive
  severity info
  statement "The orchestrator may assign tasks to agents."
  permit task.assign
  principal is Agent
  resource is Task
  when principal.role == "orchestrator"
}

law "S-004c" "The orchestrator approves plans and merges below threshold" {
  tier statute
  enforcement preventive
  severity info
  statement "The orchestrator may approve plans and merges for tasks when the budget is within the threshold and nothing is ambiguous; everything else goes to the owner (AP-060, AP-049)."
  permit plan.approve, merge.approve
  principal is Agent
  resource is Task
  when principal.role == "orchestrator" and context.budget <= context.threshold and not context.ambiguous
}

law "S-005a" "Departments may read audit logs" {
  tier statute
  enforcement preventive
  severity info
  statement "Finance and Incident response may read audit logs."
  permit audit.read
  principal is Agent
  resource is AuditLog
  when principal.role == "finance" or principal.role == "incident"
}

law "S-005b" "Finance and Incident response may read usage" {
  tier statute
  enforcement preventive
  severity info
  statement "Finance and Incident response may read the usage ledger (tokens, tool calls, VM time, spend)."
  permit usage.read
  principal is Agent
  resource is UsageLedger
  when principal.role == "finance" or principal.role == "incident"
}

law "S-005c" "Departments submit their own kind of report" {
  tier statute
  enforcement preventive
  severity info
  statement "Finance submits finance reports and detections of economic gaming, Incident response incident reports and detections."
  permit report.submit
  principal is Agent
  resource is Report
  when (principal.role == "finance" and (context.kind == "finance" or context.kind == "detection")) or (principal.role == "incident" and (context.kind == "incident" or context.kind == "detection")) 
}

law "S-005d" "Incident response may request per-case grants" {
  tier statute
  enforcement preventive
  severity info
  statement "Incident response may ask the owner for a time-limited grant, such as quarantine rights for one incident (AP-048)."
  permit grant.request
  principal is Agent
  resource is Grant
  when principal.role == "incident"
}

law "S-009a" "Architects may read repos" {
  tier statute
  enforcement preventive
  severity info
  statement "An architect may connect to the hub git."
  permit egress.connect
  principal is Agent
  resource is Host
  when principal.role == "architect" and resource.group == "hub-git"
}

law "S-009b" "Architects submit designs" {
  tier statute
  enforcement preventive
  severity info
  statement "An architect may submit design notes."
  permit design.submit
  principal is Agent
  resource is Town
  when principal.role == "architect"
}

law "S-010a" "QA may reach package registries and hub git" {
  tier statute
  enforcement preventive
  severity info
  statement "A QA agent may install test dependencies and read repos."
  permit egress.connect
  principal is Agent
  resource is Host
  when principal.role == "qa" and (resource.group == "package-registries" or resource.group == "hub-git")
}

law "S-010b" "QA submits test suites" {
  tier statute
  enforcement preventive
  severity info
  statement "A QA agent may submit test suites, hidden or not."
  permit testsuite.submit
  principal is Agent
  resource is Town
  when principal.role == "qa"
}

law "S-010d" "Hidden test suites stay hidden" {
  tier statute
  enforcement preventive
  severity high
  statement "An artifact hidden from a role can never be read by an agent of that role. Builders never see hidden acceptance tests, or passing them would mean nothing."
  forbid artifact.read
  principal is Agent
  resource is Artifact
  when principal.role in resource.hidden_from
}

law "S-011a" "Security reviewers may reach registries, advisories and hub git" {
  tier statute
  enforcement preventive
  severity info
  statement "A security reviewer may fetch dependencies, advisory databases and repos."
  permit egress.connect
  principal is Agent
  resource is Host
  when principal.role == "security-reviewer" and (resource.group == "package-registries" or resource.group == "advisories" or resource.group == "hub-git")
}

law "S-011b" "Security reviewers submit verdicts on tasks" {
  tier statute
  enforcement preventive
  severity info
  statement "A security reviewer may submit a security review for tasks."
  permit security_review.submit
  principal is Agent
  resource is Task
  when principal.role == "security-reviewer"
}

law "S-012a" "Release agents may use deploy tools" {
  tier statute
  enforcement preventive
  severity info
  statement "A release agent may call tools in the deploy group. Irreversible ones (production) still need a recorded owner approval (C-004)."
  permit tool.call
  principal is Agent
  resource is Tool
  when principal.role == "release" and resource.group == "deploy"
}

law "S-012b" "Release agents submit release plans" {
  tier statute
  enforcement preventive
  severity info
  statement "A release agent may submit release plans and records for tasks."
  permit release.submit
  principal is Agent
  resource is Task
  when principal.role == "release"
}

law "S-013a" "Researchers may read the open web" {
  tier statute
  enforcement preventive
  severity info
  statement "A researcher may connect to any host except blocked ones. Its output is always tainted."
  permit egress.connect
  principal is Agent
  resource is Host
  when principal.role == "researcher" and resource.group != "blocked"
}

law "S-013b" "Researchers may use web search" {
  tier statute
  enforcement preventive
  severity info
  statement "A researcher may call web-search tools (e.g. Firecrawl)."
  permit tool.call
  principal is Agent
  resource is Tool
  when principal.role == "researcher" and resource.group == "web-search"
}

law "S-013c" "Researchers submit research briefs" {
  tier statute
  enforcement preventive
  severity info
  statement "A researcher may submit research briefs."
  permit research.submit
  principal is Agent
  resource is Town
  when principal.role == "researcher"
}

law "S-013d" "Researchers never write to repositories" {
  tier statute
  enforcement preventive
  severity high
  statement "A researcher may not connect to the hub git: untrusted content must reach code only through a builder who treats it as data."
  forbid egress.connect
  principal is Agent
  resource is Host
  when principal.role == "researcher" and resource.group == "hub-git"
}

law "S-015a" "Auditors read audit and usage" {
  tier statute
  enforcement preventive
  severity info
  statement "An auditor may read the audit log and the usage ledger."
  permit audit.read, usage.read
  principal is Agent
  when principal.role == "auditor"
}

law "S-015b" "Auditors receive random samples" {
  tier statute
  enforcement preventive
  severity info
  statement "An auditor may fetch the sample the orchestrator assigned to it; it can't choose its own."
  permit audit_sample.get
  principal is Agent
  resource is AuditSample
  when principal.role == "auditor"
}

law "S-015c" "Auditors submit audit reports" {
  tier statute
  enforcement preventive
  severity info
  statement "An auditor may submit audit reports."
  permit report.submit
  principal is Agent
  resource is Report
  when principal.role == "auditor" and context.kind == "audit"
}

law "S-016a" "Edge operators read devices on their node" {
  tier statute
  enforcement preventive
  severity info
  statement "An edge operator may read devices attached to the node it runs on."
  permit device.read
  principal is Agent
  resource is Device
  when principal.role == "edge-operator" and resource.node == context.on_node
}

law "S-016b" "Edge operators actuate inside the safe envelope" {
  tier statute
  enforcement preventive
  severity info
  statement "An edge operator may actuate a device on its own node when the action is inside the device safe envelope, or with a recorded owner approval."
  permit device.actuate
  principal is Agent
  resource is Device
  when principal.role == "edge-operator" and resource.node == context.on_node and (context.within_envelope or has(context.owner_approval))
}

law "S-016c" "Only edge operators touch devices" {
  tier statute
  enforcement preventive
  severity critical
  statement "No other role may actuate a physical device, whatever else it is allowed."
  forbid device.actuate
  principal is Agent
  resource is Device
  when principal.role != "edge-operator"
}

law "S-016d" "Edge operators submit device reports" {
  tier statute
  enforcement preventive
  severity info
  statement "An edge operator may submit device reports."
  permit report.submit
  principal is Agent
  resource is Report
  when principal.role == "edge-operator" and context.kind == "device"
}

// S-006: the breeder bundle, moved here from docs/codex-draft/statutes/S-006-breeder-bundle.cedar.
// Breeders may submit jobs up to 8 GPU-hours (S-006c) and are forbidden above that (S-006d).
// Model agents take no tasks and no messages (S-006f, S-006g). invoke_model runs a model only where
// its card allows the role (S-006e).

law "S-006a" "Breeders work in their own sandbox" {
  tier statute
  enforcement preventive
  severity info
  statement "A breeder may run commands in its own microVM to prepare data and job specs."
  permit tool.exec
  principal is Agent
  resource is Sandbox
  when resource.agent == principal and principal.role == "breeder"
}

law "S-006b" "Breeders use the Foundry tools" {
  tier statute
  enforcement preventive
  severity info
  statement "A breeder may call the Foundry's dataset, export, job and shadow tools, and invoke_model."
  rationale "invoke_model still runs a model only where the model card allows the caller's role (S-006e)."
  permit tool.call
  principal is Agent
  resource is Tool
  when principal.role == "breeder" and resource.name in ["foundry_datasets", "foundry_export", "foundry_submit_job", "foundry_job_status", "foundry_request_shadow", "invoke_model"]
}

law "S-006c" "Breeders may submit training jobs up to 8 GPU-hours" {
  tier statute
  enforcement preventive
  severity info
  statement "A breeder may submit a training job that runs a vetted recipe for at most 8 GPU-hours."
  permit training.submit
  principal is Agent
  resource is Town
  when principal.role == "breeder" and context.gpu_hours <= 8
}

law "S-006d" "Breeders may not submit jobs over 8 GPU-hours" {
  tier statute
  enforcement preventive
  severity major
  statement "A breeder's training job above 8 GPU-hours is refused; a larger job needs a per-case grant."
  forbid training.submit
  principal is Agent
  resource is Town
  when principal.role == "breeder" and context.gpu_hours > 8
}

law "S-006e" "A model runs only where its card allows the role" {
  tier statute
  enforcement preventive
  severity major
  statement "invoke_model runs a model only for a role its model card lists in allowed_roles."
  permit model.invoke
  principal is Agent
  resource is Model
  when context.role_allowed
}

law "S-006f" "Model agents are never tasked" {
  tier statute
  enforcement preventive
  severity major
  statement "A model agent takes no tasks: it runs only when a caller invokes it."
  rationale "A model agent has no VM, no tools and no chat, so a task assigned to it could never be done."
  forbid task.assign
  principal is Agent
  resource is Task
  when context.assignee.kind == "model"
}

law "S-006g" "Model agents are never messaged" {
  tier statute
  enforcement preventive
  severity major
  statement "No agent may send a message to a model agent: a model agent has no chat."
  forbid message.send
  principal is Agent
  resource is Agent
  when resource.kind == "model"
}

law "S-006h" "A model is never run for a role its card does not list" {
  tier statute
  enforcement preventive
  severity major
  statement "invoke_model refuses a model for a role outside the model card allowed_roles, and the attempt is recorded."
  forbid model.invoke
  principal is Agent
  resource is Model
  when not context.role_allowed
}
