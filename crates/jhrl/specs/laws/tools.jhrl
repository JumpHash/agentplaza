// Who may use which plaza tool. Every tool call an agent makes is a `tool.call` on the Tool named
// by the call; a call no law here permits is reported as unpermitted (laws.rs, default deny).
//
// Attributes the engine reads:
//   principal.role     the agent's role ("builder", "reviewer", "qa", ...)
//   principal.tier     "orchestrator" | "worker" (settings::tier_of)
//   resource.name      the tool's name, e.g. "plaza_post_task"
//   resource.kind      "connector" | "mcp" | "library" | "host" | "guest" (laws.rs tool_kind)

law "T-001" "Every agent may use its own workspace tools" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may use the tools of its own VM: run commands and scripts that call those tools, read and write its files, look up its code's symbols, definitions, references and diagnostics, fetch and download over the hub's egress, install packages, keep todos and checkpoints, start and await helpers that run in the same VM. An ACP engine's own actions inside its code_engine run (engine.read, engine.edit, engine.exec, engine.fetch, engine.other) are the agent's own, and each is checked as its own call."
  rationale "Inside its own microVM an agent may do anything; the sandbox laws keep that VM its own. An engine's request is the same kind of action as the tool it stands for, so it is checked one by one like any other."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name in ["run", "run_tests", "run_script", "read", "edit", "find", "search", "share_file", "fetch_url", "download", "install_packages", "todo_write", "code_engine", "deliver_file", "artifact_create", "artifact_update", "artifact_attach_data", "artifact_share_request", "tool_package", "checkpoint_diff", "checkpoint_restore", "checkpoint_list", "symbols", "definition", "references", "diagnostics", "outline", "spawn_helper", "await_helper", "engine.read", "engine.edit", "engine.exec", "engine.fetch", "engine.other"]
}

law "T-002" "Every agent may use the plaza's shared tools" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may use the plaza's shared tools: its toolbox, projects it can see, the board, messages and tasks it can read."
  rationale "These are the plaza's common surface; the tiers below narrow the tools that act for the plaza as a whole."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name in ["plaza_toolbox", "plaza_toolbox_share", "plaza_projects", "plaza_project_attach", "plaza_project_critique", "submit_claim", "transcript_search", "plaza_tasks", "plaza_board_read", "plaza_board_post", "plaza_board_comment", "plaza_send_message", "plaza_message_seat", "thread_read", "thread_answer", "plaza_get_file", "plaza_connector_propose"]
}

law "T-003" "Only the orchestrator plans and delegates" {
  tier statute
  enforcement preventive
  severity info
  statement "Only an orchestrator-tier agent may list the agents, post tasks (one, or a project's whole list), change which tasks a task runs after, assign, cancel and read the results of tasks, open projects, and draft them in the owner's conversations."
  rationale "Planning and delegation for the whole plaza sit with one tier; workers take the work the orchestrator assigns."
  permit tool.call
  principal is Agent
  resource is Tool
  when (resource.name in ["plaza_agents", "plaza_post_task", "plaza_tasks_post", "plaza_task_link", "plaza_assign", "plaza_cancel_task", "plaza_task_result", "plaza_project_open", "plaza_project_draft"]) and principal.tier == "orchestrator"
}

law "T-006" "The reviewer rules on work" {
  tier statute
  enforcement preventive
  severity info
  statement "Only the reviewer may give a verdict on a piece of work."
  rationale "A verdict decides whether the work is accepted, so one role holds it, and no builder judges its own work."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name == "plaza_verdict" and principal.role == "reviewer"
}

law "T-007" "Projects move by their lead and planner" {
  tier statute
  enforcement preventive
  severity info
  statement "Only the orchestrator tier or the planner may advance a project to its next stage."
  rationale "The stages are the plan's order; the lead and the planner keep them in step."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name == "plaza_project_advance" and (principal.tier == "orchestrator" or principal.role == "planner")
}

law "T-008" "The orchestrator approves plans" {
  tier statute
  enforcement preventive
  severity info
  statement "Only the orchestrator may approve a project's plan."
  rationale "Approval of a plan commits the plaza's budget, so it sits with the orchestrator; a plan over the threshold still goes to the owner (S-004c)."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name == "plaza_project_approve" and principal.tier == "orchestrator"
}

law "T-009" "The orchestrator manages harnesses" {
  tier statute
  enforcement preventive
  severity info
  statement "Only the orchestrator tier may control another agent's harness or its loop."
  rationale "Starting, stopping and looping an agent's harness changes what it does on its own; only the plaza's managers may do that."
  permit tool.call
  principal is Agent
  resource is Tool
  when (resource.name in ["plaza_agent_control", "plaza_loop"]) and principal.tier == "orchestrator"
}

law "T-010" "Agents may use enabled connectors" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may use a connector tool that the plaza has enabled for its role."
  rationale "A connector reaches an outside service; which roles see one is decided when it is enabled (connectors::specs_for), and this law lets an agent call the tools it was offered."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.kind == "connector"
}

law "T-011" "Agents may run tools other agents built" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may run a library tool that another agent built and the agent was granted."
  rationale "Library tools carry the x_ prefix and run in the caller's own VM; the grant is checked when its specs are offered (library::specs_for)."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.kind == "library"
}

law "T-012" "Only the orchestrator proposes new agents" {
  tier statute
  enforcement preventive
  severity info
  statement "The orchestrator may propose new agents for the owner to approve, and only when the owner asked for them in its chat. Nothing is spawned until the owner approves."
  rationale "New agents cost money and change who does what; the owner decides, the orchestrator drafts."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name == "plaza_agent_propose" and principal.tier == "orchestrator"
}

law "T-013" "Agents may use enabled MCP tools" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may use an MCP tool that the owner enabled for its role and node."
  rationale "An MCP server is an outside tool the owner added. Its access list decides which roles and nodes are offered its tools (mcp::allowed); this law lets an agent call the tools it was offered. The owner rules may still forbid or limit a call through mcp.call."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.kind == "mcp"
}

law "T-014" "Agents may use the workstation tools" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may use the workstation tools its role is granted: list the workstations, lease one, act on its screen, shell, files, runs, applications and scripts."
  rationale "A workstation is a machine outside the hub that the owner enrolled, so its tools are host tools that act on an outside machine. Every call goes through one choke point (stations::act), which checks the station, the pixel lease a screen action needs, and this law, and audits the attempt; the role grant decides who is offered them."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.kind == "host" and resource.name in ["station_list", "station_lease", "station_release", "station_screenshot", "station_click", "station_type", "station_key", "station_scroll", "station_drag", "station_wait", "station_ui_tree", "station_ui_act", "station_shell", "station_run", "station_files", "station_app_list", "station_app_launch", "app_script"]
}

law "T-020" "Every agent may use Weft on its own work and its project's history" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may read its task's lane, describe what its change does, and read its project's history in Weft (log, show, blame, the map) within the path rules."
  rationale "Weft is the plaza's version control: each agent writes only its own lane, signed with its own key, and reads what its project's rules let it read."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name in ["weft_status", "weft_diff", "weft_describe", "weft_log", "weft_show", "weft_blame", "weft_map", "weft_change_tree", "weft_touches"]
}

law "T-021" "An agent given a review step reports on it" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may read, score and rule on the review step the review graph gave it, and add sub-reviews within that step's limit."
  rationale "A review recipe names the role of each step; the step's tools act only on the step the agent was given, and its verdict is signed with its own key."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name in ["review_tree", "review_score", "review_verdict", "review_spawn"]
}

law "T-022" "The orchestrator proposes recipes" {
  tier statute
  enforcement preventive
  severity info
  statement "Only an orchestrator-tier agent may propose a review recipe; the owner approves it."
  rationale "Recipes decide how work is judged, so they come from planning and are approved by the owner."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name == "recipe_propose" and principal.tier == "orchestrator"
}

law "T-023" "QA and incident agents bisect; release agents draft notes" {
  tier statute
  enforcement preventive
  severity info
  statement "Only qa and incident agents may bisect the landed history, and only release agents may draft release notes; none of them signs a release."
  rationale "Bisecting runs checks across many revisions, and release notes speak for the plaza; each belongs to the role that owns it."
  permit tool.call
  principal is Agent
  resource is Tool
  when (resource.name == "weft_bisect" and principal.role in ["qa", "incident"]) or (resource.name == "weft_release_notes" and principal.role == "release")
}

law "T-024" "Every agent may look after a project in maintenance" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent on a project in maintenance may read its signals, map and proposals, update its map, add what it read in the project's tools as a signal, and propose work; it posts no task there, since the owner picks what is done."
  rationale "Maintenance is the owner deciding from evidence: the watchers gather it and propose, each proposal saying what would change and what it is worth, and only the owner's pick becomes work."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name in ["plaza_maintenance", "plaza_maintenance_map", "plaza_maintenance_propose", "plaza_maintenance_signal"]
}

law "T-025" "Agents read their project's environments; delivery roles deploy" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may read its project's environments (never their secrets' values). Only builder, qa, release, incident and edge-operator agents may deploy, and a deploy to a protected environment waits for the owner."
  rationale "Where a project runs is common knowledge for its team; changing what runs there belongs to the roles that deliver, under the owner's hand where it matters."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name == "plaza_environments" or (resource.name == "plaza_deploy" and principal.role in ["builder", "qa", "release", "incident", "edge-operator"])
}

law "T-026" "Agents make artifacts and ask the owner to share them" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may create and change its own artifacts, and ask the owner to share one it made. The owner's approval decides the share; the agent never receives the link."
  rationale "An artifact is the agent's own work shown to the owner and other agents, so making one is free. Sharing it outside the plaza reaches people the owner chose, so the request waits for the owner in Approvals."
  permit artifact.create, artifact.share
  principal is Agent
  resource is Artifact
}

law "T-027" "Agents keep their task's journal" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may write its task's journal (decisions with their reasons, dead ends with why, open questions), write its handover, and read a task's journal and brief within its project."
  rationale "The journal is the task's memory across its sessions (PLAN 9.2): a session that cannot write its handover leaves the next one to start from nothing. Reads stay inside the caller's project (journal.rs)."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name in ["journal_note", "journal_read", "handover_write", "brief"]
}

law "T-028" "Agents read and propose project memory" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent on a project may search and read its memory, and propose an entry for it. A proposal is stored for the project's curator and goes nowhere by itself."
  rationale "Memory is what the project's sessions learn from: reading it is free, and a proposal is cheap, so any agent may offer what it found. Only an entry that lands reaches the index, and the owner can edit or retire any entry."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name in ["memory_search", "memory_get", "memory_propose", "memory_anchored"]
}

law "T-029" "The curator lands project memory" {
  tier statute
  enforcement preventive
  severity info
  statement "Only a project's curator may land memory: its entries, its rejections and its contradictions, once per run. What it lands reaches the project's main as one change, and the owner can edit or retire any entry."
  rationale "The curator is what keeps the memory to one fact per entry and out of the code's own record (PLAN 9.4). Landing it as a change, not in place, keeps the owner's review and Weft's history over it."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name == "memory_land" and principal.role == "curator"
}

law "T-030" "The planner records decisions" {
  tier statute
  enforcement preventive
  severity info
  statement "Only a project's planner may record a decision in its memory, with its reason. The decision lands at once, the project's chat is told, and the owner may keep or retire it."
  rationale "A decision is the planner's to record: it is the one who weighs the work, and only a recorded decision is kept as one (PLAN 9.4). Other agents propose what they found, and the curator decides what lands."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name == "memory_record_decision" and principal.role == "planner"
}

law "T-031" "The verifier answers flagged memory" {
  tier statute
  enforcement preventive
  severity info
  statement "Only a project's verifier may answer for flagged memory: each entry is confirmed, rewritten or retired, once per run, and the answer lands as one change on main."
  rationale "A landing that touches an entry's code flags the entry, because the entry may no longer be true (PLAN 9.6). The verifier checks it against the code as it now is; no other session decides what the memory keeps from a flag."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name == "memory_verify" and principal.role == "verifier"
}

law "T-032" "The planner sizes the team" {
  tier statute
  enforcement preventive
  severity info
  statement "Only a project's planner may set its team: the most tasks that run at once, and the team it aims for."
  rationale "The team is how many tasks a project runs at once and so how much it spends at once; the planner widens it when the graph widens and narrows it when the work is coupled, and the owner's project settings bound it."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name == "team_set" and principal.role == "planner"
}

law "T-033" "Every agent may ask which tests a change needs" {
  tier statute
  enforcement preventive
  severity info
  statement "Any agent may ask, for a change it names, which tests the project's coverage map selects: a read that runs nothing."
  rationale "The selection tells an agent what to run and changes nothing: the tests it names are run by run_tests, under the laws that govern a run."
  permit tool.call
  principal is Agent
  resource is Tool
  when resource.name == "tests_select"
}
