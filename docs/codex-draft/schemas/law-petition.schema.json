{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentplaza.io/schemas/law-petition.schema.json",
  "title": "Law petition",
  "description": "Legislative counsel's petition to change the Codex (0049, 0050).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "petition_id",
    "law_id",
    "change",
    "branch",
    "rationale",
    "loosens_constitution"
  ],
  "properties": {
    "petition_id": {
      "type": "string"
    },
    "law_id": {
      "type": "string"
    },
    "change": {
      "type": "string",
      "enum": [
        "amend",
        "repeal",
        "new"
      ]
    },
    "branch": {
      "type": "string",
      "description": "Codex repo branch with the diff"
    },
    "rationale": {
      "type": "string",
      "maxLength": 4000
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "violation_rate": {
          "type": "number"
        },
        "overturn_rate": {
          "type": "number"
        },
        "cost_impact_credits": {
          "type": "integer"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "loosens_constitution": {
      "type": "boolean"
    }
  },
  "examples": [
    {
      "petition_id": "p-3",
      "law_id": "S-001",
      "change": "amend",
      "branch": "petition/p-3",
      "rationale": "Builders regularly need docs.python.org; add it to the allowlist.",
      "evidence": {
        "violation_rate": 0.12,
        "cases": [
          "case-9",
          "case-11"
        ]
      },
      "loosens_constitution": false
    }
  ]
}
