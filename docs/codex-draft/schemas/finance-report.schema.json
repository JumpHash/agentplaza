{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentplaza.io/schemas/finance-report.schema.json",
  "title": "Finance report",
  "description": "Periodic Finance report (0033, 0110).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "period",
    "spend_by_town",
    "recommendations"
  ],
  "properties": {
    "period": {
      "type": "string"
    },
    "spend_by_town": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "budget_overruns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cascade_escalations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Roles or task types that often escalate rungs"
    },
    "agora": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bid_accuracy": {
          "type": "number"
        },
        "clawbacks": {
          "type": "integer",
          "minimum": 0
        },
        "circular_contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "concentration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top3_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "examples": [
    {
      "period": "2026-W41",
      "spend_by_town": {
        "shop": 182000,
        "lab": 40500
      },
      "recommendations": [
        "Start lab planners on mid rung; 70% escalate."
      ],
      "concentration": {
        "top3_share": 0.41
      }
    }
  ]
}
