{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentplaza.io/schemas/town.schema.json",
  "title": "Town configuration (0124)",
  "description": "Stored in core.towns.config. Templates use the same schema with id/name omitted. Fields marked 'ratify' in the docs need owner ratification when they widen (0067).",
  "type": "object",
  "additionalProperties": false,
  "required": ["purpose", "mayor", "budget", "roster", "placement", "egress", "tools", "confidentiality"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "template": {"enum": ["software", "research", "edge"]},
    "purpose": {"type": "string", "minLength": 10, "maxLength": 500, "description": "One paragraph; the Mayor's standing brief"},
    "mayor": {
      "type": "object", "additionalProperties": false, "required": ["rung"],
      "properties": {
        "rung": {"enum": ["cheap", "mid", "frontier"]},
        "report_every": {"enum": ["daily", "weekly"], "default": "weekly"}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["monthly_credits", "task_default_credits"],
      "properties": {
        "monthly_credits": {"type": "integer", "minimum": 0},
        "task_default_credits": {"type": "integer", "minimum": 0},
        "council_move_pct": {"type": "integer", "minimum": 1, "maximum": 100, "default": 10,
                             "description": "Budget moves above this share of the monthly budget need the owner (0067)"},
        "alert_at_pct": {"type": "integer", "minimum": 1, "maximum": 100, "default": 80}
      }
    },
    "roster": {
      "type": "array", "minItems": 1,
      "description": "Roles the Mayor may spawn here, with caps. The Mayor itself is implicit.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "max"],
        "properties": {
          "role": {"type": "string"},
          "max": {"type": "integer", "minimum": 1, "maximum": 20},
          "rung": {"enum": ["cheap", "mid", "frontier"], "description": "Override of the role's start rung"}
        }
      }
    },
    "placement": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "require_labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "prefer_machines": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "dedicated": {"type": "boolean", "default": false, "description": "Don't share machines with other towns (RT-017)"}
      }
    },
    "egress": {
      "type": "object", "additionalProperties": false, "required": ["host_groups"],
      "properties": {
        "host_groups": {"type": "array", "items": {"type": "string"}, "uniqueItems": true,
                        "description": "Allowlist groups the town's roles may use (ratify when added)"},
        "extra_hosts": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}, "uniqueItems": true}
      }
    },
    "tools": {
      "type": "object", "additionalProperties": false, "required": ["scopes"],
      "properties": {
        "scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true,
                   "description": "Brokered tool scopes granted to the town (ratify when added, 0067)"},
        "devices": {"type": "array", "uniqueItems": true,
                    "items": {"type": "object", "additionalProperties": false, "required": ["id", "envelope"],
                              "properties": {"id": {"type": "string"}, "envelope": {"type": "string",
                                             "description": "Reference to the declared safe envelope (S-016)"}}}}
      }
    },
    "confidentiality": {"enum": ["normal", "sensitive"],
                        "description": "sensitive: dedicated placement and no memory promotion to org scope without owner review"},
    "quiet_hours": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "tz"],
      "description": "No owner pings except pages; approvals wait or escalate to the council",
      "properties": {"from": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
                     "to": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
                     "tz": {"type": "string"}}
    },
    "bylaws": {"type": "array", "items": {"type": "string", "pattern": "^B-[a-z][a-z0-9-]*-[0-9]{3}$"}, "uniqueItems": true}
  },
  "allOf": [
    {"if": {"properties": {"confidentiality": {"const": "sensitive"}}},
     "then": {"properties": {"placement": {"required": ["dedicated"], "properties": {"dedicated": {"const": true}}}}}}
  ]
}
