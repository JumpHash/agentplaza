# Rust build output (every workspace in this tree)
target/

# The web console's dependencies and its build (apps/web/dist): CI builds the console once per commit
# (.github/workflows/console.yml) and every package restores that build.
node_modules/
apps/web/dist/

# Harness / runtime scratch
.omp/
.claude/

# Local agent tooling and notes, not part of the repository
.agents/
PORT_STATUS.md
HANDOFF.md
skills-lock.json

# Python bytecode from the acceptance runner
__pycache__/
*.pyc

# Editors and OS noise
.DS_Store
*.swp
*~

# web build staging (build.mjs swaps dist.next into dist)
apps/web/dist.next/
apps/web/dist.old/
